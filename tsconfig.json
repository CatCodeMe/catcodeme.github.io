{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "compilerOptions": {
    "allowJs": true,
    "resolveJsonModule": true,
    "declaration": true,
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "strictNullChecks": true,
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@/assets/*": [
        "src/assets/*"
      ],
      "@/components/*": [
        "src/components/*"
      ],
      "@/layouts/*": [
        "src/layouts/*"
      ],
      "@/utils": [
        "src/utils/index.ts"
      ],
      "@/utils/*": [
        "src/utils/*"
      ],
      "@/plugins/*": [
        "src/plugins/*"
      ],
      "@/pages/*": [
        "src/pages/*"
      ],
      "@/types": [
        "src/types/index.ts"
      ],
      "@/site-config": [
        "src/site.config.ts"
      ],
      "@/data/*": [
        "src/data/*"
      ],
      "@/custom/components/*": [
        "packages/pure/components/*"
      ],
      "@/custom/pure/*": [
        "packages/pure/*"
      ],
      "@root/*": [
        "./*"
      ]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "exclude": [
    "node_modules",
    "**/node_modules/*",
    ".vscode",
    "dist",
    "public/scripts/*",
    "test/*"
  ]
}