{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "compilerOptions": {
    // Basic
    "allowJs": true,
    //允许解析 package.json
    "resolveJsonModule": true,
    // Building for a library
    "declaration": true,
    // Code runs in the DOM
    "lib": ["es2022", "dom", "dom.iterable"],
    // Type Imports
    "verbatimModuleSyntax": true,
    // Others
    "baseUrl": ".",
    "strictNullChecks": true,
    // Paths
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@/assets/*": [
        "src/assets/*"
      ],
      "@/components/*": [
        "src/components/*"
      ],
      "@/layouts/*": [
        "src/layouts/*"
      ],
      "@/utils": [
        "src/utils/index.ts"
      ],
      "@/utils/*": [
        "src/utils/*"
      ],
      "@/plugins/*": [
        "src/plugins/*"
      ],
      "@/pages/*": [
        "src/pages/*"
      ],
      "@/types": [
        "src/types/index.ts"
      ],
      "@/site-config": [
        "src/site.config.ts"
      ],
      "@/data/*": [
        "src/data/*"
      ],
      "@/custom/components/*": [
        "packages/pure/components/*"
      ],
      "@/custom/pure/*": [
        "packages/pure/*"
      ],
      // 添加新的别名用于访问根目录文件
      "@root/*": [
        "./*"
      ]
    }
  },
  "exclude": ["node_modules", "**/node_modules/*", ".vscode", "dist", "public/scripts/*", "test/*"]
}
