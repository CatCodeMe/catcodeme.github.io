---
import { AstroError } from 'astro/errors'

import { Icons } from '../../libs/icons'
import Icon from './Icon.astro'

const asideVariants = [
  'important',
  'info',
  'note',
  'tip',
  'warning',
  'caution',
  'success',
  'error'
] as const
const asideStyles = ['solid', 'card'] as const

type IconName = keyof typeof Icons

const defaultIcons: Record<(typeof asideVariants)[number], IconName> = {
  important: 'important',
  info: 'callout_info',
  note: 'note',
  tip: 'tip',
  success: 'tip',
  warning: 'warning',
  caution: 'caution',
  error: 'caution'
} as const

interface Props {
  type?: (typeof asideVariants)[number]
  title?: string
  icon?: string
  open?: boolean
  style?: (typeof asideStyles)[number]
  showTypeBadge?: boolean
}

const { type = 'note', icon, open: openProp, style = 'solid', showTypeBadge = true } = Astro.props
let { title } = Astro.props

const isCollapsible = openProp !== undefined && openProp !== false

if (!asideVariants.includes(type)) {
  throw new AstroError(
    'Invalid `type` prop passed to the `<Aside>` component.\n',
    `Received: ${JSON.stringify(type)}
` + `Expected one of ${asideVariants.map((i) => JSON.stringify(i)).join(', ')}`
  )
}

if (style && !asideStyles.includes(style)) {
  throw new AstroError(
    'Invalid `style` prop passed to the `<Aside>` component.\n',
    `Received: ${JSON.stringify(style)}
` + `Expected one of ${asideStyles.map((i) => JSON.stringify(i)).join(', ')}`
  )
}

// Determine the icon to render
let iconToRender: IconName | undefined
let isEmoji = false

if (icon) {
  // Check if the provided icon is an emoji
  const emojiRegex = /\p{Emoji}/u // Unicode property escape for emoji
  if (emojiRegex.test(icon)) {
    iconToRender = undefined // Set to undefined if it\'s an emoji, handled by isEmoji
    isEmoji = true
  } else if (icon in Icons) {
    iconToRender = icon as IconName
  } else {
    // Fallback to default icon if provided icon name is not found in Icons
    console.warn(
      `Icon "${icon}" not found in icons.ts. Falling back to default icon for type "${type}".`
    )
    iconToRender = defaultIcons[type] as IconName
  }
} else {
  iconToRender = defaultIcons[type] as IconName
}
---

<aside
  aria-label={title || undefined}
  class:list={[
    `aside aside-${type}`,
    `aside-style-${style}`,
    { 'is-collapsible': isCollapsible, 'is-collapsed': isCollapsible && !openProp }
  ]}
>
  {
    (showTypeBadge || Astro.slots.has('title') || title) && (
      <div class:list={['aside-title', { 'is-interactive': isCollapsible }]}>
        <div class='aside-title-content'>
          {showTypeBadge && (
            <div class="aside-type-badge">
              <slot name="icon">
                {isEmoji ? <span class='aside-icon-emoji'>{icon}</span> : <Icon name={iconToRender!} />}
              </slot>
              {type}
            </div>
          )}

          {!showTypeBadge && (
            <slot name="icon">
              {isEmoji ? <span class='aside-icon-emoji'>{icon}</span> : <Icon name={iconToRender!} />}
            </slot>
          )}

          {Astro.slots.has('title') ? <slot name='title' /> : title && <span>{title}</span>}
        </div>
        {isCollapsible && <Icon name='down_arrow' class='aside-toggle-icon' size='.8em' />}
      </div>
    )
  }
  <div class='aside-content'>
    <slot />
  </div>
</aside>

<style>
  .aside-icon-emoji {
    font-size: 1.3em;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .aside-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-weight: 700;
    margin: 0;
    margin-bottom: -0.4rem;
  }

  .aside-title-content {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-grow: 1;
  }

  /* --- Collapsible Styles --- */
  .aside-title.is-interactive {
    cursor: pointer;
  }

  .aside-toggle-icon {
    flex-shrink: 0;
    transition: transform 0.2s ease-in-out;
  }

  .is-collapsed .aside-toggle-icon {
    transform: rotate(-90deg);
  }

  .is-collapsed .aside-content {
    margin-top: 1rem;
    display: none;
  }
</style>

<script>
  document.querySelectorAll('.aside.is-collapsible').forEach((aside) => {
    const title = aside.querySelector('.aside-title.is-interactive')
    if (title) {
      title.addEventListener('click', () => {
        aside.classList.toggle('is-collapsed')
      })
    }
  })
</script>
