---
interface Props {
  class?: string
}

const { class: className, ...props } = Astro.props
---

<div class={className} {...props}>
  <ul class='ps-0 sm:ps-2 timeline-list m-0 p-0'>
    <slot />
  </ul>
</div>

<style>
  /* 重置 ul 和 li 的默认样式 */
  :global(.timeline-list) {
    margin: 0;
    padding: 0;
  }
  
  :global(.timeline-list > li) {
    margin-top: 0 !important;
    padding-inline-start: 0 !important;
  }
  
  :global(.timeline-list > li:last-child) {
    margin-bottom: 0 !important;
  }
  
  /* 为 TimelineItem 添加连接线（除了最后一个） */
  /* 竖线对齐圆点：从当前圆点底部到下一个圆点顶部 */
  :global(.timeline-list > li[data-timeline-item]:not(:last-child)::after) {
    content: '';
    position: absolute;
    left: 14px; /* ms-2 (8px) + 圆圈半径 (6px) = 14px，使竖线在圆圈中心 */
    top: calc(0.125rem + 12px); /* mt-[0.125rem] (2px) + 圆圈高度 (12px) = 14px，从圆点底部开始 */
    width: 1px;
    height: calc(100% - 14px); /* 延伸到下一个圆点顶部 */
    background-color: hsl(var(--border));
    z-index: 0;
  }
  
  /* 里程碑节点的背景高亮 */
  :global(.timeline-list > li[data-milestone="true"]) {
    background: linear-gradient(
      to right,
      hsl(var(--primary) / 0.12),
      transparent 20%
    );
    border-radius: 0.375rem;
    padding: 0.25rem 0;
  }
</style>

