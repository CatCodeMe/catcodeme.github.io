---
const icons = import.meta.glob<string>('/src/icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true
})

interface Props {
  name: string
  label?: string
  color?: string
  size?: string
  class?: string
}

const { name, label, size = '1em', color, class: className, ...props } = Astro.props
const a11yAttrs = label ? ({ 'aria-label': label } as const) : ({ 'aria-hidden': 'true' } as const)

const svgContentRaw = icons[`/src/icons/${name}.svg`]
let svgContent = ''
let viewBox = '0 0 24 24'

if (svgContentRaw) {
  svgContent = svgContentRaw
  const viewBoxMatch = svgContent.match(/viewBox="([^"]*)"/)
  if (viewBoxMatch && viewBoxMatch[1]) {
    viewBox = viewBoxMatch[1]
  }
  const contentMatch = svgContent.match(/<svg[^>]*>(.*?)<\/svg>/s)
  if (contentMatch && contentMatch[1]) {
    svgContent = contentMatch[1]
  }
}
---

<svg
  {...a11yAttrs}
  class={className}
  width='22'
  height='22'
  viewBox={viewBox}
  fill='currentColor'
  set:html={svgContent}
  {...props}
/>

<style define:vars={{ 'sl-icon-color': color, 'sl-icon-size': size }}>
  svg {
    color: var(--sl-icon-color);
    font-size: var(--sl-icon-size, 1em);
    width: 1.5em;
    height: 1.5em;
  }
</style>
