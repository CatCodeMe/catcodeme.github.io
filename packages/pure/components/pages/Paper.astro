---
import type { HTMLTag, Polymorphic } from 'astro/types'

import { Icon } from 'astro-pure/user'

import { cn } from '../../utils'

type Paper = {
  id: string
  data: {
    title: string
    subTitle?: string
    publishDate: string
    citations?: number
    doi?: string
    isbn?: string
    star?: number
    tags?: string[]
    paperUrl?: string // 新增论文链接字段
  }
  index?: number
}

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
  paper: Paper
  class?: string
}

const { as: Tag = 'div', paper, class: className } = Astro.props
const { id, data, index } = paper
const starCount = data.star ? Math.min(Math.max(data.star, 0), 5) : 0
---

<Tag
  class={cn(
    'group flex relative gap-6 p-6 rounded-[var(--radius)] transition-all duration-300 overflow-hidden',
    'bg-white dark:bg-zinc-900',
    'border border-zinc-100 dark:border-zinc-800',
    'hover:border-zinc-200 dark:hover:border-zinc-700',
    'mb-4',
    className
  )}
>
  {/* Star 评分 - 右上角 + 编号 (仅在大屏幕显示) */}
  {
    (starCount > 0 || typeof paper.index === 'number') && (
      <div class='absolute top-4 right-4 items-center gap-1 z-20 hidden md:flex top-right-rating'>
        {starCount > 0 && (
          <div class='flex gap-0.5'>
            {Array.from({ length: 5 }).map((_, i) => (
              <Icon
                name='star'
                class={cn(
                  'size-4',
                  i < starCount ? 'text-yellow-400' : 'text-zinc-200 dark:text-zinc-700'
                )}
              />
            ))}
          </div>
        )}
        {typeof paper.index === 'number' && (
          <span class='ml-2 text-xs text-zinc-300 dark:text-zinc-600 font-mono select-none'>
            No.{String(paper.index).padStart(2, '0')}
          </span>
        )}
      </div>
    )
  }

  {/* 右下角倾斜卡片，仅主图标和链接 (仅在大屏幕显示) */}
  <div class='paper-card-icon-preview hidden md:block'>
    <div class='paper-preview-container'>
      <Icon name={data.isbn ? 'paper_book' : 'paper_article'} class='paper-icon' />
      {
        data.paperUrl && (
          <a href={data.paperUrl} target='_blank' rel='noopener noreferrer' class='paper-link'>
            View &gt;&gt;
          </a>
        )
      }
    </div>
  </div>

  {/* 主内容区 */}
  <div class='flex flex-col flex-1 min-w-0 z-10 pr-0 md:pr-20'>
    {/* 标题区域 */}
    <div class='space-y-1'>
      <h3 class='text-lg font-medium text-zinc-900 dark:text-zinc-100 leading-tight m-0'>
        {data.title}
      </h3>
      {
        data.subTitle && (
          <p class='text-sm text-zinc-600 dark:text-zinc-400 leading-normal m-0'>{data.subTitle}</p>
        )
      }
    </div>

    {/* 元信息 - 发布日期和引用数 */}
    <div class='mt-2 flex items-center gap-4 text-sm text-zinc-500 dark:text-zinc-400'>
      <span class='flex items-center gap-1.5'>
        <Icon name='calendar' class='size-4' />
        {new Date(data.publishDate).getFullYear()}
      </span>
      {
        data.citations !== undefined && (
          <span class='flex items-center gap-1.5'>
            <Icon name='citation' class='size-4' />
            {data.citations.toLocaleString()} citations
          </span>
        )
      }
    </div>

    {/* 元信息 - DOI 和 ISBN */}
    <div class='mt-2 flex flex-wrap items-center gap-4 text-sm text-zinc-500 dark:text-zinc-400'>
      {/* DOI */}
      {
        data.doi && (
          <button
            class='group/doi flex items-center gap-1.5 hover:text-zinc-800 dark:hover:text-zinc-200'
            onclick={`navigator.clipboard.writeText('${data.doi}').then(() => {
            document.dispatchEvent(new CustomEvent('toast', { 
              detail: { message: 'DOI copied to clipboard!' }
            }))
          })`}
          >
            <Icon name='doi' class='size-4' />
            <code class='font-mono text-xs px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 group-hover/doi:bg-zinc-200 dark:group-hover/doi:bg-zinc-700'>
              {data.doi}
            </code>
          </button>
        )
      }
      {/* ISBN */}
      {
        data.isbn && (
          <button
            class='group/isbn flex items-center gap-1.5 hover:text-zinc-800 dark:hover:text-zinc-200'
            onclick={`navigator.clipboard.writeText('${data.isbn}').then(() => {
            document.dispatchEvent(new CustomEvent('toast', { 
              detail: { message: 'ISBN copied to clipboard!' }
            }))
          })`}
          >
            <Icon name='book' class='size-4' />
            <span class='flex items-center gap-1'>
              ISBN:
              <code class='font-mono text-xs px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 group-hover/isbn:bg-zinc-200 dark:group-hover/isbn:bg-zinc-700'>
                {data.isbn}
              </code>
            </span>
          </button>
        )
      }
    </div>

    {/* 标签 */}
    {
      data.tags && (
        <div class='mt-auto pt-4 flex flex-wrap gap-2'>
          {data.tags.map((tag: string) => (
            <span class='px-2 py-1 text-xs rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300'>
              {tag}
            </span>
          ))}
        </div>
      )
    }

    {/* 小屏幕底部信息行 */}
    <div class='mt-4 pt-3 border-t border-zinc-100 dark:border-zinc-800 flex items-center justify-between md:hidden'>
      <div class='flex items-center gap-3'>
        {/* 论文类型图标 */}
        <div class='flex items-center gap-1 text-sm text-zinc-500 dark:text-zinc-400'>
          <Icon name={data.isbn ? 'paper_book' : 'paper_article'} class='size-4' />
          <span class='text-xs'>{data.isbn ? 'Book' : 'Article'}</span>
        </div>
        {/* 论文链接 */}
        {
          data.paperUrl && (
            <a 
              href={data.paperUrl} 
              target='_blank' 
              rel='noopener noreferrer' 
              class='text-xs text-zinc-500 dark:text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 transition-colors'
            >
              View &gt;&gt;
            </a>
          )
        }
      </div>
      
      {/* 评分和编号 */}
      <div class='flex items-center gap-2'>
        {/* 编号 */}
        {typeof paper.index === 'number' && (
          <span class='text-xs text-zinc-400 dark:text-zinc-500 font-mono select-none'>
            No.{String(paper.index).padStart(2, '0')}
          </span>
        )}
        {/* 评分 */}
        {starCount > 0 && (
          <div class='flex gap-0.5'>
            {Array.from({ length: 5 }).map((_, i) => (
              <Icon
                name='star'
                class={cn(
                  'size-3',
                  i < starCount ? 'text-yellow-400' : 'text-zinc-200 dark:text-zinc-700'
                )}
              />
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</Tag>

<style>
  .paper-card-icon-preview {
    position: absolute;
    right: 1.2rem;
    bottom: 1.2rem;
    width: 6.5rem;
    height: 5.2rem;
    display: flex;
    align-items: flex-end;
    z-index: 15;
    pointer-events: none;
  }
  .paper-preview-container {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    border-radius: var(--radius);
    border: 1px solid #e2e8f0; /* 亮色下深灰 */
    background: var(--background);
    user-select: none;
    transform: scale(1) rotate(0.18rad) translateY(30%);
    transition: transform 300ms ease-out;
    will-change: transform;
    backface-visibility: hidden;
    padding: 0.25rem 0.5rem 0.5rem 0.5rem;
    pointer-events: auto;
    overflow: hidden;
  }
  .dark .paper-preview-container {
    background: var(--background);
    border-color: #f3f4f6; /* 暗色下浅灰 */
  }
  .group:hover .paper-preview-container {
    transform: scale(1.04) rotate(0) translateY(15%);
    transition: transform 400ms cubic-bezier(0, 0.9, 0.5, 1.35);
  }
  .paper-icon {
    width: 2.5rem;
    height: 2.5rem;
    color: var(--muted-foreground);
    margin-bottom: 0.15rem;
    z-index: 2;
  }
  .paper-link {
    display: flex;
    align-items: center;
    font-size: 0.75rem;
    color: var(--muted-foreground);
    margin-top: 0.15rem;
    text-decoration: none;
    pointer-events: auto;
    transition: color 0.2s;
    z-index: 2;
  }
  .paper-link:hover {
    color: var(--foreground);
  }
  /* 编号右上角淡色小号字体，主题色自适应 */
  .paper-index-no {
    margin-left: 0.5rem;
    font-size: 0.82rem;
    color: var(--muted-foreground);
    font-family: var(--font-mono, monospace);
    user-select: none;
    letter-spacing: 0.04em;
    font-weight: 500;
  }
  /* 确保小屏幕隐藏右上角评分和编号 */
  @media (max-width: 767px) {
    .top-right-rating {
      display: none !important;
    }
    
    /* 强制隐藏倾斜卡片 */
    .paper-card-icon-preview {
      display: none !important;
    }
  }
</style>
