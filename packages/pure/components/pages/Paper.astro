---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import type { HTMLTag, Polymorphic } from 'astro/types'

import { Icon } from 'astro-pure/user'

import { cn } from '../../utils'

// 1. Pre-load all possible images from a conventional directory.
const allPaperImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/papers/**/*.{jpeg,jpg,png,gif,webp,svg}'
)

type Paper = {
  id: string
  data: {
    title: string
    subTitle?: string
    publishDate: string
    citations?: number
    doi?: string
    isbn?: string
    star?: number
    tags?: string[]
    paperUrl?: string // 新增论文链接字段
    author?: string[]
    image?: {
      // 2. Allow src to be a string (filename) or ImageMetadata
      src: ImageMetadata | string
      alt?: string
    }
  }
  index?: number
}

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
  paper: Paper
  class?: string
}

const { as: Tag = 'div', paper, class: className } = Astro.props
const { data } = paper
const starCount = data.star ? Math.min(Math.max(data.star, 0), 5) : 0

// 3. Resolve the image source
let resolvedImageSrc: ImageMetadata | undefined
if (data.image && data.image.src) {
  if (typeof data.image.src === 'string') {
    // If src is a string, find it in the pre-loaded images.
    const imagePath = `/src/assets/images/papers/${data.image.src}`
    if (allPaperImages[imagePath]) {
      resolvedImageSrc = (await allPaperImages[imagePath]()).default
    }
    else {
      // Optional: handle image not found case
      console.warn(`[Paper Component] Image not found for src: ${data.image.src}`)
    }
  }
  else {
    // If src is already ImageMetadata, use it directly.
    resolvedImageSrc = data.image.src
  }
}
---

<Tag
  class={cn(
    'group flex relative gap-6 p-6 rounded-[var(--radius)] transition-all duration-300 overflow-hidden',
    'bg-white dark:bg-zinc-900',
    'border border-zinc-100 dark:border-zinc-800',
    'hover:border-zinc-200 dark:hover:border-zinc-700',
    'mb-4',
    className
  )}
>
  {
    data.image &&
    resolvedImageSrc && (
      <Image
        src={resolvedImageSrc}
        alt={data.image.alt || data.title}
        class='cover-image absolute end-0 top-0 z-0 h-full w-full rounded-[var(--radius)] object-cover opacity-20 transition-opacity duration-300 group-hover:opacity-70'
        loading='lazy'
      />
    )
  }
  {/*主内容区*/}
  <div class='flex flex-col flex-1 min-w-0 z-10'>
    {/* 标题与右上角信息容器 */}
    <div class='flex justify-between items-center'>
      {/* 标题区域 */}
      <div class='space-y-1 flex-1 min-w-0 pr-4'>
        <h3 class='text-lg font-medium text-zinc-900 dark:text-zinc-100 leading-tight m-0'>
          {data.title}
        </h3>
        {
          data.subTitle && (
            <p class='text-sm text-zinc-600 dark:text-zinc-400 leading-normal m-0'>
              {data.subTitle}
            </p>
          )
        }
      </div>

      {/* Star 评分 - 右上角 + 编号 (仅在大屏幕显示) */}
      {
        (starCount > 0 || typeof paper.index === 'number') && (
          <div class='flex items-center gap-1 z-20 hidden md:flex top-right-rating large-screen-stars'>
            {starCount > 0 && (
              <div class='flex gap-0.5'>
                {Array.from({ length: 5 }).map((_, i) => (
                  <Icon
                    name='star'
                    class={cn(
                      'size-4',
                      i < starCount ? 'text-yellow-400' : 'text-zinc-200 dark:text-zinc-700'
                    )}
                  />
                ))}
              </div>
            )}
            {typeof paper.index === 'number' && (
              <span class='ml-2 text-xs text-zinc-300 dark:text-zinc-600 font-mono select-none'>
                No.{String(paper.index).padStart(2, '0')}
              </span>
            )}
          </div>
        )
      }
    </div>

    <!-- Author list -->
    {
      Array.isArray(data.author) &&
        data.author.length > 0 && (
          <div class='mt-2 text-sm text-zinc-500 dark:text-zinc-400'>
            <span class='flex items-center gap-1.5'>
              <Icon name='brain' class='size-4' />
              {data.author.map((author: string) => author.trim()).join(', ')}
            </span>
          </div>
        )
    }

    {/* 元信息 - 发布日期和引用数 */}
    <div class='mt-2 flex items-center gap-4 text-sm text-zinc-500 dark:text-zinc-400'>
      <span class='flex items-center gap-1.5'>
        <Icon name='calendar' class='size-4' />
        {new Date(data.publishDate).getFullYear()}
      </span>
      {
        data.citations !== undefined && (
          <span class='flex items-center gap-1.5'>
            <Icon name='citation' class='size-4' />
            {data.citations.toLocaleString()} citations
          </span>
        )
      }
    </div>

    {/* 元信息 - DOI 和 ISBN */}
    <div class='mt-2 flex flex-wrap items-center gap-4 text-sm text-zinc-500 dark:text-zinc-400'>
      {/* DOI */}
      {
        data.doi && (
          <button
            class='group/doi flex items-center gap-1.5 hover:text-zinc-800 dark:hover:text-zinc-200'
            onclick={`navigator.clipboard.writeText('${data.doi}').then(() => {
            document.dispatchEvent(new CustomEvent('toast', { 
              detail: { message: 'DOI copied to clipboard!' }
            }))
          })`}
          >
            <Icon name='doi' class='size-4' />
            <div class='font-mono text-xs px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 group-hover/doi:bg-zinc-200 dark:group-hover/doi:bg-zinc-700'>
              {data.doi}
            </div>
          </button>
        )
      }
      {/* ISBN */}
      {
        data.isbn && (
          <button
            class='group/isbn flex items-center gap-1.5 hover:text-zinc-800 dark:hover:text-zinc-200'
            onclick={`navigator.clipboard.writeText('${data.isbn}').then(() => {
            document.dispatchEvent(new CustomEvent('toast', { 
              detail: { message: 'ISBN copied to clipboard!' }
            }))
          })`}
          >
            <Icon name='book' class='size-4' />
            <span class='flex items-center gap-1'>
              ISBN:
              <div class='font-mono text-xs px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 group-hover/isbn:bg-zinc-200 dark:group-hover/isbn:bg-zinc-700'>
                {data.isbn}
              </div>
            </span>
          </button>
        )
      }
    </div>

    {/* 标签 */}
    {
      data.tags && (
        <div class='mt-auto pt-4 flex flex-wrap gap-2'>
          {data.tags.map((tag: string) => (
            <span class='px-2 py-1 text-xs rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300'>
              {tag}
            </span>
          ))}
        </div>
      )
    }

    {/* 小屏幕底部信息行 */}
    <div
      class='mt-4 pt-3 border-t border-zinc-100 dark:border-zinc-800 flex items-center justify-between md:hidden'
    >
      <div class='flex items-center gap-3'>
        {/* 论文类型图标 */}
        <div class='flex items-center gap-1 text-sm text-zinc-500 dark:text-zinc-400'>
          <Icon name={data.isbn ? 'paper_book' : 'paper_article'} class='size-4' />
          <span class='text-xs'>{data.isbn ? 'Book' : 'Article'}</span>
        </div>
        {/* 论文链接 */}
        {
          data.paperUrl && (
            <a
              href={data.paperUrl}
              target='_blank'
              rel='noopener noreferrer'
              class='text-xs text-zinc-500 dark:text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 transition-colors'
            >
              View &gt;&gt;
            </a>
          )
        }
      </div>

      {/* 评分和编号 */}
      <div class='flex items-center gap-2'>
        {/* 编号 */}
        {
          typeof paper.index === 'number' && (
            <span class='text-xs text-zinc-400 dark:text-zinc-500 font-mono select-none'>
              No.{String(paper.index).padStart(2, '0')}
            </span>
          )
        }
        {/* 评分 */}
        {
          starCount > 0 && (
            <div class='flex gap-0.5'>
              {Array.from({ length: 5 }).map((_, i) => (
                <Icon
                  name='star'
                  class={cn(
                    'size-3',
                    i < starCount ? 'text-yellow-400' : 'text-zinc-200 dark:text-zinc-700'
                  )}
                />
              ))}
            </div>
          )
        }
      </div>
    </div>
  </div>

  <!-- 浮动卡片链接 -->
  {
    data.paperUrl && (
      <a
        href={data.paperUrl}
        target='_blank'
        rel='noopener noreferrer'
        class='paper-card-link-wrapper hidden md:flex'
        aria-label={`View paper: ${data.title}`}
      >
        <div class='paper-preview-container'>
          <Icon name={data.isbn ? 'paper_book' : 'paper_article'} class='paper-icon' />
          <span class='paper-link-text'>View</span>
        </div>
      </a>
    )
  }
</Tag>

<style>
  /* 确保小屏幕隐藏右上角评分和编号 */
  @media (max-width: 767px) {
    .top-right-rating {
      display: none !important;
    }
  }

  /* 浮动卡片链接容器 */
  .paper-card-link-wrapper {
    position: absolute;
    right: 1.5rem;
    bottom: 0;
    z-index: 10;
    will-change: transform;
    transform: translateY(35%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
  }

  .group:hover .paper-card-link-wrapper {
    transform: translateY(-10%) scale(1.03);
  }

  /* 卡片视觉样式 */
  .paper-preview-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    width: 5.5rem;
    height: 5.5rem;
    padding-bottom: 0.25rem;
    border-radius: var(--radius);
    border: 1px solid rgb(226, 232, 240);
    box-shadow:
      0 4px 6px -1px rgb(0 0 0 / 0.05),
      0 2px 4px -2px rgb(0 0 0 / 0.05);
    transition: border-color 0.3s;
  }

  .dark .paper-preview-container {
    border-color: rgb(39, 39, 42);
  }

  .group:hover .paper-preview-container {
    border-color: rgb(203, 213, 225);
  }

  .dark .group:hover .paper-preview-container {
    border-color: rgb(63, 63, 70);
  }

  .paper-icon {
    width: 2.25rem;
    height: 2.25rem;
    color: var(--muted-foreground);
    transition: color 0.3s;
  }

  .group:hover .paper-icon {
    color: var(--foreground);
  }

  .paper-link-text {
    font-size: 0.75rem;
    color: var(--muted-foreground);
    opacity: 0;
    transform: translateY(5px);
    transition:
      opacity 0.2s ease-out 0.1s,
      transform 0.2s ease-out 0.1s,
      color 0.3s;
  }

  .group:hover .paper-link-text {
    opacity: 1;
    transform: translateY(0);
    color: var(--foreground);
  }
  .cover-image {
    mask-image: linear-gradient(to right, transparent, black 60%);
    -webkit-mask-image: -webkit-linear-gradient(to right, transparent, black 60%);
  }
</style>
