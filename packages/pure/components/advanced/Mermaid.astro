---
import config from 'virtual:config'
---

<script is:inline src={`${config.npmCDN}/mermaid/dist/mermaid.min.js`}></script>

<style is:inline>
  /* 基础容器样式 */
  .mermaid-wrapper {
    position: relative;
    margin-top: 1rem;
    border-radius: 0.5rem;
    overflow: hidden;
    border: 1px solid hsl(var(--border));
  }

  /* 添加水印样式 */
  .mermaid-wrapper::after {
    content: 'Mermaid';
    position: absolute;
    bottom: 1rem;
    right: 0.5rem;
    font-size: 3rem;
    font-weight: bold;
    color: hsl(var(--muted-foreground) / 0.15);
    pointer-events: none;
  }

  .mermaid-container {
    padding: 1rem;
    overflow: hidden;
  }

  .mermaid {
    margin: 0 auto;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .mermaid svg {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
  }

  /* 弹窗中的图表居中样式 */
  .mermaid-modal .mermaid-container {
    width: 100%;
    height: 100%;
    overflow: hidden;
    cursor: move;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mermaid-modal .mermaid {
    position: absolute;
    left: 50%;
    top: 50%;
    transform-origin: center;
    transform: translate(-50%, -50%) scale(1);
    max-width: 100%;
    max-height: 100%;
  }

  /* 移除过渡效果使拖拽更顺滑 */
  .mermaid-modal .mermaid svg {
    transition: none;
  }

  .mermaid-actions {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: flex;
    gap: 0.5rem;
    opacity: 0;
    transition: opacity 0.2s;
    z-index: 10;
  }

  .mermaid-wrapper:hover .mermaid-actions {
    opacity: 1;
  }

  .mermaid-action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0.25rem;
    border-radius: 0.25rem;
    background: hsl(var(--background));
    border: 1px solid hsl(var(--border));
    cursor: pointer;
    opacity: 0.8;
    color: hsl(var(--foreground));
  }

  .mermaid-action-btn:hover {
    opacity: 1;
    background: hsl(var(--muted));
  }

  .mermaid-action-btn.copy .success {
    display: none;
  }

  .mermaid-action-btn.copied .ready {
    display: none;
  }

  .mermaid-action-btn.copied .success {
    display: block;
  }

  .mermaid-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: hsl(var(--background) / 0.8);
    backdrop-filter: blur(8px);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s ease,
      visibility 0.2s ease;
    z-index: 1000;
  }

  .mermaid-modal.active {
    opacity: 1;
    visibility: visible;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mermaid-modal-content {
    position: relative;
    width: 70%;
    height: 70%;
    background: hsl(var(--background));
    border-radius: 0.5rem;
    border: 1px solid hsl(var(--border));
    padding: 1rem;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: scale(0.95);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .mermaid-modal.active .mermaid-modal-content {
    opacity: 1;
    transform: scale(1);
  }

  .mermaid-modal .mermaid-container {
    width: 100%;
    height: 100%;
    overflow: hidden;
    cursor: move;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mermaid-modal .mermaid-container svg {
    transform-origin: center center;
    transition: none; /* 移除过渡效果使拖拽更顺滑 */
  }

  .mermaid-controls {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: 0.5rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .mermaid-controls .mermaid-action-btn {
    width: 36px;
    height: 36px;
    font-size: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mermaid-controls .mermaid-action-btn svg {
    width: 20px;
    height: 20px;
  }
</style>

<script is:inline>
  async function initializeMermaid() {
    const theme = document.documentElement.dataset.theme
    const isDark =
      theme === 'system'
        ? window.matchMedia('(prefers-color-scheme: dark)').matches
        : theme === 'dark'

    await mermaid.initialize({
      startOnLoad: false,
      theme: isDark ? 'dark' : 'default'
    })
  }

  class MermaidViewer {
    constructor(diagram) {
      this.diagram = diagram
      this.scale = 1
      this.translateX = 0
      this.translateY = 0
      this.wrapDiagram()
      this.setupUI()
      this.setupDragging()
    }

    wrapDiagram() {
      // 如果图表还没有被包装
      if (!this.diagram.parentNode.classList.contains('mermaid-wrapper')) {
        const wrapper = document.createElement('div')
        wrapper.className = 'mermaid-wrapper'
        this.diagram.parentNode.insertBefore(wrapper, this.diagram)
        wrapper.appendChild(this.diagram)
      }
    }

    setupUI() {
      // 添加操作按钮
      const actions = document.createElement('div')
      actions.className = 'mermaid-actions'
      actions.innerHTML = `
        <button class="mermaid-action-btn copy" title="Copy Source">
          <div class="ready">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
          </div>
          <div class="success">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 6L9 17l-5-5"></path>
            </svg>
          </div>
        </button>
        <button class="mermaid-action-btn fullscreen" title="Fullscreen">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path>
          </svg>
        </button>
      `
      this.diagram.parentNode.appendChild(actions)

      // 创建模态框
      this.modal = document.createElement('div')
      this.modal.className = 'mermaid-modal'
      this.modal.innerHTML = `
        <div class="mermaid-modal-content">
          <div class="mermaid-container"></div>
          <div class="mermaid-controls">
            <button class="mermaid-action-btn zoom-in" title="Zoom In">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="16"></line>
                <line x1="8" y1="12" x2="16" y2="12"></line>
              </svg>
            </button>
            <button class="mermaid-action-btn zoom-out" title="Zoom Out">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="8" y1="12" x2="16" y2="12"></line>
              </svg>
            </button>
            <button class="mermaid-action-btn reset" title="Reset">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                <path d="M3 3v5h5"></path>
              </svg>
            </button>
            <button class="mermaid-action-btn close" title="Close">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
        </div>
      `
      document.body.appendChild(this.modal)

      // 设置事件监听
      const copyBtn = actions.querySelector('.copy')
      copyBtn.addEventListener('click', async () => {
        const encodedContent = this.diagram.getAttribute('data-original')
        if (encodedContent) {
          try {
            const content = decodeURIComponent(atob(encodedContent))
            await navigator.clipboard.writeText(content)
            copyBtn.classList.add('copied')
            setTimeout(() => {
              copyBtn.classList.remove('copied')
            }, 2000)
          } catch (err) {
            console.error('Failed to copy:', err)
          }
        }
      })

      actions.querySelector('.fullscreen').onclick = () => this.show()

      const controls = this.modal.querySelector('.mermaid-controls')
      controls.querySelector('.zoom-in').onclick = () => this.zoom(1.2)
      controls.querySelector('.zoom-out').onclick = () => this.zoom(0.8)
      controls.querySelector('.reset').onclick = () => this.reset()
      controls.querySelector('.close').onclick = () => this.hide()

      // 点击背景关闭
      this.modal.addEventListener('click', (e) => {
        if (e.target === this.modal) this.hide()
      })
    }

    setupDragging() {
      let isDragging = false
      let startX = 0
      let startY = 0
      let startTranslateX = 0
      let startTranslateY = 0

      const container = this.modal.querySelector('.mermaid-container')

      container.addEventListener('mousedown', (e) => {
        isDragging = true
        startX = e.clientX
        startY = e.clientY
        startTranslateX = this.translateX
        startTranslateY = this.translateY
        container.style.cursor = 'grabbing'
      })

      document.addEventListener('mousemove', (e) => {
        if (!isDragging) return
        this.translateX = startTranslateX + (e.clientX - startX)
        this.translateY = startTranslateY + (e.clientY - startY)
        this.updateTransform()
      })

      document.addEventListener('mouseup', () => {
        isDragging = false
        container.style.cursor = 'move'
      })

      // 添加缩放支持
      container.addEventListener('wheel', (e) => {
        e.preventDefault()
        const delta = e.deltaY > 0 ? 0.9 : 1.1
        this.zoom(delta)
      })
    }

    show() {
      const clone = this.diagram.cloneNode(true)
      const container = this.modal.querySelector('.mermaid-container')
      container.innerHTML = ''
      container.appendChild(clone)

      // 先添加 active 类，触发背景动画
      this.modal.classList.add('active')

      // 重置变换
      this.scale = 1
      this.translateX = 0
      this.translateY = 0
      this.updateTransform()
    }

    hide() {
      // 移除 active 类，触发淡出动画
      this.modal.classList.remove('active')
    }

    zoom(factor) {
      this.scale *= factor
      this.updateTransform()
    }

    reset() {
      this.scale = 1
      this.translateX = 0
      this.translateY = 0
      this.updateTransform()
    }

    updateTransform() {
      const container = this.modal.querySelector('.mermaid-container svg')
      if (container) {
        // 直接应用变换，不使用 transition
        container.style.transform = `translate(${this.translateX}px, ${this.translateY}px) scale(${this.scale})`
      }
    }

    async copySource() {
      const source = this.diagram.getAttribute('data-source')
      if (source) {
        try {
          await navigator.clipboard.writeText(decodeURIComponent(source))
          // 可以添加复制成功的提示
        } catch (err) {
          console.error('Failed to copy:', err)
        }
      }
    }
  }

  async function renderMermaidDiagrams() {
    const diagrams = document.querySelectorAll('pre.mermaid')
    for (const element of diagrams) {
      try {
        if (element.hasAttribute('data-processed')) {
          const encodedContent = element.getAttribute('data-original')
          if (encodedContent) {
            const originalContent = decodeURIComponent(atob(encodedContent))
            element.textContent = originalContent
            element.removeAttribute('data-processed')
          }
        } else {
          const content = element.textContent || ''
          const encodedContent = btoa(encodeURIComponent(content))
          element.setAttribute('data-original', encodedContent)
          element.setAttribute('data-source', encodedContent)
        }

        await mermaid.run({
          nodes: [element]
        })

        // 初始化查看器
        if (!element.hasAttribute('data-viewer-initialized')) {
          new MermaidViewer(element)
          element.setAttribute('data-viewer-initialized', 'true')
        }
      } catch (error) {
        console.error('Mermaid rendering error:', error)
      }
    }
  }

  // 初始化并首次渲染
  ;(async () => {
    await initializeMermaid()
    await renderMermaidDiagrams()
  })()

  // 监听主题切换完成事件
  document.addEventListener('theme-transition-complete', async () => {
    await initializeMermaid()
    await renderMermaidDiagrams()
  })
</script>
