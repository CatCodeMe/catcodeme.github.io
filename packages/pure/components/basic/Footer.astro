---
import { Icon as DevIcon } from 'astro-icon/components'
import config from 'virtual:config'

import { getPlatformLabel, hasIcon } from '../../libs/social'
import { Icon } from '../user'

const footerConf = config.footer
const footerLink1 = footerConf.links?.filter(({ pos }) => pos === 1) || []

// Normalize social links data format to unified structure
// Schema transform may return array or object, handle both cases
const normalizeSocialLinks = (
  social: any
): Array<{ platform: string; label: string; url: string; textOnly: boolean }> => {
  if (!social) return []

  // If array format (already transformed by schema or user config)
  if (Array.isArray(social)) {
    return social
  }

  // If object format (old format or not transformed), convert to array
  const result: Array<{ platform: string; label: string; url: string; textOnly: boolean }> = []

  for (const [platform, item] of Object.entries(social)) {
    if (typeof item === 'string') {
      result.push({
        platform,
        label: getPlatformLabel(platform),
        url: item,
        textOnly: false
      })
    } else if (item && typeof item === 'object' && item !== null) {
      // Type guard for custom format
      const customItem = item as { url?: string; label?: string; textOnly?: boolean }
      if (customItem.url) {
        result.push({
          platform,
          label: customItem.label || getPlatformLabel(platform),
          url: customItem.url,
          textOnly: customItem.textOnly === true
        })
      }
    }
  }

  return result
}

const socialLinks = normalizeSocialLinks(footerConf.social)
---

<footer class='mx-auto mb-5 mt-16 w-full'>
  <div class='border-t pt-5'>
    <div class='flex items-center gap-y-3 max-sm:flex-col sm:justify-between sm:gap-y-0'>
      <div
        class='flex items-center gap-x-4 gap-y-2 text-muted-foreground max-sm:flex-col [&_a]:text-foreground'
      >
        {/* Position 1 */}
        {
          footerLink1.length > 0 && (
            <div>
              {footerLink1.map(({ title, link, style }, index) => (
                <span>
                  <a href={link} target='_blank' class={style}>
                    {title}
                  </a>
                  {index < footerLink1.length - 1 && ' • '}
                </span>
              ))}
            </div>
          )
        }
        {/* Position 2 */}
        <div>
          {config.footer.year}
          {
            footerConf.links && footerConf.links.length > 0 && (
              <span>
                {footerConf.links
                  .filter(({ pos }) => pos === 2)
                  .map(({ title, link, style }) => (
                    <span>
                      <a
                        href={link}
                        target='_blank'
                        class:list={['underline underline-offset-4 hover:text-primary', style]}
                      >
                        {title}
                      </a>
                    </span>
                  ))}
              </span>
            )
          }
        </div>
        {
          footerConf.credits && (
            <span class='inline-flex items-center gap-x-2'>
              <a
                href='https://github.com/cworld1/astro-theme-pure'
                target='_blank'
                class='hover:text-primary'
              >
                {/* <DevIcon name='devicon:astro' class='size-4' /> */}
                Astro & Pure theme
              </a>
              <span class='inline-flex items-center gap-x-1'>powered</span>
            </span>
          )
        }
      </div>

      {/* Version */}

      {/* Social Brands */}
      <div class='flex items-center gap-x-4'>
        {
          socialLinks.length > 0
            ? socialLinks.map(({ platform, label, url, textOnly }) => {
                // If textOnly is true or icon doesn't exist, show text
                const shouldShowText = textOnly || !hasIcon(platform)

                return (
                  <a
                    class='inline-block text-muted-foreground transition-all hover:text-muted-foreground/75'
                    href={url}
                    aria-label={label}
                    target='_blank'
                    rel='noopener noreferrer'
                  >
                    {shouldShowText ? (
                      <span class='text-sm'>{label}</span>
                    ) : (
                      <Icon name={platform as any} />
                    )}
                  </a>
                )
              })
            : null
        }
      </div>
    </div>
  </div>
</footer>
