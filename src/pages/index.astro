---
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import { Icon } from '@/custom/components/user'
import { Image } from 'astro:assets'
import { PostPreview } from '@/custom/components/pages'
import bookshelfData from '../../public/bookshelf.json'
import avatarImage from '@/assets/avatar_2.png'
import config from '@/site-config'

const MAX_POSTS = 6
const allPosts = await getBlogCollection()
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS)

// 统计文章总数和总字数
const totalPosts = allPosts.length
let totalWords = 0
for (const post of allPosts) {
  if (post.body) {
    // 移除 HTML 标签和 Markdown 语法
    const text = post.body
      .replace(/<[^>]*>/g, '') // 移除 HTML 标签
      .replace(/\[([^\]]*)\]\([^\)]*\)/g, '$1') // 移除 Markdown 链接
      .replace(/!\[([^\]]*)\]\([^\)]*\)/g, '') // 移除图片
      .replace(/[#*`_~]/g, '') // 移除 Markdown 标记
      .replace(/\n/g, ' ') // 换行符替换为空格
    // 统计中文字符和英文单词
    const chineseChars = text.match(/[\u4e00-\u9fa5]/g) || []
    const englishWords = text.match(/[a-zA-Z]+/g) || []
    totalWords += chineseChars.length + englishWords.length
  }
}

// 获取书架数据
const currentReading = bookshelfData.find((item: any) => item.status === 'reading')
---

<PageLayout meta={{ title: 'Home' }}>
  <main class='flex w-full flex-col'>
    <!-- Dashboard 首页 - 单屏布局 -->
    <div class='w-full py-12 px-4'>
      <div class='mx-auto max-w-6xl'>
        <!-- 主要内容区域 -->
        <div class='grid grid-cols-1 lg:grid-cols-5 gap-6'>
          <!-- 左侧：最近在读 + 最新文章 -->
          <div class='lg:col-span-3 space-y-6 order-2 lg:order-1'>
            {/* 最近在读 - 详细信息 */}
            {currentReading && (
              <div class='dashboard-card reading-card group relative overflow-hidden rounded-xl border-2 border-transparent bg-background p-6 hover:border-purple-500 transition-all hover:shadow-lg hover:shadow-purple-500/10'>
                {/* 装饰性图标 - 在右上角 */}
                <div class='absolute top-4 right-4 w-12 h-12 opacity-10 group-hover:opacity-20 transition-all duration-500'>
                  <Icon name='shelf' class='w-full h-full text-purple-500 transition-all duration-500' />
                </div>
                
                <div class='relative z-10'>
                  <div class='flex items-center justify-between mb-4'>
                    <h2 class='text-lg font-semibold text-foreground group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors'>最近在读</h2>
                    <a href='/shelf' class='text-sm text-primary hover:underline group-hover:translate-x-1 transition-transform inline-block'>前往书架 →</a>
                  </div>
                  
                  <div class='mb-4'>
                    <div class='flex items-start justify-between gap-4 mb-2'>
                      <div class='flex-1 min-w-0'>
                        <h3 class='text-lg font-semibold text-foreground group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors mb-2'>
                          {currentReading.title}
                        </h3>
                        {currentReading.description && (
                          <p class='text-sm text-muted-foreground line-clamp-2'>
                            {currentReading.description}
                          </p>
                        )}
                      </div>
                      <div class='flex items-center gap-2 flex-shrink-0'>
                        {currentReading.rating && (
                          <div class='flex items-center gap-1 rounded-md bg-muted px-2 py-1 text-xs font-medium'>
                            <Icon name='star' class='size-3.5 text-yellow-400' />
                            <span>{currentReading.rating.toFixed(1)}</span>
                          </div>
                        )}
                        <div class='flex items-center gap-1 rounded-md bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200 px-2 py-1 text-xs font-medium'>
                          <Icon name='time' class='size-3.5' />
                          <span>
                            在读{currentReading.progress !== undefined && ` / ${currentReading.progress}%`}
                          </span>
                        </div>
                      </div>
                    </div>
                  </div>
                  {currentReading.tags && currentReading.tags.length > 0 && (
                    <div class='flex flex-wrap gap-2'>
                      {currentReading.tags.slice(0, 4).map((tag) => (
                        <span class='text-xs px-2 py-1 rounded-full bg-muted text-muted-foreground hover:bg-purple-100 dark:hover:bg-purple-900 transition-colors'>{tag}</span>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            )}

            {/* 最新文章 */}
            <div class='dashboard-card posts-card group relative overflow-hidden rounded-xl border-2 border-transparent bg-background p-6 hover:border-blue-500 transition-all hover:shadow-lg hover:shadow-blue-500/10'>
              {/* 装饰性图标 - 在右上角 */}
              <div class='absolute top-4 right-4 w-12 h-12 opacity-10 group-hover:opacity-20 transition-all duration-500'>
                <Icon name='document' class='w-full h-full text-blue-500 transition-all duration-500' />
              </div>
              
              <div class='relative z-10'>
                <div class='flex items-center justify-between mb-4'>
                  <h2 class='text-lg font-semibold text-foreground group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors'>最新文章</h2>
                  <a href='/blog' class='text-sm text-primary hover:underline group-hover:translate-x-1 transition-transform inline-block'>查看更多 →</a>
                </div>
                <ul class='flex flex-col gap-y-3'>
                  {allPostsByDate.map((post) => (
                    <PostPreview post={post} />
                  ))}
                </ul>
              </div>
            </div>

          </div>

          <!-- 右侧：头像 + 技能 + GitHub 活动 -->
          <div class='lg:col-span-2 flex flex-col gap-6 order-1 lg:order-2'>
            {/* 头像卡片 - 背景设计 */}
            <div class='dashboard-card avatar-card group relative overflow-hidden rounded-xl border bg-background hover:border-pink-500/50 transition-all hover:shadow-lg hover:shadow-pink-500/10 flex-1 flex flex-col'>
              <div class='absolute inset-0'>
                <Image 
                  src={avatarImage} 
                  alt='CatCodeMe 头像 - 个人博客作者' 
                  class='w-full h-full object-cover object-center group-hover:scale-110 transition-transform duration-700'
                  loading='eager'
                  fetchpriority='high'
                />
              </div>
              <div class='relative flex-1 flex flex-col justify-end p-3 z-10'>
                <h3 class='text-2xl font-bold text-white mb-3'>{config.title}</h3>
                <div class='inline-flex items-center gap-x-2 rounded-lg border bg-background/90 px-3 py-1.5 text-sm shadow-lg backdrop-blur transition-all hover:shadow-xl'>
                  <span class='relative flex items-center justify-center shrink-0'>
                    <span class='absolute size-2 animate-ping rounded-full border border-green-400 bg-green-400 opacity-75'></span>
                    <span class='size-2 rounded-full bg-green-400'></span>
                  </span>
                  <p class='font-medium text-foreground whitespace-nowrap'>
                    {config.description}
                  </p>
                </div>
              </div>
            </div>

            {/* 统计和社交媒体卡片容器 */}
            <div class='flex flex-col gap-6'>
              {/* 统计卡片 */}
              <div class='dashboard-card stats-card group relative overflow-hidden rounded-xl border-2 border-transparent bg-background p-6 hover:border-green-500 transition-all hover:shadow-lg hover:shadow-green-500/10'>
              {/* 装饰性图标 - 在右上角 */}
              <div class='absolute top-4 right-4 w-12 h-12 opacity-10 group-hover:opacity-20 transition-all duration-500'>
                <Icon name='content-statistic' class='w-full h-full text-green-500 transition-all duration-500' />
              </div>
              
              <div class='relative z-10'>
                <div class='mb-4'>
                  <h2 class='text-lg font-semibold text-foreground group-hover:text-green-600 dark:group-hover:text-green-400 transition-colors'>站点统计</h2>
                </div>
                
                <div class='space-y-2'>
                  {/* 文章总数 */}
                  <div class='flex items-center gap-0 overflow-hidden rounded-md border border-purple-200 dark:border-purple-800'>
                    <div class='px-3 py-1 text-sm font-medium text-purple-700 dark:text-purple-300 bg-purple-50 dark:bg-purple-950/30 text-left'>∑ 文章</div>
                    <div class='flex items-center gap-2 px-3 py-1 bg-purple-100 dark:bg-purple-900 flex-1'>
                      <span class='text-sm font-semibold text-purple-900 dark:text-purple-100'>{totalPosts} / 100</span>
                      <div class='h-1 flex-1 bg-purple-200 dark:bg-purple-800 rounded-full overflow-hidden relative'>
                        <div class='h-full bg-gradient-to-r from-purple-500 to-purple-600 transition-all duration-1000' style={`width: ${Math.min((totalPosts / 100) * 100, 100)}%`}></div>
                      </div>
                    </div>
                  </div>
                  
                  {/* 总字数 */}
                  <div class='flex items-center gap-0 overflow-hidden rounded-md border border-blue-200 dark:border-blue-800'>
                    <div class='px-3 py-1 text-sm font-medium text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-950/30 text-left'>∑ 字数</div>
                    <div class='flex items-center gap-2 px-3 py-1 bg-blue-100 dark:bg-blue-900 flex-1'>
                      <span class='text-sm font-semibold text-blue-900 dark:text-blue-100'>
                        <span id='total-words-display'>{totalWords.toLocaleString()}</span> / 10万
                      </span>
                      <div class='h-1 flex-1 bg-blue-200 dark:bg-blue-800 rounded-full overflow-hidden relative'>
                        <div class='h-full bg-gradient-to-r from-blue-500 to-blue-600 transition-all duration-1000' style={`width: ${Math.min((totalWords / 100000) * 100, 100)}%`}></div>
                      </div>
                    </div>
                  </div>
                  
                  {/* 总浏览量 */}
                  <div class='flex items-center gap-0 overflow-hidden rounded-md border border-green-200 dark:border-green-800'>
                    <div class='px-3 py-1 text-sm font-medium text-green-700 dark:text-green-300 bg-green-50 dark:bg-green-950/30 text-left'>∑ 浏览</div>
                    <div class='flex items-center gap-2 px-3 py-1 bg-green-100 dark:bg-green-900 flex-1'>
                      <span class='text-sm font-semibold text-green-900 dark:text-green-100'>
                        <span id='total-views-display'>-</span> / 10万
                      </span>
                      <div class='h-1 flex-1 bg-green-200 dark:bg-green-800 rounded-full overflow-hidden relative'>
                        <div id='total-views-progress' class='h-full bg-gradient-to-r from-green-500 to-green-600 transition-all duration-1000' style='width: 0%'></div>
                      </div>
                    </div>
                  </div>
                  
                  <span id='vercount_value_site_pv' class='hidden'></span>
                </div>
              </div>
            </div>

              {/* 社交媒体卡片 */}
              <div class='dashboard-card social-card group relative overflow-hidden rounded-xl border-2 border-transparent bg-background p-8 hover:border-orange-500 transition-all hover:shadow-lg hover:shadow-orange-500/10'>
                {/* 装饰性图标 - 在右上角 */}
                <div class='absolute top-4 right-4 w-12 h-12 opacity-10 group-hover:opacity-20 transition-all duration-500'>
                  <Icon name='link' class='w-full h-full text-orange-500 transition-all duration-500' />
                </div>
                
                <div class='relative z-10'>
                  <div class='flex flex-wrap gap-3'>
                    <a href='https://github.com/CatCodeMe' target='_blank' rel='noopener noreferrer' class='group/link flex size-10 items-center justify-center transition-all hover:scale-110' aria-label='访问 GitHub 主页'>
                      <Icon name='github' class='size-6 text-[#181717] dark:text-[#ffffff] transition-transform' />
                    </a>
                    <a href='https://twitter.com/hulj13' target='_blank' rel='noopener noreferrer' class='group/link flex size-10 items-center justify-center transition-all hover:scale-110' aria-label='访问 Twitter 主页'>
                      <Icon name='xFill' class='size-6 text-[#000000] dark:text-[#ffffff] transition-transform' />
                    </a>
                    <a href='https://bsky.app/profile/catcodeme.bsky.social' target='_blank' rel='noopener noreferrer' class='group/link flex size-10 items-center justify-center transition-all hover:scale-110' aria-label='访问 Bluesky 主页'>
                      <Icon name='blueskyFill' class='size-6 text-[#00A8FF] transition-transform' />
                    </a>
                    <a href='/rss.xml' class='group/link flex size-10 items-center justify-center transition-all hover:scale-110' aria-label='订阅 RSS'>
                      <Icon name='rss' class='size-6 text-[#FFA500] transition-transform' />
                    </a>
                  </div>
                </div>
              </div>
            </div>

            </div>
          </div>
        </div>
      </div>
    </div>

<script is:inline>
  // Force light theme on homepage
  localStorage.setItem('theme', 'light');
  document.documentElement.dataset.theme = 'light';

  // 数字滚动动画
  function animateCounter(element, targetValue, duration = 2000) {
    const startValue = 0;
    const startTime = performance.now();
    const targetNumber = parseInt(targetValue.replace(/,/g, ''));
    
    function updateCounter(currentTime) {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);
      
      // 使用 easeOutCubic 缓动函数
      const easeOutCubic = 1 - Math.pow(1 - progress, 3);
      const currentValue = Math.floor(startValue + (targetNumber - startValue) * easeOutCubic);
      
      element.textContent = currentValue.toLocaleString();
      
      if (progress < 1) {
        requestAnimationFrame(updateCounter);
      } else {
        element.textContent = targetValue;
      }
    }
    
    requestAnimationFrame(updateCounter);
  }

  // 邮箱混淆 - 防止爬虫抓取
  function obfuscateEmail() {
    // 将邮箱地址拆分成多个部分，避免明文出现
    const parts = ['1020082805', '@', 'qq', '.', 'com'];
    const email = parts.join('');
    
    const emailLink = document.getElementById('email-link');
    if (emailLink) {
      emailLink.href = 'mailto:' + email;
    }
  }

  // 更新总浏览量显示和进度条
  function updateViewsDisplay(viewsElement, progressElement, newValue, hasAnimated = false) {
    if (viewsElement && progressElement && newValue && newValue !== '-') {
      const views = parseInt(newValue.replace(/,/g, ''));
      
      // 如果是第一次加载，执行滚动动画
      if (!hasAnimated) {
        viewsElement.textContent = '0';
        setTimeout(() => {
          animateCounter(viewsElement, views.toLocaleString(), 2000);
          
          // 进度条动画
          const percentage = Math.min((views / 100000) * 100, 100);
          let currentProgress = 0;
          const startTime = performance.now();
          const duration = 2000;
          
          function updateProgress(currentTime) {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const easeOutCubic = 1 - Math.pow(1 - progress, 3);
            currentProgress = percentage * easeOutCubic;
            
            progressElement.style.width = currentProgress + '%';
            
            if (progress < 1) {
              requestAnimationFrame(updateProgress);
            } else {
              progressElement.style.width = percentage + '%';
            }
          }
          
          requestAnimationFrame(updateProgress);
        }, 500);
      } else {
        // 后续更新直接显示
        viewsElement.textContent = views.toLocaleString();
        const percentage = Math.min((views / 100000) * 100, 100);
        progressElement.style.width = percentage + '%';
      }
    }
  }

  // 页面加载后启动动画
  document.addEventListener('DOMContentLoaded', () => {
    // 总字数滚动动画
    const wordsDisplayElement = document.getElementById('total-words-display');
    if (wordsDisplayElement) {
      const targetValue = wordsDisplayElement.textContent;
      wordsDisplayElement.textContent = '0';
      setTimeout(() => {
        animateCounter(wordsDisplayElement, targetValue, 2000);
      }, 500);
    }
    
    // 监听总浏览量更新
    const viewsDisplayElement = document.getElementById('total-views-display');
    const viewsProgressElement = document.getElementById('total-views-progress');
    const vercountElement = document.getElementById('vercount_value_site_pv');
    let hasAnimatedViews = false;
    
    if (viewsDisplayElement && viewsProgressElement && vercountElement) {
      // 使用 MutationObserver 监听 vercount 元素的变化
      const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          if (mutation.type === 'childList' || mutation.type === 'characterData') {
            const newValue = vercountElement.textContent;
            updateViewsDisplay(viewsDisplayElement, viewsProgressElement, newValue, hasAnimatedViews);
            hasAnimatedViews = true;
          }
        });
      });
      
      observer.observe(vercountElement, {
        childList: true,
        characterData: true,
        subtree: true
      });
      
      // 立即检查一次（如果值已经加载）
      const currentValue = vercountElement.textContent;
      if (currentValue && currentValue !== '-') {
        updateViewsDisplay(viewsDisplayElement, viewsProgressElement, currentValue, hasAnimatedViews);
        hasAnimatedViews = true;
      }
    }
    
  });
</script>
  </main>

<style>
  /* 卡片渐入动画 */
  .dashboard-card {
    animation: fadeInUp 0.6s ease-out;
    animation-fill-mode: both;
  }

  .dashboard-card:nth-child(1) { animation-delay: 0.1s; }
  .dashboard-card:nth-child(2) { animation-delay: 0.2s; }
  .dashboard-card:nth-child(3) { animation-delay: 0.3s; }
  .dashboard-card:nth-child(4) { animation-delay: 0.4s; }
  .dashboard-card:nth-child(5) { animation-delay: 0.5s; }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }


  /* 首页文章预览优化 */
  .posts-card .post-preview {
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
  }

  .posts-card .post-preview:hover {
    background-color: hsl(var(--muted) / 0.5);
  }

  .posts-card .post-preview a {
    gap: 0.5rem;
  }

  .posts-card .post-preview .min-w-\[95px\] {
    min-width: 70px;
    font-size: 0.75rem;
  }

  .posts-card .post-preview .preview-redirect {
    width: 12px;
    height: 12px;
  }

  /* 卡片悬停效果 */
  .reading-card:hover {
    box-shadow: 0 10px 30px -10px rgba(168, 85, 247, 0.2);
    transform: translateY(-2px);
  }

  .posts-card:hover {
    box-shadow: 0 10px 30px -10px rgba(59, 130, 246, 0.2);
    transform: translateY(-2px);
  }

  .avatar-card:hover {
    box-shadow: 0 10px 30px -10px rgba(236, 72, 153, 0.2);
    transform: translateY(-2px);
  }

  .stats-card:hover {
    box-shadow: 0 10px 30px -10px rgba(59, 130, 246, 0.2);
    transform: translateY(-2px);
  }

  .github-card:hover {
    box-shadow: 0 10px 30px -10px rgba(249, 115, 22, 0.2);
    transform: translateY(-2px);
  }

  /* 确保左右两列高度对齐 */
  @media (min-width: 1024px) {
    .grid > div:nth-child(2) {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: stretch;
    }
    
    .grid > div:nth-child(2) > div {
      flex: 1;
    }
  }

  /* 进度条动画 */
  .progress-bar {
    animation: progressGlow 2s ease-in-out infinite;
  }

  @keyframes progressGlow {
    0%, 100% {
      box-shadow: 0 0 5px rgba(168, 85, 247, 0.5);
    }
    50% {
      box-shadow: 0 0 15px rgba(168, 85, 247, 0.8);
    }
  }

</style>
</PageLayout>
