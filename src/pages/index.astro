---
import { Image } from 'astro:assets'
import { Icon } from '@/custom/components/user'

import { getBlogCollection } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import { calculateSiteAge, getHighlightColor } from '@/components/home/utils'
import { getLatestPosts, getTotalWords } from '@/components/shelf/utils'
import HomeHeroImage from '@/components/home/HomeHeroImage.astro'
import avatarImage from '@/assets/home.png'
import config from '@/site-config'

const MAX_POSTS = 6
const allPosts = await getBlogCollection()
const allPostsByDate = await getLatestPosts(MAX_POSTS)

const totalPosts = allPosts.length
const totalWords = await getTotalWords()

// Calculate site age (from 2025-01-27)
const siteAgeText = calculateSiteAge('2025-01-27')

// Use theme color as highlight color
const highlightColor = getHighlightColor()
---

<PageLayout meta={{ title: 'Home' }} highlightColor={highlightColor}>
  {/* Preload LCP image */}
  <link rel='preload' as='image' href={avatarImage.src} fetchpriority='high' />

  <main class='w-screen max-w-screen overflow-x-hidden -mx-[calc(50vw-50%)] bg-background'>
    <div class='max-w-6xl mx-auto px-4 py-6 md:px-12 md:py-10'>
      {/* 封面区域 - Hero 风格设计 */}
      <header class='relative mb-8 pb-6 md:mb-12 md:pb-8 border-b border-border'>
        <div class='grid grid-cols-1 md:grid-cols-[auto_1fr] gap-6 md:gap-8 items-center'>
          {/* 左侧：头像 - 大尺寸 */}
          <div class='flex justify-center md:justify-start'>
            <div
              class='w-32 h-32 md:w-48 md:h-48 lg:w-56 lg:h-56 overflow-hidden rounded-lg flex items-center justify-center bg-muted/30'
            >
              <Image
                src={avatarImage}
                alt='Avatar'
                width={224}
                height={224}
                format='webp'
                quality={90}
                class='w-full h-full object-contain block'
                loading='eager'
                fetchpriority='high'
              />
            </div>
          </div>

          {/* 右侧：文字内容 */}
          <div class='flex flex-col justify-center space-y-4 md:space-y-6'>
            {/* 主标题 - 设置最小高度防止布局偏移 */}
            <h1
              class='text-3xl md:text-5xl lg:text-6xl font-light text-foreground m-0 leading-tight tracking-tight site-title'
            >
              {config.title}
            </h1>

            {/* 格言 */}
            <div class='pt-2 md:pt-4 border-t border-border'>
              <div
                class='text-sm md:text-base font-serif text-foreground/80 leading-relaxed max-w-xl'
              >
                <span class='text-primary/50 text-lg md:text-xl leading-none mr-2'>"</span>
                {config.description}
                <span class='text-primary/50 text-lg md:text-xl leading-none ml-2'>"</span>
              </div>
            </div>

            {/* 位置信息 */}
            <div
              class='flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-x-2 text-sm text-muted-foreground pt-2'
            >
              {/* 位置信息 */}
              <div class='flex items-center gap-2'>
                <Icon name='location' size='1em' />
                <span>China</span>
              </div>

              {/* PC端分隔符 */}
              <span class='hidden sm:inline'>|</span>

              {/* 自我介绍 */}
              <span class='break-words'>{config.about}</span>

              {/* PC端分隔符 */}
              <span class='hidden sm:inline'>|</span>

              {/* 猫咪链接 */}
              <a
                href='/cats'
                class='inline-flex inner-link items-center gap-1 text-muted-foreground hover:text-primary transition-colors'
              >
                <Image
                  src='/favicon/favicon-32x32.png'
                  alt='Cat'
                  width={16}
                  height={16}
                  class='inline-block align-middle'
                />
                <span>永远爱我的猫</span>
              </a>
            </div>
          </div>
        </div>
      </header>

      {/* 主要内容区域 - 多栏布局 */}
      <div class='grid grid-cols-1 md:grid-cols-[1fr_auto] gap-4 md:gap-8'>
        {/* 主栏 - 文章列表 */}
        <main class='flex flex-col md:order-1'>
          <div class='flex items-center gap-2 mb-4 md:mb-5 pb-2 md:pb-3 border-b border-border'>
            <Icon name='document' />
            <span class='text-xs text-muted-foreground uppercase tracking-wider'>最新文章</span>
          </div>
          <div class='flex flex-col gap-0.5'>
            {
              allPostsByDate.map((post, index) => (
                <a href={`/blog/${post.data.slug}`} class='block no-underline group relative z-10'>
                  <article class='relative grid grid-cols-[32px_1fr] gap-3 md:grid-cols-[40px_1fr] md:gap-5 py-2.5 md:py-3 border-b border-border last:border-b-0 transition-colors hover:bg-muted/50 cursor-pointer'>
                    {/* Hero Image - 桌面端右侧渐变显示 */}
                    {'heroImage' in post.data && post.data.heroImage && (
                      <Image
                        alt={post.data.heroImage.alt || post.data.title}
                        class='cover-image-home hidden md:block absolute end-0 top-0 z-0 h-full w-3/5 object-cover opacity-50 transition-opacity duration-300 group-hover:opacity-70'
                        loading='lazy'
                        {...post.data.heroImage}
                      />
                    )}
                    <div class='text-sm md:text-xl font-light text-muted-foreground/90 tabular-nums self-start leading-none relative z-10'>
                      {String(index + 1).padStart(2, '0')}
                    </div>
                    <div class='flex flex-col gap-1 md:gap-1.5 relative z-10 md:me-[40%]'>
                      <div class='flex flex-col gap-0.5 md:gap-1'>
                        <time class='text-xs text-muted-foreground tabular-nums'>
                          {new Date(
                            post.data.publishDate as string | number | Date
                          ).toLocaleDateString('zh-CN', {
                            year: 'numeric',
                            month: '2-digit',
                            day: '2-digit'
                          })}
                        </time>
                        <div class='text-lg md:text-xl font-normal text-foreground m-0 leading-snug transition-colors group-hover:text-primary'>
                          {post.data.title}
                        </div>
                      </div>
                      {post.data.description && (
                        <p class='text-xs md:text-sm text-muted-foreground leading-relaxed m-0'>
                          {post.data.description}
                        </p>
                      )}
                    </div>
                  </article>
                </a>
              ))
            }
          </div>
          <div class='mt-4 md:mt-5 pt-3 md:pt-4 border-t border-border'>
            <a
              href='/blog'
              class='text-sm text-foreground no-underline transition-colors hover:text-primary'
              >全部文章 →</a
            >
          </div>
        </main>

        {/* 右栏 - 侧边栏 */}
        <aside class='flex flex-col gap-3 md:gap-8 md:order-2' style='overflow: visible;'>
          
          {/* Home Hero Image */}
          <HomeHeroImage />

          {/* 统计信息 - 小票样式 - 移动端隐藏 */}
          <div class='receipt-style hidden md:block'>
            <div class='border-l border-r border-dashed border-border px-3 md:px-5'>
              <div
                class='text-xs text-muted-foreground uppercase tracking-wider flex items-center justify-between gap-2 pt-3 pb-2 mb-2 md:pt-4 md:mb-3 border-b-2 border-dashed border-border'
              >
                <div class='flex items-center gap-2'>
                  <Icon name='content-statistic' size='1.25em' />
                  <span>站点统计</span>
                </div>
                <span class='normal-case'>from 2025/01/27</span>
              </div>
              {/* 移动端：2x2网格布局，桌面端：垂直列表 */}
              <div
                class='grid grid-cols-2 gap-2 md:grid-cols-1 md:gap-1 text-sm md:flex md:flex-col'
              >
                <div
                  class='flex justify-between items-center py-1 border-b border-dashed border-border md:border-b md:border-dashed md:border-border'
                >
                  <span class='text-muted-foreground text-xs md:text-sm'>Articles</span>
                  <span class='text-foreground font-semibold tabular-nums text-xs md:text-sm'
                    >{totalPosts}</span
                  >
                </div>
                <div
                  class='flex justify-between items-center py-1 border-b border-dashed border-border md:border-b md:border-dashed md:border-border'
                >
                  <span class='text-muted-foreground text-xs md:text-sm'>Words</span>
                  <span
                    class='text-foreground font-semibold tabular-nums text-xs md:text-sm'
                    id='total-words-display'>{totalWords.toLocaleString()}</span
                  >
                </div>
                <div
                  class='flex justify-between items-center py-1 border-b border-dashed border-border md:border-b md:border-dashed md:border-border'
                >
                  <span class='text-muted-foreground text-xs md:text-sm'>UpTime</span>
                  <span class='text-foreground font-semibold tabular-nums text-xs md:text-sm'
                    >{siteAgeText}</span
                  >
                </div>
                <div
                  class='flex justify-between items-center py-1 border-b border-dashed border-border md:border-b md:border-dashed md:border-border'
                >
                  <span class='text-muted-foreground text-xs md:text-sm'>∑ PV</span>
                  <span
                    class='text-foreground font-semibold tabular-nums text-xs md:text-sm'
                    id='vercount_value_site_pv'>Loading</span
                  >
                </div>
                <div class='flex justify-between items-center py-1 pb-3 md:pb-4 md:border-b-0'>
                  <span class='text-muted-foreground text-xs md:text-sm'>∑ UV</span>
                  <span
                    class='text-foreground font-semibold tabular-nums text-xs md:text-sm'
                    id='vercount_value_site_uv'>Loading</span
                  >
                </div>
              </div>
            </div>
          </div>

          {/* 联系我 */}
          <div style='padding: 12px 20px;'>
            <div class='px-3 md:px-5'>
              <div
                class='text-xs text-muted-foreground uppercase tracking-wider flex items-center gap-2 pt-3 pb-2 mb-2 md:pt-4 md:mb-3 border-b-2 border-dashed border-border'
              >
                <Icon name='contract' size='1.25em' />
                <span>联系我</span>
              </div>
              {/* 移动端：紧凑的图标按钮布局，桌面端：带文字的链接 */}
              <div
                class='grid grid-cols-5 gap-2 md:flex md:flex-row md:flex-wrap md:gap-3 md:gap-4 pb-3 md:pb-4'
              >
                <a
                  href='https://github.com/CatCodeMe'
                  target='_blank'
                  rel='noopener noreferrer'
                  aria-labelledby='GitHub'
                  class='flex items-center justify-center gap-1 md:gap-2 text-xs md:text-sm text-muted-foreground no-underline transition-colors hover:text-primary py-2 md:py-2'
                >
                  <Icon name='github' size='1.25em' />
                  <span class='hidden md:inline'>GitHub</span>
                </a>
                <a
                  href='https://twitter.com/hulj13'
                  target='_blank'
                  rel='noopener noreferrer'
                  aria-labelledby='X'
                  class='flex items-center justify-center gap-1 md:gap-2 text-xs md:text-sm text-muted-foreground no-underline transition-colors hover:text-primary py-2 md:py-2'
                >
                  <Icon name='x' size='1.25em' />
                  <span class='hidden md:inline'>X</span>
                </a>
                <a
                  href='https://bsky.app/profile/catcodeme.bsky.social'
                  target='_blank'
                  rel='noopener noreferrer'
                  aria-labelledby='Bluesky'
                  class='flex items-center justify-center gap-1 md:gap-2 text-xs md:text-sm text-muted-foreground no-underline transition-colors hover:text-primary py-2 md:py-2'
                >
                  <Icon name='bluesky' size='1.25em' />
                  <span class='hidden md:inline'>Bluesky</span>
                </a>
                <a
                  href='https://t.me/ccm_life'
                  target='_blank'
                  rel='noopener noreferrer'
                  aria-labelledby='Telegram'
                  class='flex items-center justify-center gap-1 md:gap-2 text-xs md:text-sm text-muted-foreground no-underline transition-colors hover:text-primary py-2 md:py-2'
                >
                  <Icon name='telegram' size='1.25em' />
                  <span class='hidden md:inline'>Telegram</span>
                </a>
                <a
                  href='/rss.xml'
                  target='_blank'
                  rel='noopener noreferrer'
                  aria-labelledby='RSS'
                  class='flex items-center justify-center gap-1 md:gap-2 text-xs md:text-sm text-primary no-underline transition-colors hover:text-primary/90 py-2 md:py-2'
                >
                  <Icon name='rss' size='1.25em' />
                  <span class='hidden md:inline'>RSS</span>
                </a>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <style>
    /* 小票样式 - 简洁左右虚线边框 */
    .receipt-style {
      width: 100%;
      max-width: 100%;
      padding: 12px 16px;
      border: none !important;
    }

    @media (min-width: 768px) {
      .receipt-style {
        padding: 20px;
      }
    }

    /* 侧边栏最大宽度限制，自适应但不会过宽 */
    aside {
      max-width: 380px;
    }

    @media (max-width: 768px) {
      aside {
        max-width: 100%;
      }
    }

    /* 主标题 - 防止布局偏移 */
    .site-title {
      /* 设置最小高度，防止字体加载时的布局偏移 */
      min-height: 1.2em;
      /* 使用 contain 来优化渲染性能 */
      contain: layout style;
    }

    /* 响应式最小高度 */
    @media (min-width: 768px) {
      .site-title {
        min-height: 1.15em;
      }
    }

    @media (min-width: 1024px) {
      .site-title {
        min-height: 1.1em;
      }
    }

    /* Hero Image 渐变遮罩 - 桌面端右侧渐变 */
    .cover-image-home {
      mask-image: linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
      -ms-mask-image: -ms-linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
      -webkit-mask-image: -webkit-linear-gradient(
        to right,
        rgba(0, 0, 0, 0) 0%,
        rgba(0, 0, 0, 1) 100%
      );
    }
  </style>
</PageLayout>
