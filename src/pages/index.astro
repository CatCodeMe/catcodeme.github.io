---
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import { Icon } from '@/custom/components/user'
import { Image } from 'astro:assets'
import bookshelfData from '../../public/bookshelf.json'
import avatarImage from '@/assets/avatar_2.png'
import config from '@/site-config'

const MAX_POSTS = 6
const allPosts = await getBlogCollection()
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS)

const totalPosts = allPosts.length
let totalWords = 0
for (const post of allPosts) {
  if (post.body) {
    const text = post.body
      .replace(/<[^>]*>/g, '')
      .replace(/\[([^\]]*)\]\([^\)]*\)/g, '$1')
      .replace(/!\[([^\]]*)\]\([^\)]*\)/g, '')
      .replace(/[#*`_~]/g, '')
      .replace(/\n/g, ' ')
    const chineseChars = text.match(/[\u4e00-\u9fa5]/g) || []
    const englishWords = text.match(/[a-zA-Z]+/g) || []
    totalWords += chineseChars.length + englishWords.length
  }
}

const currentReading = bookshelfData.find((item: any) => item.status === 'reading')
---

<PageLayout meta={{ title: 'Home' }}>
  <main class='grid-main'>
    <div class='grid-container'>
      {/* 标题卡片 - 占据顶部整行 */}
      <div class='grid-card grid-card-title'>
        <h1 class='card-title'>{config.title}</h1>
        <p class='card-subtitle'>{config.description}</p>
      </div>

      {/* 统计卡片组 - 三列 */}
      <div class='grid-card grid-card-stats'>
        <div class='stat-item'>
          <div class='stat-value'>{totalPosts}</div>
          <div class='stat-label'>文章</div>
        </div>
        <div class='stat-item'>
          <div class='stat-value' id='total-words-display'>{totalWords.toLocaleString()}</div>
          <div class='stat-label'>字数</div>
        </div>
        <div class='stat-item'>
          <div class='stat-value' id='total-views-display'>-</div>
          <div class='stat-label'>浏览</div>
        </div>
      </div>

      {/* 最近在读卡片 */}
      {currentReading && (
        <div class='grid-card grid-card-reading'>
          <div class='card-label'>最近在读</div>
          <h2 class='card-heading'>{currentReading.title}</h2>
          {currentReading.description && (
            <p class='card-text'>{currentReading.description}</p>
          )}
          <div class='card-footer'>
            {currentReading.rating && (
              <span class='card-tag'>{currentReading.rating.toFixed(1)}</span>
            )}
            {currentReading.progress !== undefined && (
              <span class='card-tag'>{currentReading.progress}%</span>
            )}
            <a href='/shelf' class='card-link'>书架 →</a>
          </div>
        </div>
      )}

      {/* 最新文章卡片 - 占据较大空间 */}
      <div class='grid-card grid-card-posts'>
        <div class='card-label'>最新文章</div>
        <div class='posts-list'>
          {allPostsByDate.map((post, index) => (
            <article class='post-item' key={post.id}>
              <div class='post-number'>{String(index + 1).padStart(2, '0')}</div>
              <div class='post-content'>
                <time class='post-date'>
                  {new Date(post.data.publishDate).toLocaleDateString('zh-CN', { 
                    month: 'short', 
                    day: 'numeric',
                    year: 'numeric'
                  })}
                </time>
                <h3 class='post-title'>
                  <a href={post.url}>{post.data.title}</a>
                </h3>
                {post.data.description && (
                  <p class='post-excerpt'>{post.data.description}</p>
                )}
              </div>
            </article>
          ))}
        </div>
        <div class='card-footer'>
          <a href='/blog' class='card-link'>全部文章 →</a>
        </div>
      </div>

      {/* 联系卡片 */}
      <div class='grid-card grid-card-links'>
        <div class='card-label'>联系方式</div>
        <div class='links-list'>
          <a href='https://github.com/CatCodeMe' target='_blank' rel='noopener noreferrer' class='link-item'>
            GitHub
          </a>
          <a href='https://twitter.com/hulj13' target='_blank' rel='noopener noreferrer' class='link-item'>
            Twitter
          </a>
          <a href='https://bsky.app/profile/catcodeme.bsky.social' target='_blank' rel='noopener noreferrer' class='link-item'>
            Bluesky
          </a>
          <a href='https://t.me/ccm_life' target='_blank' rel='noopener noreferrer' class='link-item'>
            Telegram
          </a>
          <a href='/rss.xml' class='link-item'>
            RSS
          </a>
        </div>
      </div>

      {/* 信息卡片 */}
      <div class='grid-card grid-card-info'>
        <div class='info-item'>
          <span class='info-label'>位置</span>
          <span class='info-value'>北京</span>
        </div>
        <div class='info-item'>
          <span class='info-label'>状态</span>
          <span class='info-value'>在线</span>
        </div>
      </div>
    </div>

    <span id='vercount_value_site_pv' class='hidden'></span>

<script is:inline>
  function animateCounter(element, targetValue, duration = 2000) {
    const startValue = 0;
    const startTime = performance.now();
    const targetNumber = parseInt(targetValue.replace(/,/g, ''));
    
    function updateCounter(currentTime) {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const easeOutCubic = 1 - Math.pow(1 - progress, 3);
      const currentValue = Math.floor(startValue + (targetNumber - startValue) * easeOutCubic);
      element.textContent = currentValue.toLocaleString();
      
      if (progress < 1) {
        requestAnimationFrame(updateCounter);
      } else {
        element.textContent = targetValue;
      }
    }
    
    requestAnimationFrame(updateCounter);
  }

  function updateViewsDisplay(viewsElement, newValue, hasAnimated = false) {
    if (viewsElement && newValue && newValue !== '-') {
      const views = parseInt(newValue.replace(/,/g, ''));
      
      if (!hasAnimated) {
        viewsElement.textContent = '0';
        setTimeout(() => {
          animateCounter(viewsElement, views.toLocaleString(), 2000);
        }, 500);
      } else {
        viewsElement.textContent = views.toLocaleString();
      }
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const wordsDisplayElement = document.getElementById('total-words-display');
    if (wordsDisplayElement) {
      const targetValue = wordsDisplayElement.textContent;
      wordsDisplayElement.textContent = '0';
      setTimeout(() => {
        animateCounter(wordsDisplayElement, targetValue, 2000);
      }, 500);
    }
    
    const viewsDisplayElement = document.getElementById('total-views-display');
    const vercountElement = document.getElementById('vercount_value_site_pv');
    let hasAnimatedViews = false;
    
    if (viewsDisplayElement && vercountElement) {
      const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          if (mutation.type === 'childList' || mutation.type === 'characterData') {
            const newValue = vercountElement.textContent;
            updateViewsDisplay(viewsDisplayElement, newValue, hasAnimatedViews);
            hasAnimatedViews = true;
          }
        });
      });
      
      observer.observe(vercountElement, {
        childList: true,
        characterData: true,
        subtree: true
      });
      
      const currentValue = vercountElement.textContent;
      if (currentValue && currentValue !== '-') {
        updateViewsDisplay(viewsDisplayElement, currentValue, hasAnimatedViews);
        hasAnimatedViews = true;
      }
    }
  });
</script>

<style>
  /* 方案C：网格系统风格 */
  /* 确保不受 BaseLayout 包装影响 */
  .grid-main {
    width: 100vw !important;
    max-width: 100vw !important;
    padding: 0 !important;
    margin: 0 !important;
    margin-left: calc(-50vw + 50%) !important;
    margin-right: calc(-50vw + 50%) !important;
    background: #ffffff;
  }

  .grid-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 4rem 3rem;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.5rem;
    grid-auto-rows: min-content;
  }

  @media (max-width: 1200px) {
    .grid-container {
      grid-template-columns: repeat(8, 1fr);
    }
  }

  @media (max-width: 768px) {
    .grid-container {
      grid-template-columns: repeat(4, 1fr);
      padding: 3rem 2rem;
      gap: 1rem;
    }
  }

  /* 网格卡片基础样式 */
  .grid-card {
    background: #ffffff;
    border: 1px solid #e0e0e0;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s;
  }

  .grid-card:hover {
    border-color: #000000;
  }

  @media (max-width: 768px) {
    .grid-card {
      padding: 1.5rem;
    }
  }

  /* 标题卡片 - 占据整行 */
  .grid-card-title {
    grid-column: 1 / -1;
    border: none;
    padding: 0 0 3rem 0;
    border-bottom: 1px solid #e0e0e0;
  }

  .card-title {
    font-size: 3rem;
    font-weight: 300;
    color: #000000;
    margin: 0 0 0.75rem 0;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .card-subtitle {
    font-size: 1.125rem;
    color: #666666;
    margin: 0;
    line-height: 1.6;
    font-weight: 300;
  }

  @media (max-width: 768px) {
    .card-title {
      font-size: 2rem;
    }

    .card-subtitle {
      font-size: 1rem;
    }
  }

  /* 统计卡片 - 占据整行 */
  .grid-card-stats {
    grid-column: 1 / -1;
    flex-direction: row;
    justify-content: space-around;
    border: none;
    border-bottom: 1px solid #e0e0e0;
    padding: 2rem 0;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .stat-value {
    font-size: 1.5rem;
    font-weight: 400;
    color: #000000;
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: 0.75rem;
    color: #888888;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* 最近在读卡片 - 占据4列 */
  .grid-card-reading {
    grid-column: span 4;
  }

  @media (max-width: 1200px) {
    .grid-card-reading {
      grid-column: span 4;
    }
  }

  @media (max-width: 768px) {
    .grid-card-reading {
      grid-column: span 4;
    }
  }

  /* 最新文章卡片 - 占据8列 */
  .grid-card-posts {
    grid-column: span 8;
  }

  @media (max-width: 1200px) {
    .grid-card-posts {
      grid-column: span 4;
    }
  }

  @media (max-width: 768px) {
    .grid-card-posts {
      grid-column: span 4;
    }
  }

  /* 联系卡片 - 占据4列 */
  .grid-card-links {
    grid-column: span 4;
  }

  @media (max-width: 1200px) {
    .grid-card-links {
      grid-column: span 4;
    }
  }

  @media (max-width: 768px) {
    .grid-card-links {
      grid-column: span 4;
    }
  }

  /* 信息卡片 - 占据8列 */
  .grid-card-info {
    grid-column: span 8;
    flex-direction: row;
    justify-content: flex-start;
    gap: 3rem;
  }

  @media (max-width: 1200px) {
    .grid-card-info {
      grid-column: span 4;
    }
  }

  @media (max-width: 768px) {
    .grid-card-info {
      grid-column: span 4;
      flex-direction: column;
      gap: 1rem;
    }
  }

  /* 卡片通用元素 */
  .card-label {
    font-size: 0.75rem;
    color: #888888;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }

  .card-heading {
    font-size: 1.5rem;
    font-weight: 400;
    color: #000000;
    margin: 0 0 0.75rem 0;
    line-height: 1.4;
  }

  .card-text {
    font-size: 0.9375rem;
    color: #666666;
    line-height: 1.6;
    margin: 0 0 1rem 0;
  }

  .card-footer {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: auto;
  }

  .card-tag {
    font-size: 0.8125rem;
    color: #666666;
  }

  .card-link {
    font-size: 0.875rem;
    color: #000000;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .card-link:hover {
    opacity: 0.5;
  }

  /* 文章列表 */
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .post-item {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid #f0f0f0;
  }

  .post-item:first-child {
    border-top: none;
    padding-top: 0;
  }

  @media (max-width: 768px) {
    .post-item {
      grid-template-columns: 30px 1fr;
      gap: 1rem;
      padding: 1rem 0;
    }
  }

  .post-number {
    font-size: 0.75rem;
    color: #cccccc;
    font-variant-numeric: tabular-nums;
    align-self: start;
    font-weight: 300;
  }

  .post-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .post-date {
    font-size: 0.75rem;
    color: #888888;
    font-variant-numeric: tabular-nums;
  }

  .post-title {
    font-size: 1.125rem;
    font-weight: 400;
    color: #000000;
    margin: 0;
    line-height: 1.4;
  }

  .post-title a {
    color: #000000;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .post-title a:hover {
    opacity: 0.5;
  }

  .post-excerpt {
    font-size: 0.9375rem;
    color: #666666;
    line-height: 1.6;
    margin: 0;
  }

  /* 链接列表 */
  .links-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .link-item {
    font-size: 0.875rem;
    color: #666666;
    text-decoration: none;
    transition: color 0.2s;
  }

  .link-item:hover {
    color: #000000;
  }

  /* 信息项 */
  .info-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .info-label {
    font-size: 0.75rem;
    color: #888888;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .info-value {
    font-size: 0.875rem;
    color: #000000;
  }
</style>
  </main>
</PageLayout>
