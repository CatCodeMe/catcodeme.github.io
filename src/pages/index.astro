---
import { PostPreview } from '@/custom/components/pages'

import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/home/Section.astro'
import SkillLayout from '@/components/home/SkillLayout.astro'

const languages = [
  { name: 'Java', icon: 'devicon:java' },
  { name: 'Zig', icon: 'devicon:zig' },
  { name: 'Python', icon: 'devicon:python' },
  { name: 'Shell', icon: 'devicon:bash' }
]

const backend = [
  { name: 'Spring', icon: 'devicon:spring' },
  { name: 'Redis', icon: 'devicon:redis' },
  { name: 'ClickHouse', icon: 'devicon:clickhouse' },
  { name: 'Mysql', icon: 'devicon:mysql' },
  { name: 'Apache Spark', icon: 'devicon:apachespark' }
]

const MAX_POSTS = 10
const allPosts = await getBlogCollection()
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS)
---

<PageLayout meta={{ title: 'Home' }}>
  <main class='flex w-full flex-col'>
    <!-- 第一屏 -->
    <div id='main-content' class='relative z-10 flex flex-col items-center px-4'>
      <!-- Motto Block -->
      <div class='relative z-10 mt-16 flex justify-center'>
        <div
          class='inline-flex items-center gap-x-2 sm:gap-x-3 rounded-full border bg-background/80 px-3 py-1.5 sm:px-4 sm:py-2 text-xs sm:text-sm shadow-sm backdrop-blur transition-shadow hover:shadow-md'
        >
          <span class='relative flex items-center justify-center shrink-0'>
            <span
              class='absolute size-1.5 sm:size-2 animate-ping rounded-full border border-green-400 bg-green-400 opacity-75'
            ></span>
            <span class='size-1.5 sm:size-2 rounded-full bg-green-400'></span>
          </span>
          <p class='font-medium text-muted-foreground whitespace-nowrap'>
            文字沉淀生命, 回忆勾连古今
          </p>
        </div>
      </div>

      <div class='relative w-screen'>
        <canvas id='rive-canvas' class='w-full h-auto'></canvas>
        <p class='absolute right-6 text-xs text-muted-foreground/50 pointer-events-none bottom-4 sm:bottom-12'>
          Animation by <a
            href='https://fivepathways.com/'
            target='_blank'
            rel='noreferrer noopener'
            class='underline pointer-events-auto'>fivepathways.com</a
          >
        </p>
      </div>
    </div>

    <!-- 第二屏：博客文章和技能 -->
    <section class='w-full py-20 scroll-content bg-background'>
      <div class='mx-auto max-w-4xl px-4'>
        <!-- 博客文章部分 -->
        <Section title='Latest Posts'>
          {
            allPostsByDate.length > 0 && (
              <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
                {allPostsByDate.map((p) => (
                  <li class='flex flex-col gap-x-2 sm:flex-row'>
                    <PostPreview post={p} />
                  </li>
                ))}
              </ul>
            )
          }
          <Button title='More posts' class='w-fit self-end' href='/blog' style='ahead' />
        </Section>

        <!-- 技能部分 -->
        <Section title='Skills' class='mt-20'>
          <SkillLayout title='Languages' skills={languages} />
          <SkillLayout title='Backend' skills={backend} />
          <!-- <SkillLayout title='IDE' skills={ide} /> -->
        </Section>

        <!-- GitHub 活动图 -->
        <Section title='GH-Activities' class='mt-20'>
          <img
            class='hidden w-full dark:block'
            src='https://raw.githubusercontent.com/CatCodeMe/catcodeme/output/github-contribution-grid-snake-dark.svg'
            alt='github contribution snake dark'
            loading='lazy'
          />
          <img
            class='block w-full dark:hidden'
            src='https://raw.githubusercontent.com/CatCodeMe/catcodeme/output/github-contribution-grid-snake.svg'
            alt='github contribution snake light'
            loading='lazy'
          />
        </Section>
      </div>
    </section>
<script is:inline>
  // Force light theme on homepage
  localStorage.setItem('theme', 'light');
  document.documentElement.dataset.theme = 'light';
  // Add class to body for homepage-specific styles
  document.body.classList.add('hide-scrollbar');
</script>
  </main>

  <script>
    import { Rive } from '@rive-app/canvas'

    const canvas = document.getElementById('rive-canvas') as HTMLCanvasElement
    if (canvas) {
      const rive = new Rive({
        src: '/clouds/hero-home.riv',
        // src: '/clouds/footer.riv',
        canvas: canvas,
        autoplay: true,
        stateMachines: 'state_home-hero',
        // stateMachines: 'state_footer',
        onLoad: () => {
          rive.resizeDrawingSurfaceToCanvas()
        }
      })
    }
  </script>
</PageLayout>
