  /* 收银纸内容 */
  .receipt-content {
    padding: 3rem 4rem;
    font-family: 'Courier New', 'Consolas', 'Monaco', monospace;
    background: #ffffff;
  }

  @media (max-width: 768px) {
    .receipt-content {
      padding: 2rem 1.5rem;
    }
  }

  /* 头部区域 */
  .receipt-header-section {
    text-align: center;
    margin-bottom: 2rem;
  }

  .receipt-store-name {
    font-size: 2rem;
    font-weight: 700;
    color: #000000;
    letter-spacing: 2px;
    margin-bottom: 0.5rem;
  }

  .receipt-store-subtitle {
    font-size: 1rem;
    color: #666666;
    margin-bottom: 1rem;
  }

  .receipt-divider-line {
    height: 1px;
    background: repeating-linear-gradient(
      to right,
      transparent 0px,
      transparent 2px,
      #000000 2px,
      #000000 4px
    );
    margin: 1rem 0;
  }

  .receipt-store-info {
    text-align: left;
    max-width: 400px;
    margin: 0 auto;
  }

  .receipt-info-row {
    display: flex;
    justify-content: space-between;
    padding: 0.25rem 0;
    font-size: 0.875rem;
  }

  .receipt-info-label {
    color: #666666;
  }

  .receipt-info-value {
    color: #000000;
    font-weight: 600;
  }

  /* 主体区域 */
  .receipt-body-section {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 3rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 1024px) {
    .receipt-body-section {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* 章节 */
  .receipt-section {
    margin-bottom: 2rem;
  }

  .receipt-section-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .receipt-section-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: #000000;
  }

  .receipt-section-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: #000000;
    letter-spacing: 1px;
  }

  .receipt-section-content {
    padding-left: 0.25rem;
  }

  /* 分隔线 */
  .receipt-divider-dashed {
    height: 1px;
    background: repeating-linear-gradient(
      to right,
      transparent 0px,
      transparent 3px,
      #cccccc 3px,
      #cccccc 6px
    );
    margin: 0.75rem 0;
  }

  .receipt-divider-dotted {
    height: 1px;
    background: repeating-linear-gradient(
      to right,
      transparent 0px,
      transparent 1px,
      #cccccc 1px,
      #cccccc 2px
    );
    margin: 0.5rem 0;
  }

  /* 行项目 */
  .receipt-item-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 0.5rem 0;
    font-size: 0.875rem;
  }

  .receipt-item-label {
    color: #666666;
    min-width: 80px;
    text-align: left;
