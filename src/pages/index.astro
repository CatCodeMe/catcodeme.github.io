---
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import { Icon } from '@/custom/components/user'
import { Image } from 'astro:assets'
import bookshelfData from '../../public/bookshelf.json'
import avatarImage from '@/assets/avatar_2.png'

const MAX_POSTS = 5
const allPosts = await getBlogCollection()
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS)

// 统计文章总数和总字数
const totalPosts = allPosts.length
let totalWords = 0
for (const post of allPosts) {
  if (post.body) {
    // 移除 HTML 标签和 Markdown 语法
    const text = post.body
      .replace(/<[^>]*>/g, '') // 移除 HTML 标签
      .replace(/\[([^\]]*)\]\([^\)]*\)/g, '$1') // 移除 Markdown 链接
      .replace(/!\[([^\]]*)\]\([^\)]*\)/g, '') // 移除图片
      .replace(/[#*`_~]/g, '') // 移除 Markdown 标记
      .replace(/\n/g, ' ') // 换行符替换为空格
    // 统计中文字符和英文单词
    const chineseChars = text.match(/[\u4e00-\u9fa5]/g) || []
    const englishWords = text.match(/[a-zA-Z]+/g) || []
    totalWords += chineseChars.length + englishWords.length
  }
}

// 获取书架数据
const currentReading = bookshelfData.find((item: any) => item.status === 'reading')
---

<PageLayout meta={{ title: 'Home' }}>
  <main class='flex w-full flex-col'>
    <!-- Dashboard 首页 - 单屏布局 -->
    <div class='w-full py-12 px-4'>
      <div class='mx-auto max-w-6xl'>
        <!-- 主要内容区域 -->
        <div class='grid grid-cols-1 lg:grid-cols-5 gap-6'>
          <!-- 左侧：最近在读 + 最新文章 -->
          <div class='lg:col-span-3 space-y-6 order-2 lg:order-1'>
            {/* 最近在读 - 详细信息 */}
            {currentReading && (
              <div class='dashboard-card reading-card group relative overflow-hidden rounded-lg border bg-background p-6 hover:border-primary/50 transition-all'>
                {/* 背景图片层 */}
                <div class='absolute inset-0 bg-gradient-to-br from-purple-500/20 via-purple-400/10 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-700 scale-110 group-hover:scale-100'></div>
                <div class='absolute top-0 right-0 w-32 h-32 bg-purple-500/5 rounded-full blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500'></div>
                <div class='relative'>
                  <div class='flex items-start gap-4 mb-4'>
                    <div class='icon-mask size-8 rounded-lg bg-purple-100 dark:bg-purple-900 flex items-center justify-center transition-all duration-500 flex-shrink-0'>
                      <Icon name='book' class='size-5 text-purple-600 dark:text-purple-400 transition-all duration-500' />
                    </div>
                    <div class='flex-1 min-w-0'>
                      <div class='flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-1'>
                        <div class='flex items-center gap-2'>
                          <span class='text-sm text-muted-foreground'>最近在读</span>
                          <span class='text-xs px-1.5 py-0.5 sm:px-2 rounded-full bg-purple-100 dark:bg-purple-900 text-purple-600 dark:text-purple-400 font-medium whitespace-nowrap'>
                            进行中
                          </span>
                        </div>
                        <a href='/shelf' class='text-sm text-primary hover:underline group-hover:translate-x-1 transition-transform inline-block'>前往书架 →</a>
                      </div>
                      <h3 class='text-lg font-semibold text-foreground group-hover:text-primary transition-colors mb-2'>
                        {currentReading.title}
                      </h3>
                      {currentReading.description && (
                        <p class='text-sm text-muted-foreground line-clamp-2 mb-3'>
                          {currentReading.description}
                        </p>
                      )}
                      {currentReading.progress !== undefined && (
                        <div class='space-y-2'>
                          <div class='flex items-center justify-between text-sm'>
                            <span class='text-muted-foreground'>阅读进度</span>
                            <span class='font-medium text-purple-600 dark:text-purple-400'>{currentReading.progress}%</span>
                          </div>
                          <div class='flex-1 h-2 bg-muted rounded-full overflow-hidden'>
                            <div class='progress-bar h-full bg-gradient-to-r from-purple-500 to-purple-600 rounded-full transition-all duration-1000' style={`width: ${currentReading.progress}%`}></div>
                          </div>
                        </div>
                      )}
                    </div>
                  </div>
                  {currentReading.tags && currentReading.tags.length > 0 && (
                    <div class='flex flex-wrap gap-2 mt-4 pt-4 border-t border-border'>
                      {currentReading.tags.slice(0, 4).map((tag) => (
                        <span class='text-xs px-2 py-1 rounded bg-muted text-muted-foreground'>{tag}</span>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            )}

            {/* 最新文章 */}
            <div class='dashboard-card posts-card group relative overflow-hidden rounded-lg border bg-background p-6 hover:border-primary/50 transition-all'>
              {/* 背景图片层 */}
              <div class='absolute inset-0 bg-gradient-to-br from-blue-500/20 via-blue-400/10 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-700 scale-110 group-hover:scale-100'></div>
              <div class='absolute top-0 right-0 w-32 h-32 bg-blue-500/5 rounded-full blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500'></div>
              <div class='relative'>
                <div class='flex items-center justify-between mb-4'>
                  <div class='flex items-center gap-2'>
                    <div class='icon-mask size-8 rounded-lg bg-blue-100 dark:bg-blue-900 flex items-center justify-center transition-all duration-500'>
                      <Icon name='document' class='size-5 text-blue-600 dark:text-blue-400 transition-all duration-500' />
                    </div>
                    <h2 class='text-lg font-semibold text-foreground'>最新文章</h2>
                  </div>
                  <a href='/blog' class='text-sm text-primary hover:underline group-hover:translate-x-1 transition-transform inline-block'>查看更多 →</a>
                </div>
                <ul class='space-y-2'>
                  {allPostsByDate.map((post) => (
                    <li class='post-item'>
                      <a href={`/blog/${post.data.slug}`} class='flex items-center gap-3 p-2 rounded hover:bg-muted/50 transition-all group/item'>
                        <div class='size-6 rounded bg-muted flex items-center justify-center group-hover/item:bg-primary/10 group-hover/item:scale-110 transition-all'>
                          <Icon name='document' class='size-3 text-muted-foreground group-hover/item:text-primary transition-colors' />
                        </div>
                        <span class='text-sm text-foreground group-hover/item:text-primary transition-colors flex-1 truncate'>
                          {post.data.title}
                        </span>
                        <span class='text-xs text-muted-foreground group-hover/item:text-foreground transition-colors'>
                          {new Date(String(post.data.publishDate)).toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' })}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

          </div>

          <!-- 右侧：头像 + 技能 + GitHub 活动 -->
          <div class='lg:col-span-2 space-y-6 order-1 lg:order-2'>
            {/* 头像卡片 - 背景设计 */}
            <div class='dashboard-card avatar-card group relative overflow-hidden rounded-lg border bg-background hover:border-primary/50 transition-all'>
              <div class='absolute inset-0'>
                <Image 
                  src={avatarImage} 
                  alt='CatCodeMe 头像 - 个人博客作者' 
                  class='w-full h-full object-cover'
                  loading='eager'
                  fetchpriority='high'
                />
              </div>
              <div class='relative p-6 z-10'>
                <h3 class='text-xl font-semibold text-white mb-3'>CatCodeMe</h3>
                <div class='inline-flex items-center gap-x-2 rounded-lg border bg-background/80 px-3 py-1.5 text-xs shadow-sm backdrop-blur transition-shadow hover:shadow-md mb-3'>
                  <span class='relative flex items-center justify-center shrink-0'>
                    <span class='absolute size-1.5 animate-ping rounded-full border border-green-400 bg-green-400 opacity-75'></span>
                    <span class='size-1.5 rounded-full bg-green-400'></span>
                  </span>
                  <p class='font-medium text-muted-foreground whitespace-nowrap'>
                    文字沉淀生命, 回忆勾连古今
                  </p>
                </div>
                <div class='flex items-center gap-3'>
                  <a href='https://github.com/CatCodeMe' target='_blank' rel='noopener noreferrer' class='text-white hover:text-primary transition-colors' aria-label='访问 GitHub 主页'>
                    <Icon name='github' class='size-5' />
                  </a>
                  <a href='https://twitter.com/hulj13' target='_blank' rel='noopener noreferrer' class='text-white hover:text-primary transition-colors' aria-label='访问 Twitter 主页'>
                    <Icon name='x' class='size-5' />
                  </a>
                  <a href='/rss.xml' class='text-white hover:text-primary transition-colors' aria-label='订阅 RSS'>
                    <Icon name='rss' class='size-5' />
                  </a>
                  <a href='#' id='email-link' class='text-white hover:text-primary transition-colors' aria-label='发送邮件'>
                    <Icon name='email' class='size-5' />
                  </a>
                </div>
              </div>
            </div>

            {/* 统计卡片 */}
            <div class='dashboard-card stats-card group relative overflow-hidden rounded-lg border bg-background p-6 hover:border-primary/50 transition-all'>
              {/* 背景图片层 */}
              <div class='absolute inset-0 bg-gradient-to-br from-blue-500/20 via-blue-400/10 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-700 scale-110 group-hover:scale-100'></div>
              <div class='absolute top-0 right-0 w-32 h-32 bg-blue-500/5 rounded-full blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500'></div>
              <div class='relative'>
                <div class='flex items-center gap-2 mb-4'>
                  <div class='icon-mask size-8 rounded-lg bg-blue-100 dark:bg-blue-900 flex items-center justify-center transition-all duration-500'>
                    <Icon name='content-statistic' class='size-5 text-blue-600 dark:text-blue-400 transition-all duration-500' />
                  </div>
                  <h2 class='text-lg font-semibold text-foreground'>统计</h2>
                </div>
                
                <div class='space-y-2'>
                  {/* 文章总数 */}
                  <div class='flex items-center gap-0 overflow-hidden rounded-md border border-purple-200 dark:border-purple-800'>
                    <div class='px-3 py-1 text-sm font-medium text-purple-700 dark:text-purple-300 bg-purple-50 dark:bg-purple-950/30 text-left'>∑ 文章</div>
                    <div class='flex items-center gap-2 px-3 py-1 bg-purple-100 dark:bg-purple-900 flex-1'>
                      <span class='text-sm font-semibold text-purple-900 dark:text-purple-100'>{totalPosts} / 100</span>
                      <div class='h-1 flex-1 max-w-32 bg-purple-200 dark:bg-purple-800 rounded-full overflow-hidden relative'>
                        <div class='h-full bg-gradient-to-r from-purple-500 to-purple-600 transition-all duration-1000 charging-animation' style={`width: ${Math.min((totalPosts / 100) * 100, 100)}%`}></div>
                      </div>
                    </div>
                  </div>
                  
                  {/* 总字数 */}
                  <div class='flex items-center gap-0 overflow-hidden rounded-md border border-blue-200 dark:border-blue-800'>
                    <div class='px-3 py-1 text-sm font-medium text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-950/30 text-left'>∑ 字数</div>
                    <div class='flex items-center gap-2 px-3 py-1 bg-blue-100 dark:bg-blue-900 flex-1'>
                      <span class='text-sm font-semibold text-blue-900 dark:text-blue-100'>
                        <span id='total-words-display'>{totalWords.toLocaleString()}</span> / 10万
                      </span>
                      <div class='h-1 flex-1 max-w-32 bg-blue-200 dark:bg-blue-800 rounded-full overflow-hidden relative'>
                        <div class='h-full bg-gradient-to-r from-blue-500 to-blue-600 transition-all duration-1000 charging-animation' style={`width: ${Math.min((totalWords / 100000) * 100, 100)}%`}></div>
                      </div>
                    </div>
                  </div>
                  
                  {/* 总浏览量 */}
                  <div class='flex items-center gap-0 overflow-hidden rounded-md border border-green-200 dark:border-green-800'>
                    <div class='px-3 py-1 text-sm font-medium text-green-700 dark:text-green-300 bg-green-50 dark:bg-green-950/30 text-left'>∑ 浏览</div>
                    <div class='flex items-center gap-2 px-3 py-1 bg-green-100 dark:bg-green-900 flex-1'>
                      <span class='text-sm font-semibold text-green-900 dark:text-green-100'>
                        <span id='total-views-display'>-</span> / 100万
                      </span>
                      <div class='h-1 flex-1 max-w-32 bg-green-200 dark:bg-green-800 rounded-full overflow-hidden relative'>
                        <div id='total-views-progress' class='h-full bg-gradient-to-r from-green-500 to-green-600 transition-all duration-1000 charging-animation' style='width: 0%'></div>
                      </div>
                    </div>
                  </div>
                  
                  <span id='vercount_value_site_pv' class='hidden'></span>
                </div>
              </div>
            </div>

            {/* GitHub 活动图 */}
            <div class='dashboard-card github-card group relative overflow-hidden rounded-lg border bg-background p-6 hover:border-primary/50 transition-all'>
              {/* 背景图片层 */}
              <div class='absolute inset-0 bg-gradient-to-br from-orange-500/20 via-orange-400/10 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-700 scale-110 group-hover:scale-100'></div>
              <div class='absolute top-0 right-0 w-32 h-32 bg-orange-500/5 rounded-full blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500'></div>
              <div class='relative'>
                <div class='flex items-center gap-2 mb-4'>
                  <div class='icon-mask size-8 rounded-lg bg-orange-100 dark:bg-orange-900 flex items-center justify-center transition-all duration-500'>
                    <Icon name='github' class='size-5 text-orange-600 dark:text-orange-400 transition-all duration-500' />
                  </div>
                  <h2 class='text-lg font-semibold text-foreground'>GitHub</h2>
                </div>
                <div class='rounded overflow-hidden group-hover:scale-105 transition-transform duration-300'>
                  <img
                    class='hidden w-full dark:block'
                    src='https://raw.githubusercontent.com/CatCodeMe/catcodeme/output/github-contribution-grid-snake-dark.svg'
                    alt='GitHub 贡献图 - 深色模式 - 显示 CatCodeMe 的代码贡献活动'
                    loading='lazy'
                    fetchpriority='low'
                  />
                  <img
                    class='block w-full dark:hidden'
                    src='https://raw.githubusercontent.com/CatCodeMe/catcodeme/output/github-contribution-grid-snake.svg'
                    alt='GitHub 贡献图 - 浅色模式 - 显示 CatCodeMe 的代码贡献活动'
                    loading='lazy'
                    fetchpriority='low'
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

<script is:inline>
  // Force light theme on homepage
  localStorage.setItem('theme', 'light');
  document.documentElement.dataset.theme = 'light';

  // 数字滚动动画
  function animateCounter(element, targetValue, duration = 2000) {
    const startValue = 0;
    const startTime = performance.now();
    const targetNumber = parseInt(targetValue.replace(/,/g, ''));
    
    function updateCounter(currentTime) {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);
      
      // 使用 easeOutCubic 缓动函数
      const easeOutCubic = 1 - Math.pow(1 - progress, 3);
      const currentValue = Math.floor(startValue + (targetNumber - startValue) * easeOutCubic);
      
      element.textContent = currentValue.toLocaleString();
      
      if (progress < 1) {
        requestAnimationFrame(updateCounter);
      } else {
        element.textContent = targetValue;
      }
    }
    
    requestAnimationFrame(updateCounter);
  }

  // 邮箱混淆 - 防止爬虫抓取
  function obfuscateEmail() {
    // 将邮箱地址拆分成多个部分，避免明文出现
    const parts = ['1020082805', '@', 'qq', '.', 'com'];
    const email = parts.join('');
    
    const emailLink = document.getElementById('email-link');
    if (emailLink) {
      emailLink.href = 'mailto:' + email;
    }
  }

  // 更新总浏览量显示和进度条
  function updateViewsDisplay(viewsElement, progressElement, newValue) {
    if (viewsElement && progressElement && newValue && newValue !== '-') {
      const views = parseInt(newValue.replace(/,/g, ''));
      viewsElement.textContent = views.toLocaleString();
      
      // 更新进度条
      const percentage = Math.min((views / 1000000) * 100, 100);
      progressElement.style.width = percentage + '%';
    }
  }

  // 页面加载后启动动画
  document.addEventListener('DOMContentLoaded', () => {
    // 总字数滚动动画
    const wordsDisplayElement = document.getElementById('total-words-display');
    if (wordsDisplayElement) {
      const targetValue = wordsDisplayElement.textContent;
      wordsDisplayElement.textContent = '0';
      setTimeout(() => {
        animateCounter(wordsDisplayElement, targetValue, 2000);
      }, 500);
    }
    
    // 监听总浏览量更新
    const viewsDisplayElement = document.getElementById('total-views-display');
    const viewsProgressElement = document.getElementById('total-views-progress');
    const vercountElement = document.getElementById('vercount_value_site_pv');
    
    if (viewsDisplayElement && viewsProgressElement && vercountElement) {
      // 使用 MutationObserver 监听 vercount 元素的变化
      const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          if (mutation.type === 'childList' || mutation.type === 'characterData') {
            const newValue = vercountElement.textContent;
            updateViewsDisplay(viewsDisplayElement, viewsProgressElement, newValue);
          }
        });
      });
      
      observer.observe(vercountElement, {
        childList: true,
        characterData: true,
        subtree: true
      });
      
      // 立即检查一次（如果值已经加载）
      const currentValue = vercountElement.textContent;
      updateViewsDisplay(viewsDisplayElement, viewsProgressElement, currentValue);
    }
    
    // 初始化邮箱链接
    obfuscateEmail();
  });
</script>
  </main>

<style>
  /* 卡片渐入动画 */
  .dashboard-card {
    animation: fadeInUp 0.6s ease-out;
    animation-fill-mode: both;
  }

  .dashboard-card:nth-child(1) { animation-delay: 0.1s; }
  .dashboard-card:nth-child(2) { animation-delay: 0.2s; }
  .dashboard-card:nth-child(3) { animation-delay: 0.3s; }
  .dashboard-card:nth-child(4) { animation-delay: 0.4s; }
  .dashboard-card:nth-child(5) { animation-delay: 0.5s; }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* 文章列表项动画 */
  .post-item {
    animation: slideInLeft 0.4s ease-out;
    animation-fill-mode: both;
  }

  .post-item:nth-child(1) { animation-delay: 0.5s; }
  .post-item:nth-child(2) { animation-delay: 0.6s; }
  .post-item:nth-child(3) { animation-delay: 0.7s; }
  .post-item:nth-child(4) { animation-delay: 0.8s; }
  .post-item:nth-child(5) { animation-delay: 0.9s; }

  @keyframes slideInLeft {
    from {
      opacity: 0;
      transform: translateX(-10px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* 充电动画效果 */
  .charging-animation {
    position: relative;
    overflow: hidden;
    animation: pulse 2s ease-in-out infinite;
  }

  .charging-animation::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.3),
      transparent
    );
    animation: charging 2s ease-in-out infinite;
  }

  @keyframes charging {
    0% {
      left: -100%;
    }
    50% {
      left: 100%;
    }
    100% {
      left: 100%;
    }
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.9;
    }
  }


  /* 卡片悬停效果 */
  .reading-card:hover {
    box-shadow: 0 10px 30px -10px rgba(168, 85, 247, 0.2);
    transform: translateY(-2px);
  }

  .posts-card:hover {
    box-shadow: 0 10px 30px -10px rgba(59, 130, 246, 0.2);
    transform: translateY(-2px);
  }

  .avatar-card:hover {
    box-shadow: 0 10px 30px -10px rgba(236, 72, 153, 0.2);
    transform: translateY(-2px);
  }

  .stats-card:hover {
    box-shadow: 0 10px 30px -10px rgba(59, 130, 246, 0.2);
    transform: translateY(-2px);
  }

  .github-card:hover {
    box-shadow: 0 10px 30px -10px rgba(249, 115, 22, 0.2);
    transform: translateY(-2px);
  }

  /* 确保左右两列高度对齐 */
  @media (min-width: 1024px) {
    .grid > div:nth-child(2) {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: stretch;
    }
    
    .grid > div:nth-child(2) > div {
      flex: 1;
    }
  }

  /* 进度条动画 */
  .progress-bar {
    animation: progressGlow 2s ease-in-out infinite;
  }

  @keyframes progressGlow {
    0%, 100% {
      box-shadow: 0 0 5px rgba(168, 85, 247, 0.5);
    }
    50% {
      box-shadow: 0 0 15px rgba(168, 85, 247, 0.8);
    }
  }

  /* 图标遮罩动画效果 */
  .icon-mask {
    position: relative;
    overflow: hidden;
  }

  .icon-mask::before {
    content: '';
    position: absolute;
    inset: 0;
    background: inherit;
    opacity: 1;
    transition: all 0.5s ease;
  }

  .icon-mask svg {
    position: relative;
    z-index: 1;
  }

  /* 悬停时图标遮罩淡出 */
  .group:hover .icon-mask::before {
    opacity: 0;
    transform: scale(1.5);
  }

  /* 图标微动画 - 持续浮动 */
  .icon-mask svg {
    animation: iconFloat 3s ease-in-out infinite;
  }

  @keyframes iconFloat {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-3px);
    }
  }

</style>
</PageLayout>
