---
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import { Icon } from '@/custom/components/user'
import { Image } from 'astro:assets'
import bookshelfData from '../../public/bookshelf.json'
import avatarImage from '@/assets/avatar_2.png'
import config from '@/site-config'

const MAX_POSTS = 6
const allPosts = await getBlogCollection()
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS)

const totalPosts = allPosts.length
let totalWords = 0
for (const post of allPosts) {
  if (post.body) {
    const text = post.body
      .replace(/<[^>]*>/g, '')
      .replace(/\[([^\]]*)\]\([^\)]*\)/g, '$1')
      .replace(/!\[([^\]]*)\]\([^\)]*\)/g, '')
      .replace(/[#*`_~]/g, '')
      .replace(/\n/g, ' ')
    const chineseChars = text.match(/[\u4e00-\u9fa5]/g) || []
    const englishWords = text.match(/[a-zA-Z]+/g) || []
    totalWords += chineseChars.length + englishWords.length
  }
}

const currentReading = bookshelfData.find((item: any) => item.status === 'reading')
---

<PageLayout meta={{ title: 'Home' }}>
  <main class='timeline-main'>
    <div class='timeline-container'>
      {/* 顶部信息区 */}
      <header class='timeline-header'>
        <div class='header-left'>
          <h1 class='header-title'>{config.title}</h1>
          <p class='header-desc'>{config.description}</p>
        </div>
        <div class='header-right'>
          <div class='header-stats'>
            <div class='stat'>
              <span class='stat-num'>{totalPosts}</span>
              <span class='stat-label'>文章</span>
            </div>
            <div class='stat'>
              <span class='stat-num' id='total-words-display'>{totalWords.toLocaleString()}</span>
              <span class='stat-label'>字数</span>
            </div>
            <div class='stat'>
              <span class='stat-num' id='total-views-display'>-</span>
              <span class='stat-label'>浏览</span>
            </div>
          </div>
          <div class='header-meta'>
            <span class='meta-item'>北京</span>
            <span class='meta-item'>在线</span>
          </div>
        </div>
      </header>

      {/* 时间线主体 */}
      <div class='timeline-body'>
        {/* 左侧时间线 */}
        <div class='timeline-line'>
          <div class='timeline-start'></div>
          <div class='timeline-progress'></div>
        </div>

        {/* 右侧内容 */}
        <div class='timeline-content'>
          {/* 最近在读节点 */}
          {currentReading && (
            <div class='timeline-node'>
              <div class='node-dot'></div>
              <div class='node-content'>
                <div class='node-label'>最近在读</div>
                <h3 class='node-title'>{currentReading.title}</h3>
                {currentReading.description && (
                  <p class='node-text'>{currentReading.description}</p>
                )}
                <div class='node-footer'>
                  {currentReading.rating && (
                    <span class='node-tag'>{currentReading.rating.toFixed(1)}</span>
                  )}
                  {currentReading.progress !== undefined && (
                    <span class='node-tag'>{currentReading.progress}%</span>
                  )}
                  <a href='/shelf' class='node-link'>书架 →</a>
                </div>
              </div>
            </div>
          )}

          {/* 最新文章节点 */}
          <div class='timeline-node'>
            <div class='node-dot'></div>
            <div class='node-content'>
              <div class='node-label'>最新文章</div>
              <div class='posts-group'>
                {allPostsByDate.map((post, index) => (
                  <article class='post-node' key={post.id}>
                    <time class='post-time'>
                      {new Date(post.data.publishDate).toLocaleDateString('zh-CN', { 
                        month: 'short', 
                        day: 'numeric',
                        year: 'numeric'
                      })}
                    </time>
                    <div class='post-body'>
                      <h3 class='post-title'>
                        <a href={post.url}>{post.data.title}</a>
                      </h3>
                      {post.data.description && (
                        <p class='post-excerpt'>{post.data.description}</p>
                      )}
                    </div>
                  </article>
                ))}
              </div>
              <div class='node-footer'>
                <a href='/blog' class='node-link'>全部文章 →</a>
              </div>
            </div>
          </div>

          {/* 联系方式节点 */}
          <div class='timeline-node'>
            <div class='node-dot'></div>
            <div class='node-content'>
              <div class='node-label'>联系方式</div>
              <div class='links-group'>
                <a href='https://github.com/CatCodeMe' target='_blank' rel='noopener noreferrer' class='link-item'>
                  GitHub
                </a>
                <a href='https://twitter.com/hulj13' target='_blank' rel='noopener noreferrer' class='link-item'>
                  Twitter
                </a>
                <a href='https://bsky.app/profile/catcodeme.bsky.social' target='_blank' rel='noopener noreferrer' class='link-item'>
                  Bluesky
                </a>
                <a href='https://t.me/ccm_life' target='_blank' rel='noopener noreferrer' class='link-item'>
                  Telegram
                </a>
                <a href='/rss.xml' class='link-item'>
                  RSS
                </a>
              </div>
            </div>
          </div>

          <div class='timeline-end'></div>
        </div>
      </div>
    </div>

    <span id='vercount_value_site_pv' class='hidden'></span>

<script is:inline>
  function animateCounter(element, targetValue, duration = 2000) {
    const startValue = 0;
    const startTime = performance.now();
    const targetNumber = parseInt(targetValue.replace(/,/g, ''));
    
    function updateCounter(currentTime) {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const easeOutCubic = 1 - Math.pow(1 - progress, 3);
      const currentValue = Math.floor(startValue + (targetNumber - startValue) * easeOutCubic);
      element.textContent = currentValue.toLocaleString();
      
      if (progress < 1) {
        requestAnimationFrame(updateCounter);
      } else {
        element.textContent = targetValue;
      }
    }
    
    requestAnimationFrame(updateCounter);
  }

  function updateViewsDisplay(viewsElement, newValue, hasAnimated = false) {
    if (viewsElement && newValue && newValue !== '-') {
      const views = parseInt(newValue.replace(/,/g, ''));
      
      if (!hasAnimated) {
        viewsElement.textContent = '0';
        setTimeout(() => {
          animateCounter(viewsElement, views.toLocaleString(), 2000);
        }, 500);
      } else {
        viewsElement.textContent = views.toLocaleString();
      }
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const wordsDisplayElement = document.getElementById('total-words-display');
    if (wordsDisplayElement) {
      const targetValue = wordsDisplayElement.textContent;
      wordsDisplayElement.textContent = '0';
      setTimeout(() => {
        animateCounter(wordsDisplayElement, targetValue, 2000);
      }, 500);
    }
    
    const viewsDisplayElement = document.getElementById('total-views-display');
    const vercountElement = document.getElementById('vercount_value_site_pv');
    let hasAnimatedViews = false;
    
    if (viewsDisplayElement && vercountElement) {
      const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          if (mutation.type === 'childList' || mutation.type === 'characterData') {
            const newValue = vercountElement.textContent;
            updateViewsDisplay(viewsDisplayElement, newValue, hasAnimatedViews);
            hasAnimatedViews = true;
          }
        });
      });
      
      observer.observe(vercountElement, {
        childList: true,
        characterData: true,
        subtree: true
      });
      
      const currentValue = vercountElement.textContent;
      if (currentValue && currentValue !== '-') {
        updateViewsDisplay(viewsDisplayElement, currentValue, hasAnimatedViews);
        hasAnimatedViews = true;
      }
    }
  });
</script>

<style>
  /* 方案B：垂直时间线风格 */
  /* 确保不受 BaseLayout 包装影响 */
  .timeline-main {
    width: 100vw !important;
    max-width: 100vw !important;
    padding: 0 !important;
    margin: 0 !important;
    margin-left: calc(-50vw + 50%) !important;
    margin-right: calc(-50vw + 50%) !important;
    background: #ffffff;
  }

  .timeline-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 3rem;
  }

  @media (max-width: 768px) {
    .timeline-container {
      padding: 3rem 2rem;
    }
  }

  /* 头部区域 */
  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    margin-bottom: 4rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #e0e0e0;
  }

  @media (max-width: 1024px) {
    .timeline-header {
      flex-direction: column;
      gap: 2rem;
    }
  }

  .header-left {
    flex: 1;
  }

  .header-title {
    font-size: 2.5rem;
    font-weight: 300;
    color: #000000;
    margin: 0 0 0.75rem 0;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .header-desc {
    font-size: 1.125rem;
    color: #666666;
    margin: 0;
    line-height: 1.6;
    font-weight: 300;
  }

  .header-right {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-end;
  }

  @media (max-width: 1024px) {
    .header-right {
      align-items: flex-start;
    }
  }

  .header-stats {
    display: flex;
    gap: 2rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
  }

  @media (max-width: 1024px) {
    .stat {
      align-items: flex-start;
    }
  }

  .stat-num {
    font-size: 1.25rem;
    font-weight: 400;
    color: #000000;
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: 0.75rem;
    color: #888888;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .header-meta {
    display: flex;
    gap: 1rem;
  }

  .meta-item {
    font-size: 0.875rem;
    color: #666666;
  }

  /* 时间线主体 */
  .timeline-body {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 3rem;
    position: relative;
  }

  @media (max-width: 768px) {
    .timeline-body {
      grid-template-columns: 40px 1fr;
      gap: 2rem;
    }
  }

  /* 时间线 */
  .timeline-line {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .timeline-start {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid #000000;
    background: #ffffff;
    margin-bottom: 1rem;
  }

  .timeline-progress {
    flex: 1;
    width: 1px;
    background: #e0e0e0;
    min-height: 200px;
  }

  .timeline-end {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid #000000;
    background: #ffffff;
    margin-top: 1rem;
  }

  /* 时间线内容 */
  .timeline-content {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    padding-bottom: 2rem;
  }

  /* 时间线节点 */
  .timeline-node {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 2rem;
    position: relative;
  }

  @media (max-width: 768px) {
    .timeline-node {
      gap: 1.5rem;
    }
  }

  .node-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #000000;
    margin-top: 0.5rem;
    flex-shrink: 0;
  }

  .node-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 2rem;
  }

  .node-label {
    font-size: 0.75rem;
    color: #888888;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }

  .node-title {
    font-size: 1.5rem;
    font-weight: 400;
    color: #000000;
    margin: 0;
    line-height: 1.4;
  }

  .node-text {
    font-size: 0.9375rem;
    color: #666666;
    line-height: 1.6;
    margin: 0;
  }

  .node-footer {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .node-tag {
    font-size: 0.8125rem;
    color: #666666;
  }

  .node-link {
    font-size: 0.875rem;
    color: #000000;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .node-link:hover {
    opacity: 0.5;
  }

  /* 文章组 */
  .posts-group {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .post-node {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 2rem;
    padding: 1.5rem 0;
    border-top: 1px solid #f0f0f0;
  }

  .post-node:first-child {
    border-top: none;
    padding-top: 0;
  }

  @media (max-width: 768px) {
    .post-node {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }

  .post-time {
    font-size: 0.8125rem;
    color: #888888;
    font-variant-numeric: tabular-nums;
    align-self: start;
  }

  .post-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .post-title {
    font-size: 1.125rem;
    font-weight: 400;
    color: #000000;
    margin: 0;
    line-height: 1.4;
  }

  .post-title a {
    color: #000000;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .post-title a:hover {
    opacity: 0.5;
  }

  .post-excerpt {
    font-size: 0.9375rem;
    color: #666666;
    line-height: 1.6;
    margin: 0;
  }

  /* 链接组 */
  .links-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .link-item {
    font-size: 0.875rem;
    color: #666666;
    text-decoration: none;
    transition: color 0.2s;
  }

  .link-item:hover {
    color: #000000;
  }

  @media (max-width: 768px) {
    .header-title {
      font-size: 2rem;
    }

    .header-desc {
      font-size: 1rem;
    }

    .header-stats {
      gap: 1.5rem;
    }
  }
</style>
  </main>
</PageLayout>
