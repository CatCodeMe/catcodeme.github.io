---
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import { Icon } from '@/custom/components/user'
import { Image } from 'astro:assets'
import bookshelfData from '../../public/bookshelf.json'
import avatarImage from '@/assets/avatar_2.png'
import config from '@/site-config'

const MAX_POSTS = 6
const allPosts = await getBlogCollection()
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS)

// 统计文章总数和总字数
const totalPosts = allPosts.length
let totalWords = 0
for (const post of allPosts) {
  if (post.body) {
    const text = post.body
      .replace(/<[^>]*>/g, '')
      .replace(/\[([^\]]*)\]\([^\)]*\)/g, '$1')
      .replace(/!\[([^\]]*)\]\([^\)]*\)/g, '')
      .replace(/[#*`_~]/g, '')
      .replace(/\n/g, ' ')
    const chineseChars = text.match(/[\u4e00-\u9fa5]/g) || []
    const englishWords = text.match(/[a-zA-Z]+/g) || []
    totalWords += chineseChars.length + englishWords.length
  }
}

const currentReading = bookshelfData.find((item: any) => item.status === 'reading')

const currentDate = new Date()
const dateStr = currentDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })
const timeStr = currentDate.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' })
---

<PageLayout meta={{ title: 'Home' }} bodyClass='receipt-homepage'>
  <main class='receipt-main'>
    <div class='receipt-container'>
      <!-- 顶部锯齿 -->
      <div class='receipt-top-teeth'></div>
      
      <!-- 收银纸内容 -->
      <div class='receipt-content'>
        <!-- 商店信息头部 -->
        <header class='receipt-header-section'>
          <div class='receipt-store-name'>{config.title}</div>
          <div class='receipt-store-subtitle'>{config.description}</div>
          <div class='receipt-divider-line'></div>
          <div class='receipt-store-info'>
            <div class='receipt-info-row'>
              <span class='receipt-info-label'>日期:</span>
              <span class='receipt-info-value'>{dateStr}</span>
            </div>
            <div class='receipt-info-row'>
              <span class='receipt-info-label'>时间:</span>
              <span class='receipt-info-value'>{timeStr}</span>
            </div>
            <div class='receipt-info-row'>
              <span class='receipt-info-label'>位置:</span>
              <span class='receipt-info-value'>北京</span>
            </div>
          </div>
          <div class='receipt-divider-line'></div>
        </header>

        <!-- 主要内容区域 -->
        <div class='receipt-body-section'>
          <!-- 左侧主要内容 -->
          <div class='receipt-main-column'>
            {/* 最近在读 */}
            {currentReading && (
              <section class='receipt-section'>
                <div class='receipt-section-header'>
                  <Icon name='shelf' class='receipt-section-icon' />
                  <span class='receipt-section-title'>最近在读</span>
                </div>
                <div class='receipt-divider-dashed'></div>
                <div class='receipt-section-content'>
                  <div class='receipt-item-row'>
                    <span class='receipt-item-label'>书名</span>
                    <span class='receipt-item-value'>{currentReading.title}</span>
                  </div>
                  {currentReading.description && (
                    <>
                      <div class='receipt-divider-dashed'></div>
                      <div class='receipt-item-row'>
                        <span class='receipt-item-label'>简介</span>
                        <span class='receipt-item-value receipt-item-description'>{currentReading.description}</span>
                      </div>
                    </>
                  )}
                  {(currentReading.rating || currentReading.progress !== undefined) && (
                    <>
                      <div class='receipt-divider-dashed'></div>
                      <div class='receipt-item-row'>
                        <span class='receipt-item-label'>状态</span>
                        <span class='receipt-item-value'>
                          {currentReading.rating && `评分: ${currentReading.rating.toFixed(1)} `}
                          {currentReading.progress !== undefined && `进度: ${currentReading.progress}%`}
                        </span>
                      </div>
                    </>
                  )}
                  {currentReading.tags && currentReading.tags.length > 0 && (
                    <>
                      <div class='receipt-divider-dashed'></div>
                      <div class='receipt-item-row'>
                        <span class='receipt-item-label'>标签</span>
                        <span class='receipt-item-value receipt-item-tags'>
                          {currentReading.tags.slice(0, 4).join(' / ')}
                        </span>
                      </div>
                    </>
                  )}
                  <div class='receipt-divider-dashed'></div>
                  <div class='receipt-link-row'>
                    <a href='/shelf' class='receipt-link'>前往书架 →</a>
                  </div>
                </div>
              </section>
            )}

            {/* 最新文章 */}
            <section class='receipt-section'>
              <div class='receipt-section-header'>
                <Icon name='document' class='receipt-section-icon' />
                <span class='receipt-section-title'>最新文章</span>
              </div>
              <div class='receipt-divider-dashed'></div>
              <div class='receipt-section-content'>
                {allPostsByDate.map((post, index) => (
                  <div key={post.id}>
                    <div class='receipt-post-item'>
                      <div class='receipt-post-row'>
                        <span class='receipt-post-date'>{new Date(post.data.publishDate).toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' })}</span>
                        <a href={post.url} class='receipt-post-title'>{post.data.title}</a>
                      </div>
                      {post.data.description && (
                        <div class='receipt-post-description'>{post.data.description}</div>
                      )}
                    </div>
                    {index < allPostsByDate.length - 1 && <div class='receipt-divider-dotted'></div>}
                  </div>
                ))}
                <div class='receipt-divider-dashed'></div>
                <div class='receipt-link-row'>
                  <a href='/blog' class='receipt-link'>查看更多 →</a>
                </div>
              </div>
            </section>
          </div>

          <!-- 右侧统计和联系 -->
          <div class='receipt-sidebar-column'>
            {/* 头像卡片 */}
            <section class='receipt-section receipt-avatar-section'>
              <div class='receipt-avatar-wrapper'>
                <Image 
                  src={avatarImage} 
                  alt='CatCodeMe 头像' 
                  class='receipt-avatar-image'
                  loading='eager'
                  fetchpriority='high'
                />
              </div>
              <div class='receipt-divider-dashed'></div>
              <div class='receipt-avatar-info'>
                <div class='receipt-item-row'>
                  <span class='receipt-item-label'>姓名</span>
                  <span class='receipt-item-value'>{config.title}</span>
                </div>
                <div class='receipt-divider-dashed'></div>
                <div class='receipt-item-row'>
                  <span class='receipt-item-label'>状态</span>
                  <span class='receipt-item-value'>
                    <span class='receipt-status-dot'></span>
                    {config.description}
                  </span>
                </div>
              </div>
            </section>

            {/* 统计卡片 */}
            <section class='receipt-section receipt-stats-section'>
              <div class='receipt-section-header'>
                <Icon name='content-statistic' class='receipt-section-icon' />
                <span class='receipt-section-title'>站点统计</span>
              </div>
              <div class='receipt-divider-dashed'></div>
              <div class='receipt-section-content'>
                <div class='receipt-item-row'>
                  <span class='receipt-item-label'>文章总数</span>
                  <span class='receipt-item-value receipt-number'>{String(totalPosts).padStart(6, ' ')}</span>
                </div>
                <div class='receipt-divider-dashed'></div>
                <div class='receipt-item-row'>
                  <span class='receipt-item-label'>总字数</span>
                  <span class='receipt-item-value receipt-number' id='total-words-display'>{String(totalWords).padStart(12, ' ')}</span>
                </div>
                <div class='receipt-divider-dashed'></div>
                <div class='receipt-item-row'>
                  <span class='receipt-item-label'>总浏览量</span>
                  <span class='receipt-item-value receipt-number' id='total-views-display'>            -</span>
                </div>
                <div class='receipt-divider-dashed'></div>
                <div class='receipt-item-row'>
                  <span class='receipt-item-label'>最后更新</span>
                  <span class='receipt-item-value receipt-date-value'>{dateStr}</span>
                </div>
              </div>
            </section>

            {/* 联系方式 */}
            <section class='receipt-section receipt-social-section'>
              <div class='receipt-section-header'>
                <Icon name='link' class='receipt-section-icon' />
                <span class='receipt-section-title'>联系方式</span>
              </div>
              <div class='receipt-divider-dashed'></div>
              <div class='receipt-social-links'>
                <a href='https://github.com/CatCodeMe' target='_blank' rel='noopener noreferrer' class='receipt-social-link' aria-label='访问 GitHub 主页'>
                  <Icon name='github' class='receipt-social-icon' />
                  <span>GitHub</span>
                </a>
                <a href='https://twitter.com/hulj13' target='_blank' rel='noopener noreferrer' class='receipt-social-link' aria-label='访问 Twitter 主页'>
                  <Icon name='x' class='receipt-social-icon' />
                  <span>Twitter</span>
                </a>
                <a href='https://bsky.app/profile/catcodeme.bsky.social' target='_blank' rel='noopener noreferrer' class='receipt-social-link' aria-label='访问 Bluesky 主页'>
                  <Icon name='bluesky' class='receipt-social-icon' />
                  <span>Bluesky</span>
                </a>
                <a href='https://t.me/ccm_life' target='_blank' rel='noopener noreferrer' class='receipt-social-link' aria-label='访问 Telegram 频道'>
                  <Icon name='telegram' class='receipt-social-icon' />
                  <span>Telegram</span>
                </a>
                <a href='/rss.xml' class='receipt-social-link' aria-label='订阅 RSS'>
                  <Icon name='rss' class='receipt-social-icon' />
                  <span>RSS</span>
                </a>
              </div>
            </section>
          </div>
        </div>

        <!-- 底部信息 -->
        <footer class='receipt-footer-section'>
          <div class='receipt-divider-line'></div>
          <div class='receipt-thanks'>感谢您的访问</div>
          <div class='receipt-divider-line'></div>
        </footer>
      </div>

      <!-- 底部锯齿 -->
      <div class='receipt-bottom-teeth'></div>
      
      <span id='vercount_value_site_pv' class='hidden'></span>
    </div>

<script is:inline>
  function animateCounter(element, targetValue, duration = 2000) {
    const startValue = 0;
    const startTime = performance.now();
    const targetNumber = parseInt(targetValue.replace(/,/g, '').replace(/\s/g, ''));
    
    function updateCounter(currentTime) {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const easeOutCubic = 1 - Math.pow(1 - progress, 3);
      const currentValue = Math.floor(startValue + (targetNumber - startValue) * easeOutCubic);
      const formatted = currentValue.toLocaleString().padStart(12, ' ');
      element.textContent = formatted;
      
      if (progress < 1) {
        requestAnimationFrame(updateCounter);
      } else {
        element.textContent = targetValue.replace(/,/g, '').padStart(12, ' ');
      }
    }
    
    requestAnimationFrame(updateCounter);
  }

  function updateViewsDisplay(viewsElement, newValue, hasAnimated = false) {
    if (viewsElement && newValue && newValue !== '-') {
      const views = parseInt(newValue.replace(/,/g, ''));
      
      if (!hasAnimated) {
        viewsElement.textContent = '           0';
        setTimeout(() => {
          const formatted = views.toLocaleString().padStart(12, ' ');
          animateCounter(viewsElement, formatted, 2000);
        }, 500);
      } else {
        viewsElement.textContent = views.toLocaleString().padStart(12, ' ');
      }
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const wordsDisplayElement = document.getElementById('total-words-display');
    if (wordsDisplayElement) {
      const targetValue = wordsDisplayElement.textContent.replace(/\s/g, '');
      wordsDisplayElement.textContent = '           0';
      setTimeout(() => {
        const formatted = targetValue.replace(/,/g, '').padStart(12, ' ');
        animateCounter(wordsDisplayElement, formatted, 2000);
      }, 500);
    }
    
    const viewsDisplayElement = document.getElementById('total-views-display');
    const vercountElement = document.getElementById('vercount_value_site_pv');
    let hasAnimatedViews = false;
    
    if (viewsDisplayElement && vercountElement) {
      const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          if (mutation.type === 'childList' || mutation.type === 'characterData') {
            const newValue = vercountElement.textContent;
            updateViewsDisplay(viewsDisplayElement, newValue, hasAnimatedViews);
            hasAnimatedViews = true;
          }
        });
      });
      
      observer.observe(vercountElement, {
        childList: true,
        characterData: true,
        subtree: true
      });
      
      const currentValue = vercountElement.textContent;
      if (currentValue && currentValue !== '-') {
        updateViewsDisplay(viewsDisplayElement, currentValue, hasAnimatedViews);
        hasAnimatedViews = true;
      }
    }
  });
</script>

