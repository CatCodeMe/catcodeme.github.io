---
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import { Icon, Button } from '@/custom/components/user';
import type { IconName } from 'packages/pure/libs/icons';
import bookshelfData from 'public/bookshelf.json';

import PageLayout from '@/layouts/BaseLayout.astro';
import Banner from '@/components/banner/Banner.astro';
import bannerImage from '@/assets/shelf/desk1.png';
import testCoverImage from '@/assets/cats/3-1.png';

// 封面图片映射
const coverImageMap: Record<string, any> = {
  '/src/assets/cats/3-1.png': testCoverImage
};

const meta = {
  title: '书架',
  description: '我的书架和文章收藏'
}

const allPosts = await getCollection('blog');
const postsMap = new Map(allPosts.map((post) => [post.data.slug, { title: post.data.title }]));

type ShelfItem = {
  title: string;
  type: "book" | "paper" | "article";
  status: "read" | "reading" | "to-read";
  description?: string;
  rating?: number;
  identifier?: string;
  sourceUrl?: string;
  links?: string[];
  tags?: string[];
  coverImage?: string;
  progress?: number;
};

const typedBookshelfData = bookshelfData as ShelfItem[];

// 统计信息
const stats = {
  total: typedBookshelfData.length,
  toRead: typedBookshelfData.filter(item => item.status === 'to-read').length,
  reading: typedBookshelfData.filter(item => item.status === 'reading').length,
  read: typedBookshelfData.filter(item => item.status === 'read').length
};

const statusLabels: { [key: string]: { label: string; icon: IconName; color: string } } = {
  'to-read': { label: '想读', icon: 'list', color: 'blue' },
  'reading': { label: '在读', icon: 'time', color: 'purple' },
  'read': { label: '已读', icon: 'package', color: 'green' }
};

// 标签色卡
const tagColors = [
  'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200 border-blue-200 dark:border-blue-700',
  'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200 border-green-200 dark:border-green-700',
  'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200 border-yellow-200 dark:border-yellow-700',
  'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200 border-red-200 dark:border-red-700',
  'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200 border-purple-200 dark:border-purple-700',
  'bg-pink-100 text-pink-800 dark:bg-pink-900 dark:text-pink-200 border-pink-200 dark:border-pink-700',
  'bg-indigo-100 text-indigo-800 dark:bg-indigo-900 dark:text-indigo-200 border-indigo-200 dark:border-indigo-700',
  'bg-teal-100 text-teal-800 dark:bg-teal-900 dark:text-teal-200 border-teal-200 dark:border-teal-700',
];

const getTagColor = (index: number) => {
  return tagColors[index % tagColors.length];
};

---

<PageLayout {meta}>
  <main class='mt-6 lg:mt-10'>
    <Banner image={bannerImage} imageAlt="书架横幅">
      <div class="flex items-center gap-3">
        <Icon name="book" class="size-8" />
        <h1 class="text-4xl font-bold">{meta.title}</h1>
      </div>
      <p class="border-l-2 border-border pl-3 text-lg text-muted-foreground mt-2">{meta.description}</p>
    </Banner>

    <div id='content' class='animate mt-8'>
      <!-- 统计信息 -->
      <div class="mb-6 grid grid-cols-2 gap-4 md:grid-cols-4">
        <div 
          class="stat-card relative rounded-lg border bg-background p-4 text-center cursor-pointer transition-all hover:border-primary hover:shadow-md"
          data-filter="all"
        >
          <div class="absolute top-2 right-2 text-xs font-medium text-foreground opacity-60">总计</div>
          <div class="text-3xl font-bold text-foreground mt-2">{stats.total}</div>
        </div>
        <div 
          class="stat-card relative rounded-lg border bg-background p-4 text-center cursor-pointer transition-all hover:border-blue-500 hover:shadow-md"
          data-filter="to-read"
        >
          <div class="absolute top-2 right-2 text-xs font-medium text-blue-600 opacity-60">想读</div>
          <div class="text-3xl font-bold text-blue-600 mt-2">{stats.toRead}</div>
        </div>
        <div 
          class="stat-card relative rounded-lg border bg-background p-4 text-center cursor-pointer transition-all hover:border-purple-500 hover:shadow-md"
          data-filter="reading"
        >
          <div class="absolute top-2 right-2 text-xs font-medium text-purple-600 opacity-60">在读</div>
          <div class="text-3xl font-bold text-purple-600 mt-2">{stats.reading}</div>
        </div>
        <div 
          class="stat-card relative rounded-lg border bg-background p-4 text-center cursor-pointer transition-all hover:border-green-500 hover:shadow-md"
          data-filter="read"
        >
          <div class="absolute top-2 right-2 text-xs font-medium text-green-600 opacity-60">已读</div>
          <div class="text-3xl font-bold text-green-600 mt-2">{stats.read}</div>
        </div>
      </div>

      <!-- 搜索框 -->
      <div class="mb-6">
        <div class="relative">
          <Icon name="search" class="absolute left-3 top-1/2 -translate-y-1/2 size-5 text-muted-foreground" />
          <input
            type="text"
            id="search-input"
            placeholder="搜索书名、标签或描述..."
            class="w-full rounded-lg border bg-background pl-10 pr-4 py-2.5 text-sm focus:border-primary focus:outline-none"
          />
        </div>
      </div>

      <!-- 书籍列表 -->
      <div class="space-y-3">
        {typedBookshelfData.map((item) => {
          const statusInfo = statusLabels[item.status];
          const linkedPosts = item.links?.map(link => {
            // 拼接 host，添加 blog/ 前缀
            const href = `/blog/${link}`;
            return {
              href,
              title: postsMap.get(link)?.title || link
            };
          }) || [];
          
          return (
            <div
              class="book-row group relative flex flex-col overflow-hidden rounded-lg border bg-background transition-all duration-300 hover:border-primary/50 hover:shadow-lg hover:bg-muted/30"
              data-title={item.title.toLowerCase()}
              data-description={(item.description || '').toLowerCase()}
              data-tags={(item.tags || []).join(' ').toLowerCase()}
              data-status={item.status}
              data-type={item.type}
            >
              {/* 封面图片作为背景 */}
              {item.coverImage && coverImageMap[item.coverImage] && (
                <Image
                  src={coverImageMap[item.coverImage]}
                  alt={item.title}
                  class="cover-image absolute end-0 top-0 z-0 h-full w-3/5 rounded-lg object-cover opacity-30 transition-opacity duration-300 group-hover:opacity-50"
                  loading="lazy"
                />
              )}

              {/* 内容区域 */}
              <div class="relative z-10 flex flex-col gap-3 p-5">
                {/* 标题和右上角信息 */}
                <div class="flex items-start justify-between gap-4">
                  <div class="flex-1 min-w-0">
                    <h3 class="text-lg font-semibold text-foreground group-hover:text-primary transition-colors break-words">
                      {item.title}
                    </h3>
                  </div>
                  <div class="flex items-center gap-2 flex-shrink-0">
                    {item.rating && (
                      <div class="hidden sm:flex items-center gap-1 rounded-md bg-muted px-2 py-1 text-xs font-medium">
                        <Icon name="star" class="size-3.5 text-yellow-400" />
                        <span>{item.rating.toFixed(1)}</span>
                      </div>
                    )}
                    {item.identifier && (
                      <div class="hidden sm:flex items-center gap-1 rounded-md bg-muted px-2 py-1 text-xs font-medium">
                        <Icon name="hashtag" class="size-3.5" />
                        <span class="text-xs">{item.identifier}</span>
                      </div>
                    )}
                    {/* 状态显示在右上角，包含进度 */}
                    <div class={`hidden sm:flex items-center gap-1 rounded-md px-2 py-1 text-xs font-medium bg-${statusInfo.color}-100 text-${statusInfo.color}-800 dark:bg-${statusInfo.color}-900 dark:text-${statusInfo.color}-200`}>
                      <Icon name={statusInfo.icon} class={`size-3.5`} />
                      <span>
                        {statusInfo.label}
                        {item.progress !== undefined && ` / ${item.progress}%`}
                      </span>
                    </div>
                  </div>
                </div>

                {/* 移动端显示状态和评分 */}
                <div class="flex items-center gap-2 sm:hidden">
                  <div class={`flex items-center gap-1 rounded-md px-2 py-1 text-xs font-medium bg-${statusInfo.color}-100 text-${statusInfo.color}-800 dark:bg-${statusInfo.color}-900 dark:text-${statusInfo.color}-200`}>
                    <Icon name={statusInfo.icon} class={`size-3.5`} />
                    <span>
                      {statusInfo.label}
                      {item.progress !== undefined && ` / ${item.progress}%`}
                    </span>
                  </div>
                  {item.rating && (
                    <div class="flex items-center gap-1 rounded-md bg-muted px-2 py-1 text-xs font-medium">
                      <Icon name="star" class="size-3.5 text-yellow-400" />
                      <span>{item.rating.toFixed(1)}</span>
                    </div>
                  )}
                  {item.identifier && (
                    <div class="flex items-center gap-1 rounded-md bg-muted px-2 py-1 text-xs font-medium">
                      <Icon name="hashtag" class="size-3.5" />
                      <span class="text-xs">{item.identifier}</span>
                    </div>
                  )}
                </div>

                {/* 描述 */}
                {item.description && (
                  <div class="flex items-start gap-2">
                    <Icon name="document" class="size-4 text-muted-foreground mt-0.5 flex-shrink-0" />
                    <p class="text-sm text-muted-foreground line-clamp-2 flex-1">
                      {item.description}
                    </p>
                  </div>
                )}

                {/* 标签 */}
                {item.tags && item.tags.length > 0 && (
                  <div class="flex items-start gap-2">
                    <Icon name="hashtag" class="size-4 text-muted-foreground mt-0.5 flex-shrink-0" />
                    <div class="flex flex-wrap gap-1.5 flex-1">
                      {item.tags.map((tag, tagIndex) => (
                        <Button 
                          title={tag} 
                          variant="button" 
                          class={`rounded-md border ${getTagColor(tagIndex)}`}
                        />
                      ))}
                    </div>
                  </div>
                )}

                {/* 相关笔记 */}
                {linkedPosts.length > 0 && (
                  <div class="flex items-start gap-2">
                    <Icon name="link" class="size-4 text-muted-foreground mt-0.5 flex-shrink-0" />
                    <div class="flex items-center gap-2 text-sm flex-1 flex-wrap">
                      <span class="text-muted-foreground">相关笔记:</span>
                      {linkedPosts.map((post, idx) => (
                        <>
                          <a
                            href={post.href}
                            class="text-primary hover:underline hover:text-primary/80 transition-colors"
                          >
                            {post.title}
                          </a>
                          {idx < linkedPosts.length - 1 && <span class="text-muted-foreground">·</span>}
                        </>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </main>
</PageLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const bookRows = document.querySelectorAll('.book-row');
    const statCards = document.querySelectorAll('.stat-card');
    
    let currentFilter = 'all';

    // 搜索功能
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
        filterBooks(query, currentFilter);
      });
    }

    // 统计卡片点击过滤
    statCards.forEach((card) => {
      card.addEventListener('click', () => {
        const filter = card.getAttribute('data-filter');
        if (filter) {
          currentFilter = filter;
          const query = searchInput?.value.toLowerCase().trim() || '';
          filterBooks(query, currentFilter);
          
          // 更新统计卡片样式
          statCards.forEach((c) => {
            c.classList.remove('border-primary', 'border-blue-500', 'border-purple-500', 'border-green-500', 'bg-muted/30');
          });
          if (filter === 'all') {
            card.classList.add('border-primary', 'bg-muted/30');
          } else if (filter === 'to-read') {
            card.classList.add('border-blue-500', 'bg-muted/30');
          } else if (filter === 'reading') {
            card.classList.add('border-purple-500', 'bg-muted/30');
          } else if (filter === 'read') {
            card.classList.add('border-green-500', 'bg-muted/30');
          }
        }
      });
    });

    function filterBooks(query: string, filter: string) {
      bookRows.forEach((row) => {
        const title = row.getAttribute('data-title') || '';
        const description = row.getAttribute('data-description') || '';
        const tags = row.getAttribute('data-tags') || '';
        const status = row.getAttribute('data-status') || '';

        const matchesQuery = !query || 
          title.includes(query) || 
          description.includes(query) || 
          tags.includes(query);

        const matchesFilter = filter === 'all' || status === filter;

        const matches = matchesQuery && matchesFilter;
        (row as HTMLElement).style.display = matches ? 'block' : 'none';
      });
    }
  });
</script>

<style>
  .cover-image {
    mask-image: linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
    -webkit-mask-image: linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
  }

  @media (max-width: 768px) {
    .cover-image {
      width: 100%;
      height: 40%;
      top: auto;
      bottom: 0;
      border-radius: 0.5rem;
      mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
      -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
    }
  }
</style>
