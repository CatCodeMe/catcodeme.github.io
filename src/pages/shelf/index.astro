---
import { getCollection } from 'astro:content'
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import { Icon } from '@/custom/components/user';
import type { IconName } from 'packages/pure/libs/icons';
import bookshelfData from 'public/bookshelf.json';

import PageLayout from '@/layouts/BaseLayout.astro';
import Banner from '@/components/banner/Banner.astro';
import bannerImage from '@/assets/shelf/desk1.png';

// 动态加载所有可能的封面图片
const coverImagesGlob = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpeg,jpg,png,gif,webp,svg}',
  { eager: false }
);

// 根据路径获取图片的辅助函数
async function getCoverImage(imagePath: string | undefined): Promise<ImageMetadata | undefined> {
  if (!imagePath) return undefined;
  
  // 确保路径格式正确（以 /src/ 开头）
  const normalizedPath = imagePath.startsWith('/src/') ? imagePath : `/src/${imagePath}`;
  
  const imageLoader = coverImagesGlob[normalizedPath];
  if (imageLoader) {
    return (await imageLoader()).default;
  }
  
  return undefined;
}

const meta = {
  title: '书架',
  description: '我的书架和文章收藏'
}

const allPosts = await getCollection('blog');
const postsMap = new Map(allPosts.map((post) => [post.data.slug, { title: post.data.title }]));

type ShelfItem = {
  title: string;
  type: "book" | "paper" | "article";
  status: "read" | "reading" | "to-read";
  description?: string;
  rating?: number;
  identifier?: string;
  sourceUrl?: string;
  links?: string[];
  tags?: string[];
  coverImage?: string;
  progress?: number;
  order?: number;
  startDate?: string;
  endDate?: string;
};

// 排序：优先按 startDate，如果没有则按 order，最后按添加顺序
const typedBookshelfData = (bookshelfData as ShelfItem[]).sort((a, b) => {
  // 如果都有 startDate，按 startDate 排序（升序）
  if (a.startDate && b.startDate) {
    return new Date(a.startDate).getTime() - new Date(b.startDate).getTime();
  }
  // 如果只有 a 有 startDate，a 排在前面
  if (a.startDate && !b.startDate) return -1;
  // 如果只有 b 有 startDate，b 排在前面
  if (!a.startDate && b.startDate) return 1;
  // 如果都有 order，按 order 排序
  if (a.order !== undefined && b.order !== undefined) {
    return a.order - b.order;
  }
  // 如果只有 a 有 order，a 排在前面
  if (a.order !== undefined && b.order === undefined) return -1;
  // 如果只有 b 有 order，b 排在前面
  if (a.order === undefined && b.order !== undefined) return 1;
  // 默认保持原顺序
  return 0;
});

// 统计信息
const stats = {
  total: typedBookshelfData.length,
  toRead: typedBookshelfData.filter(item => item.status === 'to-read').length,
  reading: typedBookshelfData.filter(item => item.status === 'reading').length,
  read: typedBookshelfData.filter(item => item.status === 'read').length
};

const statusLabels: { [key: string]: { label: string; icon: IconName; color: string } } = {
  'to-read': { label: '想读', icon: 'list', color: 'blue' },
  'reading': { label: '在读', icon: 'time', color: 'purple' },
  'read': { label: '已读', icon: 'package', color: 'green' }
};

// 标签色卡
const tagColors = [
  'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200 border-blue-200 dark:border-blue-700',
  'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200 border-green-200 dark:border-green-700',
  'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200 border-yellow-200 dark:border-yellow-700',
  'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200 border-red-200 dark:border-red-700',
  'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200 border-purple-200 dark:border-purple-700',
  'bg-pink-100 text-pink-800 dark:bg-pink-900 dark:text-pink-200 border-pink-200 dark:border-pink-700',
  'bg-indigo-100 text-indigo-800 dark:bg-indigo-900 dark:text-indigo-200 border-indigo-200 dark:border-indigo-700',
  'bg-teal-100 text-teal-800 dark:bg-teal-900 dark:text-teal-200 border-teal-200 dark:border-teal-700',
];

---

<PageLayout {meta}>
  <main class='mt-6 lg:mt-10'>
    <Banner image={bannerImage} imageAlt="书架横幅">
      <div class="flex items-center gap-3">
        <Icon name="book" class="size-8" />
        <h1 class="text-4xl font-bold">{meta.title}</h1>
      </div>
      <p class="border-l-2 border-border pl-3 text-lg text-muted-foreground mt-2">{meta.description}</p>
    </Banner>

    <div id='content' class='animate mt-8'>
      <!-- 统计信息 -->
      <div class="mb-6 grid grid-cols-2 gap-4 md:grid-cols-4">
        <div 
          class="stat-card relative rounded-lg border bg-background p-4 text-center cursor-pointer transition-all hover:border-primary hover:shadow-md"
          data-filter="all"
        >
          <div class="absolute top-2 right-2 text-xs font-medium text-foreground opacity-60">总计</div>
          <div class="text-3xl font-bold text-foreground mt-2">{stats.total}</div>
        </div>
        <div 
          class="stat-card relative rounded-lg border bg-background p-4 text-center cursor-pointer transition-all hover:border-blue-500 hover:shadow-md"
          data-filter="to-read"
        >
          <div class="absolute top-2 right-2 text-xs font-medium text-blue-600 opacity-60">想读</div>
          <div class="text-3xl font-bold text-blue-600 mt-2">{stats.toRead}</div>
        </div>
        <div 
          class="stat-card relative rounded-lg border bg-background p-4 text-center cursor-pointer transition-all hover:border-purple-500 hover:shadow-md"
          data-filter="reading"
        >
          <div class="absolute top-2 right-2 text-xs font-medium text-purple-600 opacity-60">在读</div>
          <div class="text-3xl font-bold text-purple-600 mt-2">{stats.reading}</div>
        </div>
        <div 
          class="stat-card relative rounded-lg border bg-background p-4 text-center cursor-pointer transition-all hover:border-green-500 hover:shadow-md"
          data-filter="read"
        >
          <div class="absolute top-2 right-2 text-xs font-medium text-green-600 opacity-60">已读</div>
          <div class="text-3xl font-bold text-green-600 mt-2">{stats.read}</div>
        </div>
      </div>

      <!-- 书籍列表 -->
      <div class="space-y-3">
        {await Promise.all(typedBookshelfData.map(async (item) => {
          const statusInfo = statusLabels[item.status];
          const linkedPosts = item.links?.map(link => {
            // 拼接 host，添加 blog/ 前缀
            const href = `/blog/${link}`;
            return {
              href,
              title: postsMap.get(link)?.title || link
            };
          }) || [];
          
          // 动态加载封面图片
          const coverImage = await getCoverImage(item.coverImage);
          
          // 类型图标映射
          const typeIcons: { [key: string]: IconName } = {
            book: 'book',
            paper: 'document',
            article: 'link'
          };
          
          return (
            <div
              class="book-row group relative flex flex-col sm:flex-row overflow-hidden rounded-lg border bg-background/60 p-4 transition-all duration-300 hover:border-primary/50 hover:shadow-lg hover:bg-background/90"
              data-title={item.title.toLowerCase()}
              data-description={(item.description || '').toLowerCase()}
              data-tags={(item.tags || []).join(' ').toLowerCase()}
              data-status={item.status}
              data-type={item.type}
            >
              {/* 封面图片 - PC端左侧显示完整图片，移动端作为背景 */}
              {coverImage && (
                <>
                  {/* PC端：左侧显示完整图片 */}
                  <div class="hidden sm:block flex-shrink-0 w-28 md:w-32 h-40 md:h-44 bg-muted/30 overflow-hidden">
                    <Image
                      src={coverImage}
                      alt={item.title}
                      class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                      loading="lazy"
                    />
                  </div>
                  {/* 移动端：作为背景，渐变遮罩 */}
                  <Image
                    src={coverImage}
                    alt={item.title}
                    class="cover-image-bg sm:hidden absolute inset-0 z-0 w-full h-full object-cover opacity-50 transition-opacity duration-300 group-hover:opacity-70"
                    loading="lazy"
                  />
                </>
              )}

              {/* 索引数字 - 右上角，显示 order */}
              {item.order !== undefined && (
                <span class="absolute top-2 right-2 flex h-5 w-5 items-center justify-center rounded-full bg-muted/60 text-xs font-bold text-muted-foreground transition-colors duration-300 group-hover:bg-muted/90 z-10">
                  {item.order}
                </span>
              )}

              {/* 内容区域 */}
              <div class="relative flex flex-col h-full z-10 sm:ml-4">
                {/* 标题 - 类型图标 + 标题 */}
                <div class="flex items-start gap-2 mb-2">
                  <Icon name={typeIcons[item.type] || 'book'} class="size-5 flex-shrink-0 text-muted-foreground" />
                  <h3 class="text-base font-semibold text-foreground group-hover:text-primary transition-colors break-words flex-1">
                    {item.title}
                  </h3>
                </div>

                {/* 属性徽章 - 评分、标识符、状态 */}
                <div class="flex flex-wrap items-center gap-2 mb-2">
                  {item.rating && (
                    <div class="flex items-center gap-1 rounded-full bg-muted/80 px-2 py-0.5 text-xs font-medium text-muted-foreground">
                      <Icon name="star" class="size-3.5 text-yellow-400" />
                      <span>{item.rating.toFixed(1)}</span>
                    </div>
                  )}
                  {item.identifier && (
                    <div class="flex items-center gap-1 rounded-full bg-muted/80 px-2 py-0.5 text-xs font-medium text-muted-foreground">
                      <Icon name="hashtag" class="size-3.5" />
                      <span>{item.identifier}</span>
                    </div>
                  )}
                  {/* 状态徽章 */}
                  <div class={`flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium bg-${statusInfo.color}-100 text-${statusInfo.color}-800 dark:bg-${statusInfo.color}-900 dark:text-${statusInfo.color}-200`}>
                    <Icon name={statusInfo.icon} class="size-3.5" />
                    <span>
                      {statusInfo.label}
                      {item.progress !== undefined && ` ${item.progress}%`}
                    </span>
                  </div>
                </div>

                {/* 描述 - 左侧边框样式 */}
                {item.description && (
                  <p class="mt-2 border-l-2 border-border pl-3 text-sm text-muted-foreground line-clamp-2">
                    {item.description}
                  </p>
                )}

                {/* 标签 */}
                {item.tags && item.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    {item.tags.map(tag => (
                      <span class="rounded bg-primary/10 px-1.5 py-0.5 text-xs font-medium text-primary/80">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}

                {/* 弹性空间 */}
                <div class="flex-grow"></div>

                {/* 相关笔记 */}
                {linkedPosts.length > 0 && (
                  <div class="mt-3 border-t pt-3">
                    <div class="flex items-center gap-2 text-sm flex-wrap">
                      <span class="text-xs font-semibold text-muted-foreground">相关笔记:</span>
                      {linkedPosts.map((post, idx) => (
                        <>
                          <a
                            href={post.href}
                            class="text-sm text-primary/80 hover:text-primary hover:underline underline-offset-2"
                          >
                            {post.title}
                          </a>
                          {idx < linkedPosts.length - 1 && <span class="text-muted-foreground">、</span>}
                        </>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </div>
          );
        }))}
      </div>
    </div>
  </main>
</PageLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const bookRows = document.querySelectorAll('.book-row');
    const statCards = document.querySelectorAll('.stat-card');
    
    let currentFilter = 'all';

    // 统计卡片点击过滤
    statCards.forEach((card) => {
      card.addEventListener('click', () => {
        const filter = card.getAttribute('data-filter');
        if (filter) {
          currentFilter = filter;
          filterBooks(currentFilter);
          
          // 更新统计卡片样式
          statCards.forEach((c) => {
            c.classList.remove('border-primary', 'border-blue-500', 'border-purple-500', 'border-green-500', 'bg-muted/30');
          });
          if (filter === 'all') {
            card.classList.add('border-primary', 'bg-muted/30');
          } else if (filter === 'to-read') {
            card.classList.add('border-blue-500', 'bg-muted/30');
          } else if (filter === 'reading') {
            card.classList.add('border-purple-500', 'bg-muted/30');
          } else if (filter === 'read') {
            card.classList.add('border-green-500', 'bg-muted/30');
          }
        }
      });
    });

    function filterBooks(filter: string) {
      bookRows.forEach((row) => {
        const status = row.getAttribute('data-status') || '';
        const matchesFilter = filter === 'all' || status === filter;
        (row as HTMLElement).style.display = matchesFilter ? 'block' : 'none';
      });
    }
  });
</script>

<style>
  /* 移动端：封面图片作为背景，使用渐变遮罩 */
  .cover-image-bg {
    mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
    -ms-mask-image: -ms-linear-gradient(to top, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
    -webkit-mask-image: -webkit-linear-gradient(
      to top,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 1) 100%
    );
  }
</style>

