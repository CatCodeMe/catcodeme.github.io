---
import comments from '@/data/comments.json';
import siteConfig from '@/site.config.ts';
import BaseHead from '@/components/BaseHead.astro';
import { Image } from 'astro:assets';

// Define types for comments and reaction groups
interface ReactionGroup {
  content: string;
  users: {
    totalCount: number;
  };
}

interface Comment {
  id: string;
  url: string;
  createdAt: string;
  author: {
    login: string;
    avatarUrl: string;
    url: string;
  };
  bodyHTML: string;
  reactionGroups?: ReactionGroup[]; // Optional as it might not always be present
  parentId: string | null;
  replyToId: string | null;
  replyToAuthor: string | null;
  level: number;
  type: string;
  discussionId: string;
  isDiscussion: boolean;
  title: string;
}

const title = 'Guestbook';
const description = 'A collection of all comments, styled like VS Code.';

const commentsById = new Map(comments.map((c: Comment) => [c.id, c]));

const discussionsUrl = `https://github.com/${siteConfig.integ.giscus?.repo}/discussions`;

// Helper function to format time ago
function timeAgo(dateString: string | number | Date) {
  const date = new Date(dateString);
  const now = new Date();
  const seconds = Math.round((now.getTime() - date.getTime()) / 1000);
  const minutes = Math.round(seconds / 60);
  const hours = Math.round(minutes / 60);
  const days = Math.round(hours / 24);

  if (seconds < 60) return `${seconds}s ago`;
  if (minutes < 60) return `${minutes}m ago`;
  if (hours < 24) return `${hours}h ago`;
  return `${days}d ago`;
}

// Helper function to format date to YYYY-MM-DD
function formatDate(dateString: string | number | Date) {
    const date = new Date(dateString);
    const year = date.getFullYear();
    const month = (date.getMonth() + 1).toString().padStart(2, '0');
    const day = date.getDate().toString().padStart(2, '0');
    return `${year}-${month}-${day}`;
}

function getReactionEmoji(reaction: string) {
  const a = {
    THUMBS_UP: '👍',
    THUMBS_DOWN: '👎',
    LAUGH: '😄',
    HOORAY: '🎉',
    CONFUSED: '😕',
    HEART: '❤️',
    ROCKET: '🚀',
    EYES: '👀',
  };
  return a[reaction as keyof typeof a] || '？';
}
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} ogImage='/images/guest-book.png' />
    <style>
      :root {
        --accent-color: #0969da;
        --text-color: #24292f;
        --text-secondary-color: #656d76;
        --bg-color: #ffffff;
        --bg-secondary-color: #f6f8fa;
        --border-color: #d1d9e0;
      }
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
          Oxygen, Ubuntu, Cantarell, sans-serif;
        background: var(--bg-secondary-color);
        color: var(--text-color);
        overflow: hidden;
      }

      .guestbook-container {
        display: flex;
        height: 100vh;
        width: 100vw;
        background: var(--bg-color);
      }

      .comments-pane,
      .giscus-pane {
        height: 100vh;
        overflow-y: auto;
      }

      .comments-pane {
        width: 60%;
        padding-top: 1.5rem;
        border-right: 1px solid var(--border-color);
        display: flex;
        flex-direction: column;
        -ms-overflow-style: none;  /* IE and Edge */
        scrollbar-width: none;  /* Firefox */
      }

      .comments-pane::-webkit-scrollbar {
        display: none; /* Chrome, Safari, Opera*/
      }

      .giscus-pane {
        width: 40%;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
      }

      .giscus-image-container {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 1.5rem; /* Space between image and Giscus */
      }

      .giscus-image-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .giscus-comments-container {
        flex-grow: 1; /* Giscus takes remaining space */
        padding: 1.5rem;
      }

      .pane-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 1.5rem;
        margin: 0 1.5rem 1.5rem 1.5rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--border-color);
        gap: 1rem;
      }

      .pane-header h1 {
        font-size: inherit;
        margin: 0;
        padding: 0;
        border: none;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-shrink: 0;
      }

      .home-link {
        font-size: 1.5rem;
        text-decoration: none;
        color: var(--text-secondary-color);
        transition: color 0.2s;
      }

      .home-link:hover {
        color: var(--accent-color);
      }

      .notice-container {
        flex-grow: 1;
        text-align: center;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--text-secondary-color);
        font-size: 0.9rem;
        padding: 0 1rem;
      }

      .comments-list {
        flex-grow: 1;
      }

      .comment-item {
        display: flex;
        padding: 16px 20px;
        border-bottom: 1px solid var(--border-color);
        transition: background 0.2s;
        position: relative;
      }

      .comment-item:hover {
        background: var(--bg-secondary-color);
      }

      .comment-item::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 3px;
        background: var(--accent-color);
        opacity: 0;
        transition: opacity 0.2s;
      }

      .comment-item:hover::before {
        opacity: 1;
      }

      .comment-item.highlighted-comment {
        background: #fffacd; /* A more noticeable light yellow for highlighting */
      }

      .line-number {
        width: 50px;
        color: var(--text-secondary-color);
        font-size: 13px;
        text-align: right;
        margin-right: 20px;
        user-select: none;
        flex-shrink: 0;
        font-family: 'SF Mono', Monaco, 'Cascadia Code', 'Roboto Mono',
          Consolas, monospace;
      }

      .comment-content-wrapper {
        flex: 1;
      }

      .comment-header {
        display: flex;
        align-items: center;
        margin-bottom: 8px;
        gap: 8px;
        flex-wrap: wrap;
      }

      .user-avatar {
        width: 24px;
        height: 24px;
        border-radius: 50%;
      }

      .user-name {
        color: var(--accent-color);
        font-weight: 600;
        font-size: 14px;
      }

      .comment-time {
        color: var(--text-secondary-color);
        font-size: 12px;
        white-space: nowrap;
      }

      .github-link {
        color: var(--text-secondary-color);
        text-decoration: none;
        font-size: 12px;
        margin-left: auto;
        transition: color 0.2s;
        white-space: nowrap;
      }

      .github-link:hover {
        color: var(--accent-color);
        text-decoration: underline;
      }

      .comment-body {
        color: var(--text-color);
        font-size: 14px;
        line-height: 1.6;
      }

      .reactions {
        display: flex;
        gap: 8px;
        margin-top: 12px;
      }

      .reaction {
        background: var(--bg-secondary-color);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 4px 8px;
        font-size: 12px;
        color: var(--text-color);
        display: flex;
        align-items: center;
        gap: 4px;
        transition: all 0.2s;
      }

      .reaction:hover {
        border-color: var(--accent-color);
      }

      .see-more-container {
        padding: 2rem;
        text-align: center;
      }

      .see-more-btn {
        display: inline-block;
        padding: 0.75rem 1.5rem;
        background-color: var(--bg-secondary-color); /* Revert background */
        color: var(--text-color); /* Adjust text color */
        border: 1px solid var(--border-color);
        border-radius: 8px;
        text-decoration: none;
        transition: all 0.3s ease; /* Smoother transition */
        font-size: 1rem;
        font-weight: 600;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); /* Subtle shadow */
        position: relative; /* For pseudo-elements */
        overflow: hidden; /* Hide overflowing pseudo-elements */
        z-index: 1;
      }

      .see-more-btn::before,
      .see-more-btn::after {
        content: '';
        position: absolute;
        background: var(--accent-color); /* Accent color for border animation */
        transition: all 0.3s ease;
        z-index: -1;
      }

      .see-more-btn::before {
        top: 0;
        left: 0;
        width: 0;
        height: 2px;
      }

      .see-more-btn::after {
        bottom: 0;
        right: 0;
        width: 0;
        height: 2px;
      }

      .see-more-btn:hover::before,
      .see-more-btn:hover::after {
        width: 100%;
      }

      .see-more-btn:hover {
        background-color: var(--bg-secondary-color); /* Keep background same on hover */
        border-color: var(--accent-color); /* Change border color on hover */
        transform: translateY(-2px); /* Lift effect on hover */
        box-shadow: 0 6px 8px rgba(0, 0, 0, 0.15); /* Enhanced shadow on hover */
      }

      .quoted-reply {
        border-left: 3px solid var(--border-color);
        padding-left: 12px;
        margin-bottom: 8px;
        font-size: 13px;
        color: var(--text-secondary-color);
      }
      .quoted-reply p {
        margin-bottom: 4px;
      }
      .quoted-reply a {
        color: var(--accent-color);
        text-decoration: none;
      }
      .quoted-reply a:hover {
        text-decoration: underline;
      }
      .quoted-reply blockquote {
        margin: 0;
        padding: 0;
        border: none;
        max-height: 7em; /* Limit height of quoted text */
        overflow: hidden;
        text-overflow: ellipsis;
        opacity: 0.8;
        position: relative;
      }
      .quoted-reply blockquote::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 1.5em;
        background: linear-gradient(to bottom, transparent, var(--bg-color));
      }
      .quoted-reply blockquote > *:first-child {
          margin-top: 0;
      }
      .quoted-reply blockquote > *:last-child {
          margin-bottom: 0;
      }

      /* Responsive */
      @media (max-width: 768px) {
        .guestbook-container {
          flex-direction: column;
        }
        .comments-pane,
        .giscus-pane {
          width: 100%;
          height: 50vh; /* Split height on mobile */
        }
        .comments-pane {
          border-right: none;
          border-bottom: 1px solid var(--border-color);
          padding-left: 1rem;
          padding-right: 1rem;
        }
        .notice-container { display: none; }
        .comment-item {
            padding-left: 0;
            padding-right: 0;
        }
        .line-number {
            display: none;
        }
      }

      /* Custom Scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }
      ::-webkit-scrollbar-track {
        background: var(--bg-secondary-color);
      }
      ::-webkit-scrollbar-thumb {
        background: #d1d9e0;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #b1bac4;
      }
    </style>
  </head>
  <body>
    <div class="guestbook-container">
      <!-- Left Pane: All Comments -->
      <div class="comments-pane">
        <div class="pane-header">
            <h1>
                <span>🎤</span>
                <span>Latest Comments ({comments.length})</span>
            </h1>
            <div class="notice-container">
                <p>欢迎留言,您的留言将会在几分钟后出现在留言板～</p>
            </div>
            <a href="/" class="home-link" title="Back to Home">↩️</a>
        </div>
        <div class="comments-list">
          {
            comments.map((comment: Comment, index: number) => {
              const repliedToComment = comment.replyToId ? commentsById.get(comment.replyToId) : null;
              return (
              <div class="comment-item" id={comment.id}>
                <div class="line-number">{comments.length - index}</div>
                <div class="comment-content-wrapper">
                  <div class="comment-header">
                    <img
                      src={comment.author.avatarUrl}
                      alt={comment.author.login}
                      class="user-avatar"
                    />
                    <span class="user-name">{comment.author.login}</span>
                    <span class="comment-time">
                      {timeAgo(comment.createdAt)} ({formatDate(comment.createdAt)})
                    </span>
                    <a
                      href={comment.url}
                      class="github-link"
                      target="_blank"
                      rel="noopener noreferrer">View on GitHub</a
                    >
                  </div>
                  { repliedToComment && (
                    <div class="quoted-reply">
                      <p>
                        Replying to <a href={`#${repliedToComment.id}`}>@{comment.replyToAuthor}</a>
                      </p>
                      <blockquote set:html={repliedToComment.bodyHTML} />
                    </div>
                  )}
                  <div class="comment-body" set:html={comment.bodyHTML} />
                  <div class="reactions">
                    {comment.reactionGroups &&
                      comment.reactionGroups.map((group: ReactionGroup) =>
                        group.users.totalCount > 0 ? (
                          <div class="reaction">
                            {getReactionEmoji(group.content)}{' '}
                            <span>{group.users.totalCount}</span>
                          </div>
                        ) : null
                      )}
                  </div>
                </div>
              </div>
            )})
          }
        </div>
        <div class="see-more-container">
            <a href={discussionsUrl} class="see-more-btn" target="_blank" rel="noopener noreferrer">
                See more on GitHub
            </a>
        </div>
      </div>

      <!-- Right Pane: Giscus -->
      <div class="giscus-pane">
        <div class="giscus-image-container">
          <Image src="/images/guest-book.png" alt="Guest Book @8cat.life" width={1200} height={630} />
        </div>
        <div class="giscus-comments-container">
          <script
            is:inline
            src="https://giscus.app/client.js"
            data-repo="CatCodeMe/catcodeme.github.io"
            data-repo-id="R_kgDOLTuIuQ"
            data-category="General"
            data-category-id="DIC_kwDOLTuIuc4Csz7O"
            data-mapping="og:title"
            data-strict="0"
            data-reactions-enabled="1"
            data-emit-metadata="0"
            data-input-position="top"
            data-theme="light"
            data-lang="en"
            crossorigin="anonymous"
            async
          >
          </script>
        </div>
        <script is:inline>
          function applyHighlight() {
            const hash = window.location.hash.substring(1);
            document.querySelectorAll('.comment-item.highlighted-comment').forEach(el => {
              el.classList.remove('highlighted-comment');
            });
            if (hash) {
              const targetComment = document.getElementById(hash);
              if (targetComment) {
                targetComment.classList.add('highlighted-comment');
                // Optional: Scroll into view smoothly if not already in view
                targetComment.scrollIntoView({ behavior: 'smooth', block: 'center' });
                // Remove highlight after a short delay
                setTimeout(() => {
                  targetComment.classList.remove('highlighted-comment');
                }, 2000); // 2 seconds
              }
            }
          }

          // Apply highlight on initial load if hash is present
          document.addEventListener('DOMContentLoaded', applyHighlight);
          // Apply highlight when hash changes (e.g., clicking a reply link)
          window.addEventListener('hashchange', applyHighlight);

          // Listen for clicks on internal anchor links within the comments list
          document.addEventListener('click', (event) => {
            const target = event.target;
            // Check if the clicked element is an anchor tag within a .quoted-reply and its href starts with '#'
            if (target.tagName === 'A' && target.closest('.quoted-reply') && target.getAttribute('href')?.startsWith('#')) {
              const hash = target.getAttribute('href');
              if (hash && window.location.hash !== hash) { // Only update if hash is different to avoid unnecessary history entries
                event.preventDefault(); // Prevent default browser jump
                window.location.hash = hash; // Manually update hash, which should trigger hashchange
              } else if (hash && window.location.hash === hash) {
                // If clicking the same hash, hashchange won't fire, so manually apply highlight
                event.preventDefault(); // Prevent default browser jump
                applyHighlight();
              }
            }
          });
        </script>
      </div>
    </div>
  </body>
</html>
