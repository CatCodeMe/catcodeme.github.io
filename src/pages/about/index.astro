---
import { Comment } from 'astro-pure/advanced'
import { Spoiler, Timeline } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import Substats from '@/components/about/Substats.astro'
import { ToolTag } from '@/components/tools/Tool.astro'
import ToolSection from '@/components/tools/ToolSection.astro'
---

<PageLayout title='About' info={{ slug: '/about', hideComment: true }}>
  <h2 id='about'>About Me</h2>
  <ul>
    <li>Communist / Developer / Learner / Cat owner</li>
    <li>改造自己,进而改造世界🚩 <Spoiler>革命无罪，造反有理！</Spoiler></li>
  </ul>

  {/* general-talk */}
  <!-- <h2 id='hobbies'>Hobbies</h2>
  <ul>
    <li>Lorem ipsum dolor sit amet, vidit suscipit at mei.</li>
    <li>
      Quem denique mea id. Usu ei regione indoctum dissentiunt, cu meliore fuisset mei, vel quod
      voluptua ne.
    </li>
    <li>Ex dicat impedit mel, at eum oratio possit voluptatum.</li>
    <li>Impetus fuisset ullamcorper pri cu, his posse iisque ad, aliquam honestatis usu id.</li>
  </ul> -->

  {/* tools */}
  <h2 id='tools'>Tools</h2>
  <p>Current support tools as follow:</p>
  <ToolSection
    class='mb-5'
    title='Workstation (+Operating System)'
    tools={[
      {
        name: 'MacBook M1 Pro 14"',
        description: 'MacOS Sequoia 15',
        href: 'https://www.apple.com/mac/',
        icon: import('@/assets/tools/apple.svg?raw'),
        tags: [ToolTag.Favorite]
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Daily Tools'
    tools={[
      {
        name: 'Microsoft Edge',
        description: 'Browser',
        href: 'https://www.microsoft.com/edge',
        icon: import('@/assets/tools/edge.svg?raw')
      },
      {
        name: 'Obsidian',
        description: 'Tool for thought',
        href: 'https://obsidian.md/',
        icon: import('@/assets/tools/obsidian.svg?raw'),
        tags: [ToolTag.Free]
      },
      {
        name: 'Warp',
        description: 'Terimnal',
        href: 'https://www.warp.dev/',
        icon: import('@/assets/tools/warp.svg?raw')
      },
      {
        name: 'NotebookLM',
        description: 'AI Notebook',
        href: 'https://notebooklm.com/',
        icon: import('@/assets/tools/notebooklm.svg?raw'),
        tags: [ToolTag.Favorite]
      },
      {
        name: 'Deepseek',
        description: 'AI Assistant',
        href: 'https://deepseek.com/',
        icon: import('@/assets/tools/deepseek.svg?raw')
      },
      {
        name: 'Utools',
        description: 'Powerful launcher',
        href: 'https://u.tools/',
        icon: import('@/assets/tools/utools.svg?raw'),
        tags: [ToolTag.Favorite]
      },
      {
        name: 'WeRead',
        description: 'Reading App',
        href: 'https://weread.qq.com/',
        icon: import('@/assets/tools/weread.svg?raw'),
        tags: [ToolTag.Favorite]
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Development'
    tools={[
      {
        name: 'VS Code',
        description: 'powerful code editor',
        href: 'https://code.visualstudio.com/',
        icon: import('@/assets/tools/vscode.svg?raw')
      },
      {
        name: 'Intellij IDEA',
        description: 'Best Java IDE',
        href: 'https://www.jetbrains.com/idea/',
        icon: import('@/assets/tools/idea.svg?raw')
      },
      {
        name: 'GitHub Copilot',
        description: 'AI Coding Assistant',
        href: 'https://github.com/features/copilot',
        icon: import('@/assets/tools/githubcopilot.svg?raw'),
        tags: [ToolTag.Favorite]
      },
      {
        name: 'Gemini Pro',
        description: 'AI Coding Assistant',
        href: 'https://ai.google.dev/gemini',
        icon: import('@/assets/tools/gemini.svg?raw')
      }
    ]}
  />

  {/* social-networks */}
  <h2 id='social-networks'>Social Networks</h2>
  <Substats
    stats={[
      {
        platform: 'GitHub',
        icon: 'github',
        link: 'https://github.com/catcodeme',
        text: 'followers',
        api: 'github/catcodeme'
      },
      {
        platform: 'Bilibili',
        icon: 'bilibili',
        link: 'https://space.bilibili.com/19080963',
        text: 'fans',
        // api: 'bilibili/19080963',
        color: '#fe7398',
        count: 18
      }
    ]}
  />

  {/* gossips */}
  <!-- <h2 id='gossips'>Gossips</h2>
  <Collapse title='Lorem ipsum'>
    Lorem ipsum dolor sit amet, vidit suscipit at mei. Quem denique mea id. Usu ei regione indoctum
    dissentiunt, cu meliore fuisset mei, vel quod voluptua ne. Ex dicat impedit mel, at eum oratio
    possit voluptatum.
  </Collapse> -->

  {/* about-blog */}
  <h2 id='about-blog'>About Blog</h2>
  <p>Website history:</p>
  <Timeline
    events={[
      {
        date: '2025-07-11',
        content:
          'Website refactored from <a href="https://github.com/srleom/astro-theme-resume" target="_blank">Astro Theme Pure</a>'
      }
    ]}
  />
  <p>
    The smooth operation and personalized customization of website also rely on the resources and
    technical support provided by the following excellent projects/service providers:
  </p>
  <ul>
    <li>Domain: <a href='#' target='_blank'>Github Pages</a></li>
    <li>
      Framework & Theme: <a href='https://astro.build/' target='_blank'>Astro</a> + <a
        href='https://github.com/cworld1/astro-theme-pure'
        target='_blank'>Astro Theme Pure</a
      >
    </li>
    <li>
      Site hosting: <a href='https://pages.github.com' target='_blank'>Github Pages</a>
    </li>
    <li>
      CI/CD: <a href='https://github.com/actions' target='_blank'>Github Action</a>
    </li>
    <!-- <li>Resources speedup: <a href='https://cdn.cbd.int/' target='_blank'>CBD CDN</a></li> -->
    <li>Comment system: <a href='https://giscus.app' target='_blank'>Giscus</a></li>
    <li>
      Visits & Stats: <a href='https://github.com/EvanNotFound/vercount' target='_blank'>Vercount</a
      >
    </li>
    <li>
      Icons: from <a href='https://iconify.design/' target='_blank'
        >Iconify</a
      > & <a href='https://lobehub.com/icons' target='_blank'>lobehub</a>, some icons from `GPT-4o`
    </li>
  </ul>
  <Comment slot='bottom' />
</PageLayout>
