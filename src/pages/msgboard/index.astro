---
import PageLayout from '@/layouts/BaseLayout.astro'
import DanmakuComments from '@/components/waline/DanmakuComments.astro'
import bannerImage from '@/assets/msgboard/board2.png'
import { Icon } from '@/custom/components/user'
import { Comment } from '@/components/waline'
import Banner from '@/components/banner/Banner.astro'

const meta = {
  title: '留言板',
  description: '欢迎分享你的故事与想法, 请友善交流, 尊重彼此.'
}
---

<PageLayout meta={meta}>
  <style is:global>
    @import url("https://fontsapi.zeoseven.com/285/main/result.css");

    /* 留言板页面使用 CDN 字体，覆盖全局字体设置 */
    body {
      font-family: "Noto Serif CJK" !important;
      font-weight: normal !important;
      /* font-feature-settings: "hwid"; 启用等宽变化字形 */
    }
  </style>

  <main class='mt-6 lg:mt-10'>
    <Banner image={bannerImage} imageAlt="留言板横幅">
      <div class='flex items-center gap-3'>
        <Icon name='msgboard' class='size-8' />
        <h1 class='text-3xl font-bold'>{meta.title}</h1>
      </div>
      <p class='mt-2 text-muted-foreground'>{meta.description}</p>
    </Banner>

    <div id='content' class='animate mt-8'>
      <DanmakuComments />
      <div class="mt-8">
        <Comment enable={true}/>
      </div>
    </div>
  </main>
</PageLayout>


