---
import { Image } from 'astro:assets'
import { Icon } from '@/custom/components/user'
import { LightGallery } from 'astro-lightgallery'
import bannerImage from '@/assets/cats/banner.png'

import GalleryLayout from '@/layouts/GalleryLayout.astro'
import { info, photos } from '@/assets/cats/config/data'

const allCats = Object.entries(info)
---

<GalleryLayout title='猫咪画廊'>
  <!-- Section 1: Cat Roster -->
  <section class='cat-roster'>
    <div class="section-header">
      <div class="section-header-text">
        <h2 class='section-title'>8cats' life</h2>
        <p class='section-subtitle'>有了名字的猫再也不孤单 | 喵星远了些, ccm 永远爱你们</p>
      </div>
      <Image src={bannerImage} alt="Cats banner" class="section-header-image" />
    </div>
    <div class='roster-controls'>
      <button class='roster-control-btn active' data-filter='all'>全部</button>
      {
        allCats.map(([name]) => (
          <button class='roster-control-btn' data-filter={name}>
            {name}
          </button>
        ))
      }
    </div>
    <div class='roster-grid'>
      {
        allCats.map(([name, catInfo]) => {
          const catId = catInfo.id // Use ID from data
          const isDeceased = catInfo.deathday

          // Find a representative image for the cat
          const catImage = photos.find((p) => p.subjects?.includes(name))?.image

          // Calculate age
          const birthYear = new Date(catInfo.birthday).getFullYear()
          const endYear = catInfo.deathday
            ? new Date(catInfo.deathday).getFullYear()
            : new Date().getFullYear()
          const age = endYear - birthYear

          return (
            <div class='roster-card group' id={`cat-${catId}`} data-cat-name={name}>
              <div class={`roster-card-inner ${isDeceased ? 'is-deceased' : ''}`}>
                {catImage && <Image src={catImage} alt={name} class='roster-cover-image' />}
                <div class='roster-content'>
                  <div class='roster-header'>
                    <h3 class='roster-name'>{name}</h3>
                    <div class='roster-top-meta'>
                      <span class='age-display'>{age}岁</span>
                      <span class={`gender-icon ${catInfo.gender === '男' ? 'male' : 'female'}`}>
                        {catInfo.gender === '男' ? '♂' : '♀'}
                      </span>
                    </div>
                  </div>
                  <p class='roster-bio'>{catInfo.desc || '一只可爱的猫咪'}</p>
                  <div class='roster-meta'>
                    <div class='meta-item'>
                      <Icon name='cake' />
                      <span>{catInfo.birthday}</span>
                    </div>
                    {isDeceased && (
                      <div class='meta-item'>
                        <Icon name='sleep' />
                        <span>{catInfo.deathday} (猫星)</span>
                      </div>
                    )}
                  </div>
                  <div class='roster-tags'>
                    {catInfo.tags.map((tag) => (
                      <span class='tag'>{tag}</span>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          )
        })
      }
    </div>
  </section>

  <!-- Section 2: Photo Gallery -->
  <section class='photo-gallery'>
    <h2 class='section-title'>📸 生活瞬间</h2>
    <LightGallery
      class='masonry-grid'
      options={{
        thumbnail: true,
        autoplay: true,
        slideShowInterval: 500
      }}
      addPlugins={['zoom']}
    >
      {
        photos.map((photo) => {
          const subjects = photo.subjects?.join(' ') || 'unknown'
          return (
            <a
              href={photo.image.src}
              class='masonry-item'
              data-subjects={subjects}
              data-lg-size={`${photo.image.width}-${photo.image.height}`}
            >
              <Image src={photo.image} alt={photo.caption || 'A cat photo'} loading='lazy' />
              <div class='overlay'>
                {photo.caption && <p class='caption'>{photo.caption}</p>}
                {photo.subjects && photo.subjects.length > 0 && (
                  <p class='subjects'>{photo.subjects.join(', ')}</p>
                )}
              </div>
            </a>
          )
        })
      }
    </LightGallery>
  </section>
</GalleryLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.roster-control-btn')
    const photoItems = document.querySelectorAll('.masonry-item')
    const rosterCards = document.querySelectorAll('.roster-card')

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.getAttribute('data-filter')

        // Update button active state
        filterButtons.forEach((btn) => btn.classList.remove('active'))
        button.classList.add('active')

        // Filter photos
        photoItems.forEach((item) => {
          const subjects = item.getAttribute('data-subjects')
          if (filter === 'all' || (filter && subjects && subjects.includes(filter))) {
            ;(item as HTMLElement).style.display = 'block'
          } else {
            ;(item as HTMLElement).style.display = 'none'
          }
        })

        // Highlight roster card
        rosterCards.forEach((card) => {
          const catName = card.getAttribute('data-cat-name')
          if (filter !== 'all' && catName === filter) {
            card.classList.add('highlighted')
          } else {
            card.classList.remove('highlighted')
          }
        })
      })
    })
  })
</script>

<style>
  .section-header {
    display: flex;
    align-items: stretch;
    margin-bottom: 1.5rem;
    background-color: #f7fafc;
    border-radius: 8px;
    overflow: hidden;
  }
  .section-header-text {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1;
  }
  .section-header-image {
    width: 40%;
    object-fit: cover;
  }

  @media (max-width: 767px) {
    .section-header {
      flex-direction: column;
    }
    .section-header-image {
      width: 100%;
      height: 150px;
    }
    .section-header-text {
      padding: 1.5rem;
    }
  }
  .section-title {
    font-size: 2rem;
    font-weight: bold;
    margin-bottom: 0;
    text-align: left;
    color: #2d3748;
  }

  .section-subtitle {
    text-align: left;
    color: #718096;
    margin-top: 0.25rem;
    margin-bottom: 0;
  }

  /* Roster Styles */
  .cat-roster {
    padding: 2rem 1rem;
    background-color: #fdfdfd;
  }
  .roster-controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .roster-control-btn {
    background-color: transparent;
    border: none;
    border-radius: 0;
    padding: 0.5rem 0.25rem;
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    border-bottom: 2px solid transparent;
    margin: 0 0.5rem;
    color: #718096;
    position: relative;
  }
  .roster-control-btn::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 2px;
    background-color: #4299e1;
    transition: width 0.3s ease-in-out;
  }
  .roster-control-btn:hover {
    color: #2d3748;
  }
  .roster-control-btn.active {
    font-weight: 700;
    color: #2d3748;
  }
  .roster-control-btn.active::after {
    width: 100%;
  }

  .roster-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }
  .roster-card {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    transition: all 0.3s ease;
    background-color: #fff;
  }
  .roster-card:hover {
    border-color: #cbd5e0;
  }
  .roster-card.highlighted {
    border-color: #4299e1;
    box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.5);
  }
  .roster-card-inner {
    height: 100%;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    border-radius: 7px;
  }
  .roster-card-inner.is-deceased .roster-content {
    filter: grayscale(90%);
  }

  .roster-cover-image {
    position: absolute;
    top: 0;
    right: 0; /* Anchor to the right */
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    opacity: 0.2; /* Exactly as in Paper.astro */
    transition: opacity 0.3s ease;
    mask-image: linear-gradient(
      to right,
      transparent 5%,
      black 60%
    ); /* Exactly as in Paper.astro */
    -webkit-mask-image: linear-gradient(to right, transparent 5%, black 60%);
  }
  .roster-card:hover .roster-cover-image {
    opacity: 0.7; /* Exactly as in Paper.astro */
  }
  .roster-card-inner.is-deceased .roster-cover-image {
    filter: grayscale(100%);
  }

  .roster-content {
    position: relative;
    z-index: 1;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .roster-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .roster-name {
    font-size: 1.5rem;
    font-weight: bold;
    color: #2d3748;
    margin: 0;
  }

  .roster-top-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #4a5568;
  }
  .age-display {
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.1rem 0.5rem;
    background-color: rgba(0, 0, 0, 0.05);
    border-radius: 6px;
  }
  .gender-icon {
    font-size: 1.5rem;
  }
  .gender-icon.male {
    color: #3182ce;
  }
  .gender-icon.female {
    color: #d53f8c;
  }

  .roster-bio {
    margin: 0 0 0.75rem;
    padding-left: 1rem;
    border-left: 3px solid #e2e8f0;
    color: #718096;
    font-style: normal;
  }

  .roster-meta {
    margin-top: 0;
    margin-bottom: 1rem; /* Restore margin */
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #4a5568;
    font-size: 0.85rem;
  }
  .meta-item :global(svg) {
    width: 16px;
    height: 16px;
  }

  .roster-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
  }
  .tag {
    background-color: #edf2f7;
    color: #4a5568;
    padding: 0.25rem 0.75rem;
    border-radius: 12px;
    font-size: 0.8rem;
  }

  /* Gallery Styles */
  .photo-gallery {
    padding: 2rem 1rem;
  }
  .masonry-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
  .masonry-item {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    display: block; /* For filtering */
    height: 300px;
  }
  .masonry-item img {
    height: 100%;
    width: auto;
    display: block;
    transition: transform 0.3s ease;
  }
  .masonry-item:hover img {
    transform: scale(1.05);
  }
  .overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
    color: white;
    padding: 2rem 1rem 1rem;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.3s ease;
    pointer-events: none;
  }
  .masonry-item:hover .overlay {
    opacity: 1;
    transform: translateY(0);
  }
  .overlay .caption {
    margin: 0 0 0.5rem;
    font-weight: bold;
  }
  .overlay .subjects {
    margin: 0;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .overlay .subjects :global(svg) {
    width: 16px;
    height: 16px;
  }
</style>
