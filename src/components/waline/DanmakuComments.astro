---
import { Image } from 'astro:assets'

import commentFlag from '@/assets/other/comment_flag.png'
import config from '@/site-config'

interface WalineComment {
  nick: string
  comment: string
  avatar: string
  like?: number
  type?: string // Add type for admin check
}

let recentComments: WalineComment[] = []
const serverURL = config.integ.waline.server

if (serverURL) {
  try {
    const response = await fetch(`${serverURL}/comment?type=recent&count=50`)
    if (response.ok) {
      recentComments = await response.json()
    } else {
      console.error(`[Danmaku Server] Failed to fetch, status: ${response.status}`)
    }
  } catch (e) {
    console.error('[Danmaku Server] Error fetching comments:', e)
  }
}
---

<div id='danmaku_container' class='terminal-container my-12 mx-auto'>
  <div class='terminal-header'>
    <div class='terminal-title'>
      <span style='font-family: "ZSFT-e";'>CCMTV</span>
      <span id='danmaku-status' class='running'>running</span>
    </div>
    <div class='terminal-controls'>
      <!-- <button class='control-btn' id='danmaku-toggle'>暂停</button> -->
    </div>
  </div>

  <div class='terminal-screen'>
    <Image
      src={commentFlag}
      alt='Welcome to leave comments'
      class='absolute bottom-4 left-4 w-[120px] h-auto pointer-events-none'
    />
    <div class='danmaku-track'></div>
    <div class='danmaku-track'></div>
    <div class='danmaku-track'></div>
    <div class='danmaku-track'></div>
    <div class='danmaku-track'></div>
    <div class='danmaku-track'></div>
  </div>

  <div class='status-line'>
    <span>Lines: <span id='danmaku-lineCount'>0</span></span>
    <span id='danmaku-keyboard-shortcuts'
      >Press <kbd>Space</kbd> to play , <kbd>C</kbd> to clear</span
    >
  </div>
</div>

<script is:inline  define:vars={{ comments: recentComments }}>
  function initializeDanmaku() {
    const container = document.getElementById('danmaku_container')
    if (!container || container.dataset.initialized) return
    container.dataset.initialized = 'true'

    if (!comments || comments.length === 0) {
      return
    }

    let isPlaying = true
    const trackLastTime = [0, 0, 0, 0, 0, 0]
    let loopTimeoutId = null
    let commentIndex = 0
    let lineCount = 0

    function selectBestTrack() {
      let bestTrack = 0
      let earliestTime = trackLastTime[0]
      for (let i = 1; i < trackLastTime.length; i++) {
        if (trackLastTime[i] < earliestTime) {
          earliestTime = trackLastTime[i]
          bestTrack = i
        }
      }
      return bestTrack
    }

    function truncateHtmlInline(html, maxLen) {
      // 去掉换行，避免输出换行
      html = html.replace(/^<p>|<\/p>$/g, '')

      const tagRegex = /<\/?[^>]+>/g
      let textLen = 0
      let result = ''
      let lastIndex = 0
      let match

      while ((match = tagRegex.exec(html)) !== null) {
        // 标签前的纯文字
        if (lastIndex < match.index) {
          const text = html.slice(lastIndex, match.index)
          if (textLen + text.length < maxLen) {
            result += text
            textLen += text.length
          } else {
            const remaining = maxLen - textLen
            result += text.slice(0, remaining) + '...'
            return result
          }
        }

        // 保留标签本身（比如 <img>）
        result += match[0]
        lastIndex = tagRegex.lastIndex
      }

      // 标签后的最后一段纯文字
      if (lastIndex < html.length && textLen < maxLen) {
        const text = html.slice(lastIndex)
        if (textLen + text.length <= maxLen) {
          result += text
        } else {
          result += text.slice(0, maxLen - textLen) + '...'
        }
      }

      return result
    }

    function createDanmaku(data) {
      if (!isPlaying) return
      const trackIndex = selectBestTrack()
      const track = container.querySelectorAll('.danmaku-track')[trackIndex]
      if (!track) return

      const danmaku = document.createElement('div')
      danmaku.className = 'danmaku-item not-prose'
      if (data.type === 'administrator') {
        danmaku.classList.add('is-admin')
      }

      const cleanComment = truncateHtmlInline(data.comment, 30)
      const likeHtml = data.like > 0 ? `<span class="danmaku-like">👍 ${data.like}</span>` : ''

      danmaku.innerHTML = `
          <img class="danmaku-avatar" src="${data.avatar}" alt="" onerror="this.style.display='none'">
          <span class="danmaku-nick">${data.nick}</span>
          <span class="danmaku-comment not-prose">${cleanComment}</span>
          ${likeHtml}
      `

      let duration
      if (window.innerWidth < 600) {
        duration = Math.random() * 4 + 6
      } else {
        duration = Math.random() * 8 + 16
      }
      danmaku.style.animationDuration = `${duration}s`

      track.appendChild(danmaku)
      trackLastTime[trackIndex] = Date.now()

      const lineCountEl = document.getElementById('danmaku-lineCount')
      if (lineCountEl) lineCountEl.textContent = lineCount.toString()

      danmaku.classList.add('danmaku-animate')
      danmaku.addEventListener('animationend', () => {
        danmaku.remove()
      })
    }

    function startDanmakuLoop() {
      if (!isPlaying || comments.length === 0) return
      const commentData = comments[commentIndex]
      createDanmaku(commentData)
      lineCount++
      commentIndex = (commentIndex + 1) % comments.length
      loopTimeoutId = setTimeout(startDanmakuLoop, 3000)
    }

    function toggleDanmaku() {
      isPlaying = !isPlaying
      const status = document.getElementById('danmaku-status')
      if (status) {
        status.textContent = isPlaying ? 'running' : 'paused'
        status.classList.toggle('running', isPlaying)
        status.classList.toggle('paused', !isPlaying)
      }
      if (isPlaying) {
        startDanmakuLoop()
      } else {
        clearTimeout(loopTimeoutId)
      }
    }

    function clearDanmaku() {
      container.querySelectorAll('.danmaku-track').forEach((track) => {
        track.innerHTML = ''
      })
      trackLastTime.fill(0)
    }

    document.addEventListener('keydown', (e) => {
      if (document.activeElement !== document.body && document.activeElement !== container) return
      switch (e.key.toLowerCase()) {
        case ' ':
        case 'spacebar':
          e.preventDefault()
          toggleDanmaku()
          break
        case 'c':
          clearDanmaku()
          break
      }
    })

    if (loopTimeoutId) clearTimeout(loopTimeoutId)
    startDanmakuLoop()
  }

  setTimeout(initializeDanmaku, 1000)
</script>

<style>
  :global(:root) {
    --bg: #ffffff;
    --terminal-bg: #fafafa;
    --border: #e0e0e0;
    --text: #333333;
    --text-secondary: #666666;
    --accent: #2196f3;
    --danmaku-bg: #ffffff;
    --danmaku-border: #e0e0e0;
    --danmaku-nick-text: #2196f3;
    --grid-color: #2196f3;
  }
  :global([data-theme='dark']) {
    --bg: #0a0a0a;
    --terminal-bg: #1a1a1a;
    --border: #333333;
    --text: #00ff00;
    --text-secondary: #888888;
    --accent: #00ff00;
    --danmaku-bg: #1a1a1a;
    --danmaku-border: #333333;
    --danmaku-nick-text: #00ff00;
    --grid-color: #00ff00;
  }

  .terminal-container {
    width: 100%;
    max-width: 1000px;
    background: var(--terminal-bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    transition: all 0.3s ease;
  }
  .terminal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 20px;
    border-bottom: 1px solid var(--border);
    background: var(--terminal-bg);
  }
  .terminal-title {
    color: var(--text);
    font-size: 14px;
    font-weight: normal;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  #danmaku-status {
    display: inline-block;
    min-width: 60px;
    padding: 2px 16px;
    /* border-radius: 999px; */
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 1px;
    transition:
      background 0.3s,
      color 0.3s;
    background: linear-gradient(90deg, #e0e0e0 0%, #fafafa 100%);
    color: #666;
    /* box-shadow: 0 1px 4px rgba(0,0,0,0.04); */
    border: 1px solid #e0e0e0;
  }
  #danmaku-status.running {
    background: linear-gradient(90deg, #a8ff78 0%, #78ffd6 100%);
    color: #1a7f2b;
    border: 1px solid #78ffd6;
  }
  #danmaku-status.paused {
    background: linear-gradient(90deg, #ffecd2 0%, #fcb69f 100%);
    color: #b94a48;
    border: 1px solid #fcb69f;
  }
  .terminal-controls {
    display: flex;
    gap: 10px;
  }
  .control-btn {
    background: none;
    border: 1px solid var(--border);
    color: var(--text);
    padding: 4px 8px;
    font-size: 12px;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.2s ease;
  }
  .control-btn:hover {
    background: var(--accent);
    color: var(--bg);
  }
  .terminal-screen {
    height: 400px;
    position: relative;
    overflow: hidden;
    background-color: var(--terminal-bg);
  }

  .terminal-screen::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image:
      linear-gradient(var(--grid-color) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
    background-size: 20px 20px;
    opacity: 0.08;
    pointer-events: none;
    z-index: 0;
  }

  :global(.danmaku-track) {
    position: absolute;
    width: 100%;
    height: 50px;
    overflow: hidden;
  }
  :global(.terminal-screen .danmaku-track:nth-child(1)) {
    top: 20px;
  }
  :global(.terminal-screen .danmaku-track:nth-child(2)) {
    top: 80px;
  }
  :global(.terminal-screen .danmaku-track:nth-child(3)) {
    top: 140px;
  }
  :global(.terminal-screen .danmaku-track:nth-child(4)) {
    top: 200px;
  }
  :global(.terminal-screen .danmaku-track:nth-child(5)) {
    top: 260px;
  }
  :global(.terminal-screen .danmaku-track:nth-child(6)) {
    top: 320px;
  }

  :global(.danmaku-item) {
    position: absolute;
    right: -100%;
    top: 0;
    display: inline-flex;
    align-items: center;
    /* background: var(--danmaku-bg); */
    border: 1px solid var(--danmaku-border);
    padding: 4px;
    white-space: nowrap;
    height: 40px;
  }
  :global(.danmaku-item.is-admin) {
    border: 1.5px solid var(--accent);
    /* box-shadow: 0 0 8px -2px var(--accent); */
  }

  :global(.danmaku-avatar) {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
  }
  :global(.danmaku-nick) {
    color: var(--danmaku-nick-text);
    padding: 4px;
    font-size: 14px;
    font-weight: 600;
    margin-left: 0.1rem; /* Spacing between avatar and nick */
    margin-right: 0.1rem;
  }
  :global(.danmaku-comment) {
    padding-right: 12px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    color: var(--text);
  }
  :global(.danmaku-like) {
    opacity: 0.8;
    font-size: 12px;
    margin-left: 8px;
    color: var(--text-secondary);
    flex-shrink: 0;
  }
  :global(.danmaku-comment p) {
    display: inline;
    margin: 0;
  }
  :global(.danmaku-comment .wl-emoji) {
    height: 1.4em;
    width: auto;
    margin: 0 2px;
    vertical-align: middle;
  }

  :global(.danmaku-comment img) {
    height: 1.4em;
    width: auto;
    margin: 0 2px;
    vertical-align: middle;
  }

  @keyframes danmaku-move {
    0% {
      transform: translateX(0);
      opacity: 1;
    }
    90% {
      transform: translateX(-150vw);
      opacity: 1;
    }
    100% {
      transform: translateX(-170vw);
      opacity: 0;
    }
  }
  :global(.danmaku-animate) {
    animation: danmaku-move linear;
  }

  .status-line {
    padding: 8px 20px;
    border-top: 1px solid var(--border);
    font-size: 12px;
    color: var(--text-secondary);
    display: flex;
    justify-content: space-between;
  }

  /* .danmaku-comment img {
    height: 28px !important;
    width: auto !important;
    max-width: 60px !important;
    border-radius: 2px !important;
    border: 1px solid var(--border) !important;
    object-fit: cover !important;
    vertical-align: middle !important;
    display: inline-block !important;
    flex-shrink: 0;
  } */

  /* 防止图片过宽导致卡片变形 */
  .danmaku-comment img[width] {
    width: auto !important;
  }

  .danmaku-comment img[height] {
    height: 28px !important;
  }
</style>
