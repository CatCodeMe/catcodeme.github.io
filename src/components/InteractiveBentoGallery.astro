---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

export interface MediaItem {
  id: number;
  type: 'image' | 'video';
  title: string;
  desc?: string;
  url: string | ImageMetadata;
  span: string;
  name?: string;
  image: ImageMetadata;
  date: string;
  tag?: string[];
}

export interface Props {
  mediaItems: MediaItem[];
  title: string;
  description: string;
}

const { mediaItems } = Astro.props;
---

<div class="px-4 py-8">
  <div class="grid grid-cols-1 sm:grid-cols-3 md:grid-cols-4 gap-3 auto-rows-[100px]" id="bento-gallery-container">
    {
      mediaItems.map((item) => (
        <div
          class={`relative overflow-hidden rounded-xl cursor-pointer group ${item.span}`}
          data-id={item.id}
        >
          {item.type === 'video' ? (
            <video
              class="absolute inset-0 w-full h-full object-cover"
              playsinline
              muted
              loop
              preload="auto"
            >
              <source src={item.url as string} type="video/mp4" />
            </video>
          ) : (
            <Image
              src={item.url as ImageMetadata}
              alt={item.title}
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
          )}
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-4">
            <h3 class="text-white text-lg font-bold">{item.title}</h3>
            <p class="text-white/80">{item.desc}</p>
          </div>
        </div>
      ))
    }
  </div>
</div>

<div id="gallery-modal-container" class="fixed inset-0 w-full h-full bg-black/90 backdrop-blur-xl z-50 hidden items-center justify-center">
  <div class="relative w-full h-full flex flex-col items-center justify-center">
    <!-- <button id="modal-close" class="absolute top-6 right-6 text-white z-20">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button> -->
    <div id="modal-content-area" class="w-full h-[70%] flex items-center justify-center mb-4 relative"></div>
    <div id="modal-dock" class="w-full h-[20%] flex items-center justify-center gap-4 p-4 relative overflow-x-hidden hide-scrollbar">
        <div class="flex items-center -space-x-2 px-3 py-2 z-10" id="dock-items-wrapper"></div>
        <div id="dock-progress" class="absolute bottom-2 text-white text-sm z-10"></div>
    </div>
  </div>
</div>

<style>
  .auto-rows-\[100px\] {
    grid-auto-rows: 100px;
  }
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
</style>

<script is:inline define:vars={{ mediaItems }}>
  document.addEventListener('DOMContentLoaded', () => {
    const galleryContainer = document.getElementById('bento-gallery-container');
    const modalContainer = document.getElementById('gallery-modal-container');
    const modalContentArea = document.getElementById('modal-content-area');
    const modalDock = document.getElementById('modal-dock');
    const dockItemsWrapper = document.getElementById('dock-items-wrapper');
    // const closeModalBtn = document.getElementById('modal-close');

    const dockProgress = document.getElementById('dock-progress');

    let currentItem = null;
    const dockElements = []; // To store references to dock item elements

    // Function to render the main modal content (image/video)
    const renderModalContent = (item) => {
        if (currentItem && currentItem.id === item.id) {
            return; // Prevent re-rendering if same item
        }

        // Update active state of dock items
        if (currentItem) {
            const oldActiveDockItem = dockElements.find(el => parseInt(el.dataset.id) === currentItem.id);
            if (oldActiveDockItem) {
                oldActiveDockItem.classList.remove('border-white');
                oldActiveDockItem.classList.add('border-transparent');
            }
        }

        currentItem = item;

        const newActiveDockItem = dockElements.find(el => parseInt(el.dataset.id) === currentItem.id);
        if (newActiveDockItem) {
            newActiveDockItem.classList.remove('border-transparent');
            newActiveDockItem.classList.add('border-white');
        }

        modalContentArea.innerHTML = ''; // Clear previous content

        if (item.type === 'video') {
            const videoElement = document.createElement('video');
            videoElement.className = 'max-w-full max-h-full object-contain';
            videoElement.controls = true;
            videoElement.autoplay = true;
            videoElement.loop = true;
            videoElement.playsInline = true;
            const sourceElement = document.createElement('source');
            sourceElement.src = item.url;
            sourceElement.type = 'video/mp4';
            videoElement.appendChild(sourceElement);
            modalContentArea.appendChild(videoElement);
            videoElement.play();
        } else {
            const imageElement = document.createElement('img');
            imageElement.className = 'max-w-full max-h-full object-contain';
            imageElement.src = item.url.src;
            imageElement.alt = item.title;
            modalContentArea.appendChild(imageElement);
        }
        dockProgress.textContent = `${mediaItems.indexOf(currentItem) + 1} / ${mediaItems.length}`;
    }

    // Initial rendering of dock items
    mediaItems.forEach((item, index) => {
        const rotate = Math.random() * 8 - 4; // Random rotation between -4 and 4 degrees
        const marginLeft = index === 0 ? '0' : '-0.5rem';
        const div = document.createElement('div');
        div.className = `w-24 h-24 rounded-lg overflow-hidden cursor-pointer border-2 border-transparent transform hover:scale-110 transition-transform duration-200 relative group`;
        div.dataset.id = item.id.toString();
        div.style.zIndex = (mediaItems.length - index).toString();
        div.style.marginLeft = marginLeft;
        div.style.transform = `rotate(${rotate}deg)`;

        let mediaHtml = '';
        if (item.type === 'video') {
            mediaHtml = `<video src="${item.url}" class="w-full h-full object-cover" playsinline muted loop preload="auto"></video>`;
        } else {
            mediaHtml = `<img src="${item.url.src}" class="w-full h-full object-cover">`;
        }

        div.innerHTML = `
            ${mediaHtml}
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-2">
                <h3 class="text-white text-xs font-bold line-clamp-1">${item.title}</h3>
                <p class="text-white/80 text-[10px] line-clamp-2">${item.desc}</p>
            </div>
        `;
        dockItemsWrapper.appendChild(div);
        dockElements.push(div);

        div.addEventListener('click', () => {
            renderModalContent(item);
        });
    });

    galleryContainer.addEventListener('click', (e) => {
      const target = e.target.closest('[data-id]');
      if (!target) return;

      const itemId = parseInt(target.dataset.id, 10);
      const item = mediaItems.find((i) => i.id === itemId);

      if (item) {
        renderModalContent(item);
        modalContainer.classList.remove('hidden');
        modalContainer.classList.add('flex');
        document.addEventListener('keydown', handleKeyDown);
      }
    });

    modalDock.addEventListener('click', (e) => {
        const target = e.target.closest('[data-id]');
        if(!target) return;

        const itemId = parseInt(target.dataset.id, 10);
        const item = mediaItems.find((i) => i.id === itemId);

        if(item) {
            renderModalContent(item);
        }
    });

    const closeModal = () => {
      modalContainer.classList.add('hidden');
      modalContainer.classList.remove('flex');
      modalContentArea.innerHTML = ''; // Clear content
      currentItem = null;
      document.removeEventListener('keydown', handleKeyDown);
    };

    // closeModalBtn.addEventListener('click', closeModal);
    modalContainer.addEventListener('click', (e) => {
      if (e.target === modalContainer) {
        closeModal();
      }
    });

    function handleKeyDown(e) {
      if (e.key === 'Escape') {
        closeModal();
      } else if (e.key === 'ArrowLeft') {
        const currentIndex = mediaItems.indexOf(currentItem);
        const newIndex = (currentIndex - 1 + mediaItems.length) % mediaItems.length;
        renderModalContent(mediaItems[newIndex]);
      } else if (e.key === 'ArrowRight') {
        const currentIndex = mediaItems.indexOf(currentItem);
        const newIndex = (currentIndex + 1) % mediaItems.length;
        renderModalContent(mediaItems[newIndex]);
      }
    }
  });
</script>