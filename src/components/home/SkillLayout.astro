---
import { Icon } from 'astro-icon/components'

interface Skill {
  name: string
  icon: string
}

interface Props {
  title: string
  skills: Array<Skill | string>
}

const { title, skills } = Astro.props

// 处理技能项，支持字符串或对象格式
const normalizedSkills = skills.map((skill) => {
  if (typeof skill === 'string') {
    return { name: skill, icon: '' }
  }
  return skill
})
---

<div class='flex flex-col gap-y-2'>
  <h3 class='w-1/5 font-medium'>{title}</h3>
  <div class='flex flex-wrap gap-2'>
    {
      normalizedSkills.map((skill) => (
        <div class='flex items-center gap-x-1.5 rounded-lg border px-3 py-1.5 text-sm text-muted-foreground'>
          {skill.icon && <Icon name={skill.icon} class='size-4' />}
          {skill.name}
        </div>
      ))
    }
  </div>
</div>
