---
import PageLayout from '@/layouts/ContentLayout.astro'
import Comment from '@/components/Comment.astro'

interface Props {
  info?: {
    slug: string
    comment?: boolean,
    view?: boolean
  }
}

const { info, ...props } = Astro.props
const enableComment = typeof info === 'object' ? info.comment ?? true : true
---

<PageLayout meta={{ title: '留言板' }} {...props} hasToc={false}>
  <slot />

  <div slot="bottom">
    {enableComment && <Comment />}
  </div>
</PageLayout>
