---
import { Footer, Header, ThemeProvider } from '@/custom/components/basic'

import type { SiteMeta } from 'astro-pure/types'
import BaseHead from '@/components/BaseHead.astro'
import config from '@/site-config'

// Import the global.css file here so that it is included on
// all pages through the use of the <BaseLayout /> component.
import '@/assets/styles/app.css'
import '@/assets/styles/aside.css'
import '@/assets/styles/expressive-code.css'
import '@/assets/styles/inner-link.css'
import '@/assets/styles/external-link.css'
// import '@/assets/styles/ai-notice.css'
import '@/assets/styles/advance-step.css'
import '@waline/client/waline-meta.css'

interface Props {
  meta: SiteMeta
  highlightColor?: string
  bodyClass?: string
}

const { meta, highlightColor, bodyClass, ...props } = Astro.props
const {
  articleDate,
  description = config.description,
  ogImage,
  title,
} = meta || {}
---

<html lang={config.locale.lang}>
  <head>
    <BaseHead {articleDate} {description} {ogImage} {title} />
    <ThemeProvider />
  </head>

  <body class:list={['flex justify-center bg-background text-foreground', bodyClass]} {...props}>
    {
      highlightColor && (
        <div
          id='highlight-gradient'
          class='pointer-events-none absolute start-0 top-0 z-0 h-screen w-full opacity-25'
          style={`background-image:linear-gradient(${highlightColor},transparent)`}
        />
      )
    }
    <div class='w-full max-w-[70rem] px-4 sm:px-7 lg:px-10'>
      <Header />
      <slot />
      <Footer />
    </div>

    {/* Set highlight color */}
    <style define:vars={{ highlightColor }}>
      :global(.highlight) {
        color: var(--highlightColor, hsl(var(--primary) / var(--un-text-opacity))) !important;
      }
      :global(.highlight-bg) {
        background-color: var(
          --highlightColor,
          hsl(var(--primary) / var(--un-text-opacity))
        ) !important;
      }
    </style>
    <script is:inline defer src='https://events.vercount.one/js'></script>
  </body>
</html>
