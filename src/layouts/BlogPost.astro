---
import type { MarkdownHeading } from 'astro'
import type { CollectionEntry } from 'astro:content'

// Plugin styles
import 'katex/dist/katex.min.css'

// 直接导入各个组件，避免 barrel export 导致的过度加载
import ArticleBottom from '@/custom/components/pages/ArticleBottom.astro'
import TOC from '@/custom/components/pages/TOC.astro'
import Copyright from '@/custom/components/pages/Copyright.astro'
import Hero from '@/custom/components/pages/Hero.astro'

import MediumZoom from '@/custom/components/advanced/MediumZoom.astro'
import PageLayout from '@/layouts/ContentLayout.astro'
import { Comment, PageInfo } from '@/components/waline'
import { integ } from '@/site-config'

interface Props {
  post: CollectionEntry<'blog'>
  posts: CollectionEntry<'blog'>[]
  headings: MarkdownHeading[]
  remarkPluginFrontmatter: Record<string, unknown>
}

const {
  post: { id, data },
  posts,
  headings,
  remarkPluginFrontmatter
} = Astro.props

const {
  description,
  heroImage,
  publishDate,
  title,
  updatedDate,
  draft: isDraft,
  comment: enableComment,
  toc: tocType
} = data

const socialImage = heroImage
  ? typeof heroImage.src === 'string'
    ? heroImage.src
    : heroImage.src.src
  : '/images/social-card.png'
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString()
---

<PageLayout
  meta={{ articleDate, description, ogImage: socialImage, title }}
  back='/blog'
  hasToc={!!headings.length}
>
  {/* 手风琴目录 - 通过 slot 由需要的页面自行提供，避免加载未使用的组件 */}
  <slot name='handletoc' slot='handletoc' />

  {tocType == 1 && <TOC {headings} slot='sidebar' />}

  <Hero {data} {remarkPluginFrontmatter} slot='header'>
    <Fragment slot='description'>
      {!isDraft && enableComment && <PageInfo comment class='mt-1' />}
    </Fragment>
  </Hero>

  <slot />

  <Fragment slot='bottom'>
    {/* Copyright */}
    <Copyright data={data} remarkPluginFrontmatter={remarkPluginFrontmatter} />
    {/* Article recommend */}
    <ArticleBottom collections={posts} {id} class='mt-3 sm:mt-6' />
    {/* Comment */}
    {!isDraft && enableComment && <Comment class='mt-3 sm:mt-6' />}
  </Fragment>

  <slot name='bottom-sidebar' slot='bottom-sidebar' />
</PageLayout>

{integ.mediumZoom.enable && <MediumZoom />}

